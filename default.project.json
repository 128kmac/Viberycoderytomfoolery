{
  "name": "EB-Proxima",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": { "EnableMouseLockOption": false },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      },
      "StarterCharacterScripts": { "$path": "src/character" }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    }
  }
}
