	sequence = "Use Yin to survive entry, turn to Yang when an opponent commits, then recenter before the dial becomes predictable. Forced stance changes and long-range pressure can make the appropriate half of your kit unavailable at the wrong moment.",
	team = { partners = "Light and Dark", text = "Light can clarify the boundary and Dark can obscure distant scenery, but neither removes the circle's visible symbols. Yin Yang's two halves keep separate ownership and cannot absorb those partners into a permanent combined form." },
}
