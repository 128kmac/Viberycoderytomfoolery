			statline = "CD 18 s | E 25 | H 9 | W 0.6 s | R 10 m",
			desc = "Yin creates a 100-durability, 3-metre barrier for 3 seconds. Yang sends a 90-damage wave with 2-metre push. A barrier occupies the same slot as the wave; the ability cannot create both in one cast.",
			p60 = "Raises barrier durability by 40 or extends the wave's reach by 2 metres.",
