local Config = require(script.Parent.Config)

local Util = {}

local M = Config.METRE

function Util.m(metres)
	return metres * M
end

function Util.toMetres(studs)
	return studs / M
end

function Util.flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

function Util.flatDist(a, b)
	local d = a - b
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

function Util.rotateY(v, degrees)
	return CFrame.Angles(0, math.rad(degrees), 0):VectorToWorldSpace(v)
end

function Util.angleBetween(a, b)
	local au, bu = a.Unit, b.Unit
	local d = math.clamp(au:Dot(bu), -1, 1)
	return math.deg(math.acos(d))
end

function Util.shuffle(t, rng)
	rng = rng or Random.new()
	for i = #t, 2, -1 do
		local j = rng:NextInteger(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

function Util.copy(t)
	local r = {}
	for k, v in pairs(t) do
		r[k] = v
	end
	return r
end

function Util.round(x, step)
	step = step or 1
	return math.floor(x / step + 0.5) * step
end

function Util.fmt(n)
	if math.abs(n - math.floor(n)) < 0.05 then
		return tostring(math.floor(n + 0.5))
	end
	return string.format("%.1f", n)
end

-- Element colours (each important colour is also paired with text/shape cues on the client).
Util.ElementColors = {
	Acid = Color3.fromRGB(170, 255, 60), Agility = Color3.fromRGB(120, 230, 255), Alchemist = Color3.fromRGB(230, 190, 90),
	Angel = Color3.fromRGB(255, 250, 220), Animal = Color3.fromRGB(170, 120, 70), Arcane = Color3.fromRGB(160, 90, 255),
	Ash = Color3.fromRGB(120, 115, 110), Beast = Color3.fromRGB(150, 60, 40), Blood = Color3.fromRGB(170, 0, 20),
	Bone = Color3.fromRGB(235, 225, 200), Candy = Color3.fromRGB(255, 130, 200), Chaos = Color3.fromRGB(255, 60, 160),
	Circus = Color3.fromRGB(255, 80, 80), Cloud = Color3.fromRGB(230, 240, 255), Copy = Color3.fromRGB(180, 180, 200),
	Corrupt = Color3.fromRGB(110, 0, 130), Cosmic = Color3.fromRGB(80, 60, 200), Creation = Color3.fromRGB(255, 220, 120),
	Crystal = Color3.fromRGB(150, 230, 255), Dark = Color3.fromRGB(40, 20, 60), Death = Color3.fromRGB(60, 70, 60),
	Defensive = Color3.fromRGB(90, 140, 200), Demon = Color3.fromRGB(200, 30, 30), Destruction = Color3.fromRGB(255, 100, 0),
	Dragon = Color3.fromRGB(220, 60, 30), Dream = Color3.fromRGB(200, 170, 255), Duplication = Color3.fromRGB(120, 200, 200),
	Earth = Color3.fromRGB(130, 100, 60), Eater = Color3.fromRGB(140, 60, 120), Elasticity = Color3.fromRGB(255, 170, 80),
	Electric = Color3.fromRGB(255, 240, 60), Energy = Color3.fromRGB(80, 255, 220), Engine = Color3.fromRGB(150, 150, 150),
	Explosion = Color3.fromRGB(255, 140, 30), Fairy = Color3.fromRGB(255, 190, 255), Fly = Color3.fromRGB(200, 230, 250),
	Fight = Color3.fromRGB(230, 120, 60), Fire = Color3.fromRGB(255, 90, 20), Flower = Color3.fromRGB(255, 150, 190),
	Ghost = Color3.fromRGB(190, 230, 255), Heal = Color3.fromRGB(110, 255, 140), Glass = Color3.fromRGB(200, 240, 240),
	Glitch = Color3.fromRGB(0, 255, 140), Gold = Color3.fromRGB(255, 200, 40), Gravity = Color3.fromRGB(100, 60, 160),
	Ice = Color3.fromRGB(160, 220, 255), Illusion = Color3.fromRGB(220, 140, 255), Ink = Color3.fromRGB(25, 25, 40),
	Insect = Color3.fromRGB(120, 140, 30), Laser = Color3.fromRGB(255, 30, 60), Lava = Color3.fromRGB(255, 70, 0),
	Life = Color3.fromRGB(140, 255, 120), Light = Color3.fromRGB(255, 255, 180), Love = Color3.fromRGB(255, 90, 140),
	Lunar = Color3.fromRGB(200, 210, 255), Magic = Color3.fromRGB(190, 80, 255), Mirror = Color3.fromRGB(220, 230, 240),
	Mist = Color3.fromRGB(200, 210, 220), Mud = Color3.fromRGB(100, 75, 45), Music = Color3.fromRGB(255, 120, 220),
	Mystery = Color3.fromRGB(90, 70, 130), Nature = Color3.fromRGB(60, 170, 60), Nightmare = Color3.fromRGB(70, 0, 50),
	Normal = Color3.fromRGB(200, 200, 200), Nuclear = Color3.fromRGB(120, 255, 0), Paper = Color3.fromRGB(245, 240, 225),
	Phoenix = Color3.fromRGB(255, 120, 30), Plant = Color3.fromRGB(80, 200, 80), Plasma = Color3.fromRGB(255, 60, 255),
	Poison = Color3.fromRGB(130, 40, 200), Power = Color3.fromRGB(255, 220, 0), Pulse = Color3.fromRGB(0, 200, 255),
	Psychic = Color3.fromRGB(255, 100, 255), Rainbow = Color3.fromRGB(255, 160, 60), Reptile = Color3.fromRGB(80, 140, 60),
	Rock = Color3.fromRGB(120, 110, 100), Sand = Color3.fromRGB(230, 200, 130), Shot = Color3.fromRGB(255, 210, 120),
	Shadow = Color3.fromRGB(30, 30, 40), Size = Color3.fromRGB(255, 160, 120), Slasher = Color3.fromRGB(200, 0, 40),
	Slime = Color3.fromRGB(90, 255, 120), Snow = Color3.fromRGB(240, 250, 255), Solar = Color3.fromRGB(255, 180, 0),
	Sound = Color3.fromRGB(120, 180, 255), Space = Color3.fromRGB(30, 20, 80), Star = Color3.fromRGB(255, 240, 150),
	Steel = Color3.fromRGB(170, 180, 190), Storm = Color3.fromRGB(90, 100, 160), Technology = Color3.fromRGB(0, 170, 255),
	Thread = Color3.fromRGB(240, 220, 200), Thorn = Color3.fromRGB(70, 110, 40), Time = Color3.fromRGB(210, 180, 100),
	Vampire = Color3.fromRGB(140, 0, 40), Void = Color3.fromRGB(15, 0, 30), Water = Color3.fromRGB(40, 140, 255),
	Weapon = Color3.fromRGB(190, 190, 210), Wind = Color3.fromRGB(190, 255, 230), Witch = Color3.fromRGB(110, 60, 150),
	["Yin Yang"] = Color3.fromRGB(245, 245, 245),
}

function Util.color(element)
	return Util.ElementColors[element] or Color3.fromRGB(255, 255, 255)
end

return Util
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX00000080"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000007F"><Properties><string name="Name">Server</string></Properties><Item class="Folder" referent="RBX0000007C"><Properties><string name="Name">Core</string></Properties><Item class="ModuleScript" referent="RBX0000006D"><Properties><string name="Name">Arena</string><ProtectedString name="Source"><![CDATA[-- Procedural compact arena: ~67 m square platform, solid walls for wall-running, raised platforms,
-- destructible neutral cover pillars (respawning), spawn pads and a training lane.
local Lighting = game:GetService("Lighting")
local S = require(script.Parent.S)

local Arena = {}
S.Arena = Arena

local M = S.Config.METRE
local SIZE = 200 -- studs
local FLOOR_Y = 0

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = props.Parent or S.folders.Arena
	return p
end

local function wedge(props)
	local p = Instance.new("WedgePart")
	p.Anchored = true
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = S.folders.Arena
	return p
end

Arena.spawns = {}
Arena.dummySpots = {}
Arena.coverSpots = {}

local function spawnCover(pos, size)
	local obj = S.Objects.create({
		owner = nil,
		name = "Cover",
		cf = CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)),
		size = size,
		hp = 400,
		color = Color3.fromRGB(150, 140, 125),
		material = Enum.Material.Cobblestone,
		noCap = true,
		tags = { cover = true, terrain = true },
	})
	obj.onDestroy = function()
		task.delay(20, function()
			spawnCover(pos, size)
		end)
	end
	return obj
end

function Arena.build()
	for _, c in ipairs(S.folders.Arena:GetChildren()) do
		c:Destroy()
	end
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	workspace.FallenPartsDestroyHeight = -2000
	workspace.Gravity = 196.2

	local center = Vector3.new(0, FLOOR_Y, 0)
	S.arenaBounds = { center = center, half = SIZE / 2, floorY = FLOOR_Y }

	-- floor (two-tone tiles for readable distances: each tile is 4 m)
	part({
		Name = "Floor",
		Size = Vector3.new(SIZE, 4, SIZE),
		CFrame = CFrame.new(center - Vector3.new(0, 2, 0)),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(70, 74, 88),
	})
	local tile = 4 * M
	local n = math.floor(SIZE / tile)
	for i = 0, n - 1 do
		for j = 0, n - 1 do
			if (i + j) % 2 == 0 then
				part({
					Name = "Tile",
					Size = Vector3.new(tile, 0.05, tile),
					CFrame = CFrame.new(-SIZE / 2 + tile * (i + 0.5), FLOOR_Y + 0.03, -SIZE / 2 + tile * (j + 0.5)),
					Material = Enum.Material.SmoothPlastic,
					Color = Color3.fromRGB(78, 82, 98),
					CanCollide = false,
					CanQuery = false,
				})
			end
		end
	end
	-- low rim with gaps at corners (forced displacement can threaten the out-of-bounds penalty there)
	local rimH = 1.6
	for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		local len = SIZE - 40
		local x, z = side[1] * (SIZE / 2 - 0.5), side[2] * (SIZE / 2 - 0.5)
		part({
			Name = "Rim",
			Size = side[1] ~= 0 and Vector3.new(1, rimH, len) or Vector3.new(len, rimH, 1),
			CFrame = CFrame.new(x, FLOOR_Y + rimH / 2, z),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(110, 115, 130),
		})
	end
	-- central dais
	part({
		Name = "Dais",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, 36, 36),
		CFrame = CFrame.new(0, FLOOR_Y + 0.8, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(200, 195, 185),
	})
	part({
		Name = "DaisGlow",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.7, 6, 6),
		CFrame = CFrame.new(0, FLOOR_Y + 0.8, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(120, 200, 255),
		CanCollide = false,
	})
	-- four solid walls (indestructible) for cover and wall routes
	local wallSpecs = {
		{ Vector3.new(-45, 0, -20), Vector3.new(4, 14, 34) },
		{ Vector3.new(45, 0, 20), Vector3.new(4, 14, 34) },
		{ Vector3.new(20, 0, -45), Vector3.new(34, 14, 4) },
		{ Vector3.new(-20, 0, 45), Vector3.new(34, 14, 4) },
	}
	for _, w in ipairs(wallSpecs) do
		part({
			Name = "Wall",
			Size = w[2],
			CFrame = CFrame.new(w[1] + Vector3.new(0, FLOOR_Y + w[2].Y / 2, 0)),
			Material = Enum.Material.Brick,
			Color = Color3.fromRGB(120, 85, 70),
		})
	end
	-- two raised platforms with ramps
	for _, sgn in ipairs({ 1, -1 }) do
		local pc = Vector3.new(sgn * 62, FLOOR_Y, -sgn * 62)
		part({
			Name = "Platform",
			Size = Vector3.new(30, 7, 30),
			CFrame = CFrame.new(pc + Vector3.new(0, 3.5, 0)),
			Material = Enum.Material.Concrete,
			Color = Color3.fromRGB(95, 100, 115),
		})
		wedge({
			Name = "Ramp",
			Size = Vector3.new(10, 7, 18),
			CFrame = CFrame.new(pc + Vector3.new(0, 3.5, sgn * 24)) * CFrame.Angles(0, sgn > 0 and math.pi or 0, 0),
			Material = Enum.Material.Concrete,
			Color = Color3.fromRGB(95, 100, 115),
		})
	end
	-- spawn pads
	table.clear(Arena.spawns)
	for i = 0, 7 do
		local a = i * math.pi / 4 + math.pi / 8
		local p = Vector3.new(math.cos(a) * 80, FLOOR_Y, math.sin(a) * 80)
		table.insert(Arena.spawns, p)
		part({
			Name = "SpawnPad",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 10, 10),
			CFrame = CFrame.new(p + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(90, 160, 255),
			CanCollide = false,
			CanQuery = false,
			Transparency = 0.4,
		})
	end
	-- destructible cover pillars
	local coverSpots = {
		Vector3.new(-25, 0, -25), Vector3.new(25, 0, 25), Vector3.new(-25, 0, 25), Vector3.new(25, 0, -25),
		Vector3.new(0, 0, -55), Vector3.new(0, 0, 55), Vector3.new(-55, 0, 0), Vector3.new(55, 0, 0),
	}
	for _, p in ipairs(coverSpots) do
		spawnCover(p + Vector3.new(0, FLOOR_Y, 0), Vector3.new(6, 9, 6))
	end
	-- training lane (dummies)
	table.clear(Arena.dummySpots)
	for i = 1, 4 do
		table.insert(Arena.dummySpots, Vector3.new(-80 + i * 9, FLOOR_Y, 88))
	end
	part({
		Name = "TrainingSign",
		Size = Vector3.new(30, 4, 0.5),
		CFrame = CFrame.new(-57, FLOOR_Y + 9, 96),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(40, 40, 60),
		CanCollide = false,
		CanQuery = false,
	})
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.Parent = S.folders.Arena.TrainingSign
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Text = "TRAINING DUMMIES"
	tl.TextScaled = true
	tl.Font = Enum.Font.GothamBlack
	tl.TextColor3 = Color3.fromRGB(255, 255, 255)
	tl.Parent = sg

	-- lighting
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(70, 70, 90)
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 140)
	Lighting.GlobalShadows = true
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.25
		atm.Haze = 1
		atm.Color = Color3.fromRGB(190, 200, 230)
		atm.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local b = Instance.new("BloomEffect")
		b.Intensity = 0.6
		b.Size = 20
		b.Threshold = 1.6
		b.Parent = Lighting
	end
end

function Arena.randomSpawn()
	local best, bestScore
	for _, p in ipairs(Arena.spawns) do
		-- prefer pads far from fighters
		local score = 0
		for _, f in pairs(S.fighters) do
			if S.alive(f) and not f.isSummon then
				score += math.min(60, (f.root.Position - p).Magnitude)
			end
		end
		score += math.random() * 30
		if not bestScore or score > bestScore then
			best, bestScore = p, score
		end
	end
	return (best or Vector3.new(0, 0, 0)) + Vector3.new(0, 4, 0)
end

return Arena
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000006E"><Properties><string name="Name">Bots</string><ProtectedString name="Source"><![CDATA[-- Simple practice AI: approaches, strafes, guards against windups, dodges shots, uses its kit.
local S = require(script.Parent.S)

local Bots = {}
S.Bots = Bots

local M = S.Config.METRE
local rng = Random.new()

local function pickTarget(f)
	local best, bd
	for _, t in pairs(S.fighters) do
		if S.alive(t) and t ~= f and S.isEnemy(f, t) and not t.isDummy and t.untargetable <= 0 then
			local d = (t.root.Position - f.root.Position).Magnitude
			if t.isSummon then
				d += 40
			end
			if not bd or d < bd then
				best, bd = t, d
			end
		end
	end
	return best, bd
end

local function think(f, now)
	local t, d = pickTarget(f)
	local hum = f.humanoid
	if not t or not hum then
		f.aim = nil
		return
	end
	local myPos = f.root.Position
	local tp = t.root.Position
	local dm = d / M
	-- aim with a little inaccuracy
	local lead = t.root.AssemblyLinearVelocity * math.min(0.4, dm / 24) * 0.6
	local hitPos = tp + lead + Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
	local g = S.Hit.ground(hitPos) or hitPos
	f.aim = {
		origin = myPos + Vector3.new(0, 1.5, 0),
		dir = (hitPos - myPos).Unit,
		hit = dm < 3 and tp or Vector3.new(hitPos.X, (hitPos.Y + g.Y) / 2, hitPos.Z),
		target = t.model,
	}
	f.botState = f.botState or { strafe = 1, nextStrafe = 0, guardUntil = 0 }
	local st = f.botState
	-- guard against visible windups
	if t.action and t.action.phase == "windup" and dm < 16 and not S.Cast.isBusy(f) and rng:NextNumber() < 0.35 then
		S.Fighter.setGuard(f, true)
		st.guardUntil = now + rng:NextNumber(0.4, 0.9)
	end
	if f.guarding and now > st.guardUntil then
		S.Fighter.setGuard(f, false)
	end
	-- dodge nearby incoming projectiles
	if f.dodgeCharges > 0 and rng:NextNumber() < 0.25 then
		for _, p in ipairs(S.Proj.inRadius(myPos, M * 5, function(p)
			return p.owner and S.isEnemy(f, p.owner)
		end)) do
			local toMe = myPos - p.pos
			if toMe.Magnitude > 0.1 and p.vel.Unit:Dot(toMe.Unit) > 0.7 then
				local side = p.vel.Unit:Cross(Vector3.yAxis)
				S.Fighter.dodge(f, side * (rng:NextNumber() < 0.5 and 1 or -1))
				break
			end
		end
	end
	-- movement
	if now > st.nextStrafe then
		st.strafe = -st.strafe
		st.nextStrafe = now + rng:NextNumber(0.8, 2)
		if rng:NextNumber() < 0.15 then
			hum.Jump = true
		end
	end
	local flat = Vector3.new(tp.X - myPos.X, 0, tp.Z - myPos.Z)
	local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
	local side = dir:Cross(Vector3.yAxis) * st.strafe
	local goal
	local wanted = f.botRange or 7
	if dm > wanted + 3 then
		goal = myPos + dir * 12 + side * 4
	elseif dm < wanted - 3 then
		goal = myPos - dir * 6 + side * 6
	else
		goal = myPos + side * 8
	end
	-- stay inside the arena
	local b = S.arenaBounds
	if b then
		local h = b.half - 12
		goal = Vector3.new(math.clamp(goal.X, b.center.X - h, b.center.X + h), goal.Y, math.clamp(goal.Z, b.center.Z - h, b.center.Z + h))
	end
	hum:MoveTo(goal)
	-- face target when acting
	if not f.guarding and not S.Cast.isBusy(f) then
		-- basic attack in melee range
		if dm < 3 then
			f.root.CFrame = CFrame.lookAt(myPos, myPos + dir)
			S.Fighter.basic(f)
		end
		-- abilities
		if f.kitData and rng:NextNumber() < 0.45 then
			local order = { 5, 1, 2, 3, 4 }
			for _, slot in ipairs(order) do
				local def = f.kitData.moves[slot]
				local range = (def.range and def.range > 0) and def.range or 6
				local okRange = dm <= range + 2
				if slot == 5 then
					okRange = dm <= math.max(range, 8)
				end
				if okRange and (slot ~= 5 or f.proxima >= 100) then
					local ok = S.Cast.canStart(f, slot)
					if ok and rng:NextNumber() < (slot == 5 and 0.8 or 0.5) then
						f.root.CFrame = CFrame.lookAt(myPos, myPos + dir)
						S.Cast.begin(f, slot, f.heat >= 60 and rng:NextNumber() < 0.3 and slot == 5, rng:NextNumber() < 0.3)
						-- recasts later
						break
					end
				end
			end
		end
		-- use open recast windows sometimes
		for slot, r in pairs(f.recasts) do
			if r.expires > now and rng:NextNumber() < 0.3 then
				S.Cast.press(f, slot, true, false)
				break
			end
		end
		-- kit action key occasionally
		if f.kit and f.kit.action and rng:NextNumber() < 0.05 then
			S.Cast.kitAction(f)
		end
	end
	-- preferred range from kit: average of moves 1-4
	if not f.botRange and f.kitData then
		local sum, n = 0, 0
		for slot = 1, 4 do
			local r = f.kitData.moves[slot].range
			if r and r > 0 then
				sum += r
				n += 1
			end
		end
		f.botRange = n > 0 and math.clamp(sum / n * 0.6, 3, 14) or 5
	end
end

local timer = 0
game:GetService("RunService").Heartbeat:Connect(function(dt)
	timer += dt
	if timer < 0.2 then
		return
	end
	timer = 0
	local now = S.now()
	for _, f in pairs(S.fighters) do
		if f.isBot and S.alive(f) and S.Fighter.canAct(f) then
			local ok, err = pcall(think, f, now)
			if not ok then
				warn("[EB] bot think: " .. tostring(err))
			end
		end
	end
end)

return Bots
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000006F"><Properties><string name="Name">Cast</string><ProtectedString name="Source"><![CDATA[-- Ability casting (Compendium: "Commitment and recovery", "Proxima and Heat", "Unstable mutation and Rupture").
local S = require(script.Parent.S)
local Combat = require(script.Parent.Combat)

local Cast = {}
S.Cast = Cast

local Config = S.Config
local M = Config.METRE

local remotes
function Cast.init(r)
	remotes = r
end

local function notify(f, text)
	if f.player and remotes then
		remotes.Notice:FireClient(f.player, text)
	end
end
Cast.notify = notify

-- Cast context -------------------------------------------------------------------------
local Ctx = {}
Ctx.__index = Ctx
Cast.Ctx = Ctx

local function newCtx(f, slot, def)
	return setmetatable({
		f = f,
		slot = slot,
		def = def,
		isUlt = slot == 5,
		p60 = false,
		unstable = false,
		mod = false,
		interrupted = false,
		active = false,
		phase = "pending",
		startTime = S.now(),
		data = {},
	}, Ctx)
end
Cast.newCtx = newCtx

function Ctx:valid()
	return not self.interrupted and S.alive(self.f)
end

-- yields; returns false when the cast was interrupted or the caster died
function Ctx:wait(t)
	local f = self.f
	local endT = S.now() + (t or 0)
	if (t or 0) <= 0 then
		task.wait()
		return self:valid()
	end
	while S.now() < endT do
		if not self:valid() then
			return false
		end
		task.wait(math.min(0.05, endT - S.now()))
	end
	return self:valid() and S.alive(f)
end

function Ctx:origin()
	return self.f.root.Position
end

function Ctx:chest()
	return self.f.root.Position + Vector3.new(0, 0.8, 0)
end

function Ctx:feet()
	local g = S.Hit.ground(self.f.root.Position)
	return g or (self.f.root.Position - Vector3.new(0, Config.BODY_DOWN, 0))
end

local function aimOf(f)
	return f.aim
end

-- flat unit direction toward aim
function Ctx:dir()
	local f = self.f
	local a = aimOf(f)
	if self.lockedDir then
		return self.lockedDir
	end
	if a and a.hit then
		local v = a.hit - f.root.Position
		v = Vector3.new(v.X, 0, v.Z)
		if v.Magnitude > 2 then
			return v.Unit
		end
	end
	if a and a.dir then
		local v = Vector3.new(a.dir.X, 0, a.dir.Z)
		if v.Magnitude > 0.01 then
			return v.Unit
		end
	end
	local lv = f.root.CFrame.LookVector
	return Vector3.new(lv.X, 0, lv.Z).Unit
end

-- 3D direction from chest toward aim point
function Ctx:dir3()
	local f = self.f
	local a = aimOf(f)
	if a and a.hit then
		local v = a.hit - self:chest()
		if v.Magnitude > 2 then
			return v.Unit
		end
	end
	return self:dir()
end

-- ground point at aim, clamped to range (metres)
function Ctx:aimPoint(rangeM, minM)
	local f = self.f
	local a = aimOf(f)
	local origin = f.root.Position
	local target = a and a.hit or (origin + self:dir() * (rangeM or 10) * M)
	local flat = Vector3.new(target.X - origin.X, 0, target.Z - origin.Z)
	local maxS = (rangeM or self.def.range or 10) * M
	local d = flat.Magnitude
	if d > maxS then
		flat = flat.Unit * maxS
	elseif minM and d < minM * M then
		flat = (d > 0.01 and flat.Unit or self:dir()) * minM * M
	end
	local p = Vector3.new(origin.X + flat.X, math.max(target.Y, origin.Y - 30), origin.Z + flat.Z)
	local g = S.Hit.ground(Vector3.new(p.X, math.max(p.Y, origin.Y) + 8, p.Z), 60)
	if g then
		return g
	end
	return Vector3.new(p.X, origin.Y - Config.BODY_DOWN, p.Z)
end

local function scoreTarget(self, t, rangeS, rayOrigin, rayDir)
	local to = t.root.Position - rayOrigin
	local dist = (t.root.Position - self.f.root.Position).Magnitude
	if dist > rangeS + Config.BODY_RADIUS then
		return nil
	end
	local ang = math.deg(math.acos(math.clamp(to.Unit:Dot(rayDir), -1, 1)))
	return ang
end

-- enemy (or ally) under / near the aim. rangeM metres. opts: allies, includeSelf, needLos (default true), cone
function Ctx:target(rangeM, opts)
	opts = opts or {}
	local f = self.f
	local rangeS = (rangeM or self.def.range or 15) * M
	local a = aimOf(f)
	local function ok(t)
		if not S.alive(t) or t.untargetable > 0 then
			return false
		end
		if opts.allies then
			if t == f then
				return opts.includeSelf == true
			end
			if not S.isAlly(f, t) then
				return false
			end
			if t.isSummon and not opts.summons then
				return false
			end
		else
			if not S.isEnemy(f, t) then
				return false
			end
			if t.isSummon and opts.noSummons then
				return false
			end
		end
		if opts.filter and not opts.filter(t) then
			return false
		end
		if (t.root.Position - f.root.Position).Magnitude > rangeS + Config.BODY_RADIUS then
			return false
		end
		if opts.needLos ~= false and not S.Hit.los(self:chest(), t.root.Position) then
			return false
		end
		return true
	end
	if a and a.target then
		local t = S.byModel[a.target]
		if t and ok(t) then
			return t
		end
	end
	local rayOrigin = (a and a.origin) or self:chest()
	local rayDir = (a and a.dir) or self:dir()
	if a and a.hit then
		local v = a.hit - rayOrigin
		if v.Magnitude > 0.5 then
			rayDir = v.Unit
		end
	end
	local best, bestAng
	local cone = opts.cone or 14
	for _, t in pairs(S.fighters) do
		if ok(t) then
			local ang = scoreTarget(self, t, rangeS, rayOrigin, rayDir)
			if ang and ang <= cone and (not bestAng or ang < bestAng) then
				best, bestAng = t, ang
			end
		end
	end
	if not best and a and a.hit then
		-- fallback: closest to aim point
		local bd
		for _, t in pairs(S.fighters) do
			if ok(t) then
				local d = (t.root.Position - a.hit).Magnitude
				if d < M * 3 and (not bd or d < bd) then
					best, bd = t, d
				end
			end
		end
	end
	if not best and opts.allies and opts.includeSelf then
		return f
	end
	return best
end

function Ctx:ally(rangeM, includeSelf)
	return self:target(rangeM, { allies = true, includeSelf = includeSelf })
end

function Ctx:face(dir)
	local f = self.f
	local d = Vector3.new(dir.X, 0, dir.Z)
	if d.Magnitude > 0.01 and f.root then
		if f.humanoid then
			f.root.CFrame = CFrame.lookAt(f.root.Position, f.root.Position + d.Unit)
		end
	end
end

-- stationary channel. opts: tick (interval), onTick(elapsed) -> return false to stop, cancelOnMove, moveFree
function Ctx:channel(dur, opts)
	opts = opts or {}
	local f = self.f
	self.phase = "channel"
	if opts.stationary ~= false then
		f.stationary += 1
	end
	if opts.halfSpeed then
		self.halfSpeed = true
	end
	local start = S.now()
	local startPos = f.root.Position
	local nextTick = start + (opts.tick or math.huge)
	local completed = true
	while S.now() - start < dur do
		if not self:valid() then
			completed = false
			break
		end
		if self.endChannel then
			completed = opts.earlyIsComplete or false
			break
		end
		if opts.cancelOnMove and (f.root.Position - startPos).Magnitude > 1.5 then
			completed = false
			break
		end
		if opts.onTick and S.now() >= nextTick then
			nextTick += opts.tick
			local r = opts.onTick(S.now() - start)
			if r == false then
				break
			end
		end
		task.wait(0.05)
	end
	if opts.stationary ~= false then
		f.stationary -= 1
	end
	self.halfSpeed = false
	self.endChannel = false
	return completed and self:valid()
end

-- waits for the cast key to be released (or maxT). Returns held seconds.
function Ctx:hold(maxT)
	local f = self.f
	if not f.player then
		local t = maxT * (0.4 + math.random() * 0.5)
		self:wait(t)
		return t
	end
	local h = { released = false }
	f.holds[self.slot] = h
	local start = S.now()
	while S.now() - start < maxT and not h.released and self:valid() do
		task.wait(0.03)
	end
	if f.holds[self.slot] == h then
		f.holds[self.slot] = nil
	end
	return math.min(maxT, S.now() - start)
end

-- open a recast window. fn(c2) runs when the slot is pressed again; return "keep" to keep the window.
function Ctx:recast(window, fn, opts)
	opts = opts or {}
	local f = self.f
	local r = {
		expires = S.now() + window,
		fn = fn,
		parent = self,
		onExpire = opts.onExpire,
		uses = opts.uses or 1,
	}
	f.recasts[self.slot] = r
	if f.model then
		f.model:SetAttribute("RC" .. self.slot, r.expires)
	end
	task.delay(window, function()
		if f.recasts[self.slot] == r then
			f.recasts[self.slot] = nil
			if f.model then
				f.model:SetAttribute("RC" .. self.slot, 0)
			end
			if r.onExpire then
				S.safe(r.onExpire)
			end
		end
	end)
	return r
end

function Ctx:closeRecast()
	local f = self.f
	local r = f.recasts[self.slot]
	if r then
		f.recasts[self.slot] = nil
		if f.model then
			f.model:SetAttribute("RC" .. self.slot, 0)
		end
	end
end

function Ctx:deferCooldown()
	local f = self.f
	f.cooldowns[self.slot] = math.huge
	if f.model then
		f.model:SetAttribute("CD" .. self.slot, -1)
	end
end

function Ctx:startCooldown(seconds)
	Cast.setCooldown(self.f, self.slot, seconds or self.def.cd)
end

-- transformation / timed form: Rupture waits for it. opts.onEnd(reason). Returns form handle.
function Ctx:form(duration, opts)
	opts = opts or {}
	local f = self.f
	local form = { alive = true, ends = S.now() + duration, c = self }
	f.formActive = (f.formActive or 0) + 1
	if opts.deferCooldown ~= false and self.isUlt then
		self:deferCooldown()
	end
	f.model:SetAttribute("FormEnd", form.ends)
	function form.finish(reason)
		if not form.alive then
			return
		end
		form.alive = false
		f.formActive = math.max(0, (f.formActive or 1) - 1)
		if f.formActive == 0 then
			f.formActive = nil
		end
		f.model:SetAttribute("FormEnd", 0)
		if opts.deferCooldown ~= false and self.isUlt then
			self:startCooldown()
		end
		if opts.onEnd then
			S.safe(opts.onEnd, reason or "ended")
		end
	end
	task.delay(duration, function()
		form.finish("expired")
	end)
	local conn
	conn = S.on("defeated", function(df)
		if df == f then
			form.finish("defeated")
			conn()
		end
	end)
	return form
end

-- Cooldowns -----------------------------------------------------------------------------
function Cast.setCooldown(f, slot, seconds)
	local ready = S.now() + (seconds or 0)
	f.cooldowns[slot] = ready
	if f.model then
		f.model:SetAttribute("CD" .. slot, ready)
		f.model:SetAttribute("CDLen" .. slot, seconds or 0)
	end
end

function Cast.reduceCooldown(f, slot, seconds)
	local cur = f.cooldowns[slot] or 0
	if cur == math.huge then
		return
	end
	local ready = math.max(S.now(), cur - seconds)
	f.cooldowns[slot] = ready
	if f.model then
		f.model:SetAttribute("CD" .. slot, ready)
	end
end

function Cast.cooldownLeft(f, slot)
	local cur = f.cooldowns[slot] or 0
	return math.max(0, cur - S.now())
end

-- State -------------------------------------------------------------------------------------
function Cast.isBusy(f)
	if f.action ~= nil or f.ultHold ~= nil then
		return true
	end
	return f.lockUntil ~= nil and f.lockUntil > S.now()
end

local function moveFn(f, slot)
	if f.overrides and f.overrides[slot] then
		return f.overrides[slot]
	end
	return f.kit and f.kit[slot]
end

local function canStart(f, slot, unstable)
	if not S.alive(f) then
		return false, "defeated"
	end
	if not f.kit or not f.kitData then
		return false, "no kit"
	end
	if not S.Fighter.canAct(f) then
		return false, "controlled"
	end
	if f.statuses.silence then
		return false, "silenced"
	end
	local now = S.now()
	if f.burnoutUntil and f.burnoutUntil > now then
		return false, "Burnout"
	end
	if Cast.isBusy(f) then
		return false, "busy"
	end
	if f.disabled and f.disabled[slot] then
		return false, "unavailable"
	end
	local def = f.kitData.moves[slot]
	if not def or not moveFn(f, slot) then
		return false, "no move"
	end
	if (f.cooldowns[slot] or 0) > now then
		return false, "cooldown"
	end
	local cost = (def.energy or 0) * (f.energyCostMult or 1)
	if f.energy < cost then
		return false, "Energy"
	end
	if slot == 5 and f.proxima < Config.MAX_PROXIMA then
		return false, "Proxima"
	end
	if unstable and f.heat < Config.UNSTABLE_MIN_HEAT then
		return false, "Heat"
	end
	return true, def
end
Cast.canStart = canStart

function Cast.begin(f, slot, unstable, mod)
	local ok, def = canStart(f, slot, unstable)
	if not ok then
		if def ~= "busy" and def ~= "cooldown" then
			notify(f, tostring(def))
		end
		return false, def
	end
	local fn = moveFn(f, slot)
	local c = newCtx(f, slot, def)
	c.unstable = unstable == true and slot == 5
	c.mod = mod == true
	c.p60 = slot ~= 5 and f.proxima >= Config.P60
	-- kit pre-commit checks (an invalid target costs nothing)
	local req = f.kit.requires and f.kit.requires[slot]
	if req then
		local okR, reason = req(c)
		if not okR then
			notify(f, reason or "invalid")
			return false, reason
		end
	end
	-- commit
	local cost = (def.energy or 0) * (f.energyCostMult or 1)
	Combat.spendEnergy(f, cost)
	local heat = def.heat or 0
	if c.p60 then
		heat += Config.P60_EXTRA_HEAT
	end
	if c.unstable then
		heat += Config.UNSTABLE_EXTRA_HEAT
	end
	if slot == 5 then
		f.proxima = 0
	end
	Combat.addHeat(f, heat * (f.heatMult or 1))
	f.lastAbilityUse = S.now()
	Cast.setCooldown(f, slot, def.cd)
	f.action = c
	f.guarding = false
	c.phase = "windup"
	c.energyPaid = cost
	Combat.hook(f, "cast", c)
	Combat.extraHooks(f, "cast", c)
	S.emit("cast", f, c)
	local model = f.model
	model:SetAttribute("Casting", slot)
	model:SetAttribute("CastEnd", S.now() + (def.windup or 0))
	local color = S.Util.color(f.kitName)
	if slot == 5 then
		S.FX.text(f.root, (c.unstable and "UNSTABLE " or "") .. string.upper(def.name), c.unstable and Color3.fromRGB(255, 90, 40) or color, math.max(1.2, def.windup or 1), 40)
	elseif c.p60 then
		S.FX.highlight(model, Color3.fromRGB(255, 240, 120), math.max(0.2, def.windup or 0.2), 0.8)
	end
	if (def.windup or 0) > 0 then
		S.FX.highlight(model, color, def.windup, 0.75)
	end
	task.spawn(function()
		local okW = true
		if (def.windup or 0) > 0 then
			okW = c:wait(def.windup)
		end
		if okW then
			c.phase = "active"
			c.active = true
			model:SetAttribute("CastEnd", 0)
			local okRun, err = pcall(fn, c)
			if not okRun then
				warn("[EB] " .. tostring(f.kitName) .. " move " .. slot .. " error: " .. tostring(err))
			end
		elseif c.isUlt and not c.active then
			-- interrupted ultimate before its first active effect
			f.proxima = math.min(Config.MAX_PROXIMA, f.proxima + Config.ULT_INTERRUPT_REFUND_P)
			Combat.addEnergy(f, (c.energyPaid or 0) / 2)
			Cast.setCooldown(f, 5, Config.ULT_INTERRUPT_CD)
			notify(f, "Ultimate interrupted")
		end
		if f.action == c then
			f.action = nil
		end
		if S.alive(f) then
			model:SetAttribute("Casting", 0)
			model:SetAttribute("CastEnd", 0)
			local rec = c.recovery
			if rec == nil then
				rec = Config.DEFAULT_RECOVERY
			end
			f.lockUntil = S.now() + rec
			-- buffered input
			local buf = f.buffer
			if buf and S.now() - buf.t < 0.35 + rec then
				f.buffer = nil
				task.delay(rec, function()
					if S.alive(f) and not Cast.isBusy(f) then
						Cast.press(f, buf.slot, true, buf.mod)
					end
				end)
			end
		end
	end)
	return true
end

-- run a recast for slot
local function runRecast(f, slot, mod)
	local r = f.recasts[slot]
	if not r or r.expires < S.now() then
		return false
	end
	if not S.Fighter.canAct(f) then
		return false
	end
	local parent = r.parent
	r.uses -= 1
	if r.uses <= 0 then
		f.recasts[slot] = nil
		f.model:SetAttribute("RC" .. slot, 0)
	end
	local c2 = newCtx(f, slot, parent.def)
	c2.parent = parent
	c2.isRecast = true
	c2.p60 = parent.p60
	c2.unstable = parent.unstable
	c2.mod = mod
	c2.active = true
	c2.phase = "active"
	c2.data = parent.data
	c2.pGranted = parent.pGranted
	local concurrent = f.action == parent or (f.action ~= nil and f.action.parent == parent)
	if not concurrent then
		if Cast.isBusy(f) then
			-- restore and buffer
			if r.uses <= 0 then
				r.uses = 1
				f.recasts[slot] = r
				f.model:SetAttribute("RC" .. slot, r.expires)
			else
				r.uses += 1
			end
			f.buffer = { slot = slot, t = S.now(), mod = mod }
			return true
		end
		f.action = c2
	end
	task.spawn(function()
		local okRun, res = pcall(r.fn, c2)
		if not okRun then
			warn("[EB] recast error: " .. tostring(res))
		elseif res == "keep" and r.expires > S.now() then
			r.uses = math.max(r.uses, 1)
			f.recasts[slot] = r
			f.model:SetAttribute("RC" .. slot, r.expires)
		end
		if f.action == c2 then
			f.action = nil
			f.lockUntil = S.now() + (c2.recovery or Config.MOVE_RECOVERY)
		end
	end)
	return true
end

-- Input entry points ---------------------------------------------------------------------
function Cast.press(f, slot, down, mod)
	if not S.alive(f) then
		return
	end
	if type(slot) ~= "number" or slot < 1 or slot > 5 then
		return
	end
	if down then
		if f.recasts[slot] then
			if runRecast(f, slot, mod) then
				return
			end
		end
		if f.holds[slot] then
			return
		end
		if slot == 5 and f.heat >= Config.UNSTABLE_MIN_HEAT and f.player then
			local ok, why = canStart(f, 5, true)
			if ok then
				f.ultHold = { start = S.now(), mod = mod }
				f.model:SetAttribute("UltHold", S.now())
				f.holdFX = S.FX.text(f.root, "UNSTABLE HOLD", Color3.fromRGB(255, 120, 40), Config.UNSTABLE_HOLD + 0.2, 34)
				return
			elseif why == "busy" then
				f.buffer = { slot = slot, t = S.now(), mod = mod }
				return
			end
		end
		local ok, why = Cast.begin(f, slot, false, mod)
		if not ok and why == "busy" then
			f.buffer = { slot = slot, t = S.now(), mod = mod }
		end
	else
		local h = f.holds[slot]
		if h then
			h.released = true
		end
		if slot == 5 and f.ultHold then
			-- released before the extra second: ordinary ultimate
			local hold = f.ultHold
			f.ultHold = nil
			f.model:SetAttribute("UltHold", 0)
			if f.holdFX then
				f.holdFX:Destroy()
				f.holdFX = nil
			end
			Cast.begin(f, 5, false, hold.mod)
		end
	end
end

function Cast.updateHold(f, now)
	local h = f.ultHold
	if not h then
		return
	end
	if not S.Fighter.canAct(f) or f.dead then
		Cast.abandonHold(f)
		return
	end
	if now - h.start >= Config.UNSTABLE_HOLD then
		f.ultHold = nil
		f.model:SetAttribute("UltHold", 0)
		f.holdFX = nil
		Cast.begin(f, 5, true, h.mod)
	end
end

function Cast.abandonHold(f)
	if f.ultHold then
		f.ultHold = nil
		f.model:SetAttribute("UltHold", 0)
		if f.holdFX then
			f.holdFX:Destroy()
			f.holdFX = nil
		end
		notify(f, "Unstable hold abandoned")
	end
end

function Cast.rupture(f)
	if not f.rupturePending then
		return
	end
	f.rupturePending = false
	f.proxima = 0
	f.burnoutUntil = S.now() + Config.BURNOUT_TIME
	f.burnoutActive = true
	f.model:SetAttribute("Burnout", f.burnoutUntil)
	S.FX.text(f.root, "BURNOUT", Color3.fromRGB(255, 70, 30), Config.BURNOUT_TIME, 40)
	S.FX.burst(f.root.Position, M * 3, Color3.fromRGB(255, 90, 30), 0.5)
	Combat.hook(f, "rupture")
	Combat.extraHooks(f, "rupture")
end

function Cast.kitAction(f, arg)
	if not S.alive(f) or not f.kit or not f.kit.action then
		return
	end
	if not S.Fighter.canAct(f) then
		return
	end
	S.safe(f.kit.action, f, arg)
end

return Cast
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000070"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[-- Damage / protection / healing / control pipeline (Compendium: "Resolve each impact once").
local S = require(script.Parent.S)
local Status = require(script.Parent.Status)

local Combat = {}
S.Combat = Combat

local Config = S.Config

local remotes -- set by init
function Combat.init(r)
	remotes = r
end

local function hook(f, name, ...)
	local h = f and f.hooks and f.hooks[name]
	if h then
		local ok, res = pcall(h, f, ...)
		if not ok then
			warn("[EB] hook " .. name .. " failed for " .. tostring(f.kitName) .. ": " .. tostring(res))
			return nil
		end
		return res
	end
	return nil
end
Combat.hook = hook

local function extraHooks(f, name, ...)
	if f and f.extraHooks and f.extraHooks[name] then
		for _, fn in ipairs(table.clone(f.extraHooks[name])) do
			local ok, err = pcall(fn, f, ...)
			if not ok then
				warn("[EB] extra hook " .. name .. ": " .. tostring(err))
			end
		end
	end
end
Combat.extraHooks = extraHooks

-- temporary hook registration (stances, marks, transformations). Returns remover.
function Combat.addHook(f, name, fn)
	f.extraHooks = f.extraHooks or {}
	f.extraHooks[name] = f.extraHooks[name] or {}
	table.insert(f.extraHooks[name], fn)
	return function()
		local l = f.extraHooks and f.extraHooks[name]
		if l then
			local i = table.find(l, fn)
			if i then
				table.remove(l, i)
			end
		end
	end
end

local function pop(pos, text, color, kind)
	if remotes and remotes.Pop then
		remotes.Pop:FireAllClients(pos, text, color, kind)
	end
end
Combat.pop = pop

local function facingAngle(target, fromPos)
	if not fromPos then
		return 0
	end
	local look = target.root.CFrame.LookVector
	local to = fromPos - target.root.Position
	local flatTo = Vector3.new(to.X, 0, to.Z)
	if flatTo.Magnitude < 0.1 then
		return 0
	end
	local flatLook = Vector3.new(look.X, 0, look.Z).Unit
	return math.deg(math.acos(math.clamp(flatLook:Dot(flatTo.Unit), -1, 1)))
end
Combat.facingAngle = facingAngle

function Combat.isInvulnerable(f)
	local now = S.now()
	return (f.iframeUntil and f.iframeUntil > now) or (f.invulnUntil and f.invulnUntil > now) or (f.invulnCount or 0) > 0
end

-- Proxima helpers -------------------------------------------------------------
function Combat.addProxima(f, amount, reason)
	if f.isSummon or f.rupturePending or amount <= 0 then
		return 0
	end
	local now = S.now()
	-- 10 P/s cap from all sources (rolling 1s window)
	f.pWindow = f.pWindow or {}
	local sum = 0
	for i = #f.pWindow, 1, -1 do
		local e = f.pWindow[i]
		if now - e.t > 1 then
			table.remove(f.pWindow, i)
		else
			sum += e.a
		end
	end
	local allowed = math.max(0, Config.P_MAX_PER_SECOND - sum)
	local gain = math.min(amount, allowed, Config.MAX_PROXIMA - f.proxima)
	if gain > 0 then
		table.insert(f.pWindow, { t = now, a = gain })
		f.proxima += gain
	end
	return gain
end

function Combat.contest(a, b)
	if not (S.isReal(a) and S.isReal(b)) then
		return
	end
	if not S.isEnemy(a, b) then
		return
	end
	local now = S.now()
	a.contest[b] = now
	b.contest[a] = now
	a.lastContest = now
	b.lastContest = now
end

local function FXwarn(f)
	if S.FX and f.model then
		S.FX.text(f.root, "RUPTURE PENDING", Color3.fromRGB(255, 80, 40), 2)
	end
end

function Combat.addHeat(f, amount)
	if amount <= 0 then
		return
	end
	f.heat = math.min(Config.MAX_HEAT, f.heat + amount)
	f.lastAbilityUse = S.now()
	if f.heat >= Config.MAX_HEAT and not f.rupturePending and not (f.burnoutUntil and f.burnoutUntil > S.now()) then
		f.rupturePending = true
		FXwarn(f)
	end
end

function Combat.spendEnergy(f, amount)
	if amount <= 0 then
		return true
	end
	if f.energy < amount then
		return false
	end
	f.energy -= amount
	f.lastEnergySpend = S.now()
	return true
end

function Combat.addEnergy(f, amount)
	f.energy = math.clamp(f.energy + amount, 0, Config.MAX_ENERGY)
end

-- Shields ----------------------------------------------------------------------
function Combat.totalShield(f)
	local s = 0
	for _, sh in ipairs(f.shields) do
		s += sh.amount
	end
	return s
end

-- add a personal shield; same name replaces if higher; respects the 400 cap
function Combat.shield(target, amount, duration, name, src)
	if not S.alive(target) or amount <= 0 then
		return 0
	end
	local now = S.now()
	name = name or "shield"
	duration = duration or 4
	local info = { amount = amount, duration = duration, name = name, src = src }
	hook(target, "beforeShield", info)
	extraHooks(target, "beforeShield", info)
	if info.cancel then
		return 0
	end
	amount = info.amount
	for i, sh in ipairs(target.shields) do
		if sh.name == name then
			if amount > sh.amount then
				table.remove(target.shields, i)
				break
			else
				return 0
			end
		end
	end
	local room = Config.MAX_SHIELD - Combat.totalShield(target)
	amount = math.min(amount, room)
	if amount <= 0 then
		return 0
	end
	table.insert(target.shields, { amount = amount, expires = now + duration, name = name, src = src })
	table.sort(target.shields, function(a, b)
		return a.expires < b.expires
	end)
	hook(target, "shieldCreated", amount, name, src)
	extraHooks(target, "shieldCreated", amount, name, src)
	if src and src ~= target and S.isAlly(src, target) and target.lastContest and now - target.lastContest < 4 then
		Combat.addProxima(src, Config.P_SUPPORT_GAIN, "support")
	end
	pop(target.root.Position, "+" .. math.floor(amount) .. " shield", Color3.fromRGB(140, 200, 255), "shield")
	return amount
end

function Combat.removeShield(target, name, amount)
	for i = #target.shields, 1, -1 do
		local sh = target.shields[i]
		if name == nil or sh.name == name then
			if amount then
				local take = math.min(amount, sh.amount)
				sh.amount -= take
				amount -= take
				if sh.amount <= 0 then
					table.remove(target.shields, i)
				end
				if amount <= 0 then
					return
				end
			else
				table.remove(target.shields, i)
			end
		end
	end
end

local function absorb(target, amount, info)
	local absorbed = 0
	local mult = info.shieldMult or 1
	local i = 1
	while amount > 0 and i <= #target.shields do
		local sh = target.shields[i]
		local need = amount * mult
		if sh.amount > need then
			sh.amount -= need
			absorbed += amount
			amount = 0
		else
			local covers = sh.amount / mult
			absorbed += covers
			amount -= covers
			table.remove(target.shields, i)
			hook(target, "shieldBroken", sh)
			extraHooks(target, "shieldBroken", sh)
		end
	end
	return amount, absorbed
end

-- Healing ------------------------------------------------------------------------
function Combat.heal(src, target, amount, opts)
	if not S.alive(target) or amount <= 0 then
		return 0
	end
	opts = opts or {}
	if target.noHeal and not opts.force then
		return 0
	end
	local now = S.now()
	local info = { amount = amount * Status.healMult(target), src = src, opts = opts }
	hook(target, "beforeHeal", info)
	extraHooks(target, "beforeHeal", info)
	amount = info.amount
	-- 250 health / rolling second
	target.healWindow = target.healWindow or {}
	local sum = 0
	for i = #target.healWindow, 1, -1 do
		local e = target.healWindow[i]
		if now - e.t > 1 then
			table.remove(target.healWindow, i)
		else
			sum += e.a
		end
	end
	amount = math.min(amount, Config.HEAL_CAP_PER_SECOND - sum, target.maxHealth - target.health)
	if amount <= 0 then
		return 0
	end
	table.insert(target.healWindow, { t = now, a = amount })
	target.health += amount
	if S.Fighter then
		S.Fighter.syncHealth(target)
	end
	if src and src ~= target and S.isAlly(src, target) and not opts.noProxima and target.lastContest and now - target.lastContest < 4 then
		Combat.addProxima(src, Config.P_SUPPORT_GAIN, "support")
	end
	if amount >= 1 then
		pop(target.root.Position, "+" .. math.floor(amount + 0.5), Color3.fromRGB(110, 255, 140), "heal")
	end
	hook(src, "healed", target, amount)
	return amount
end

-- Damage -----------------------------------------------------------------------
--[[ opts:
	kind = "direct" (default) | "dot" | "field" | "true" (ignores reductions)
	cast (ctx), slot, isUlt, isBasic, fromPos (for guard facing), guardDmg (extra guard damage),
	noGuard, unblockable, pierceShield, element, tag, noProxima, fromSummon, melee, projectile,
	noReduction, shieldMult, cap
]]
function Combat.damage(src, target, amount, opts)
	if not S.alive(target) or amount <= 0 then
		return 0, "invalid"
	end
	opts = opts or {}
	local now = S.now()
	if target.isDummyInvuln then
		return 0, "invalid"
	end
	if Combat.isInvulnerable(target) and opts.kind ~= "true" then
		hook(target, "evaded", src, opts)
		extraHooks(target, "evaded", src, opts)
		S.emit("evaded", target, src, opts)
		pop(target.root.Position, "EVADE", Color3.fromRGB(200, 200, 200), "info")
		return 0, "invulnerable"
	end
	local info = {
		src = src,
		target = target,
		amount = amount,
		base = amount,
		bonus = 0, -- additive % bonuses
		kind = opts.kind or "direct",
		opts = opts,
		fromPos = opts.fromPos or (src and src.root and src.root.Position),
		guardDmg = opts.guardDmg or 0,
		shieldMult = opts.shieldMult or 1,
	}
	local direct = info.kind == "direct"
	-- passive hooks (attacker then target)
	if src and src ~= target then
		hook(src, "beforeDeal", target, info)
		extraHooks(src, "beforeDeal", target, info)
	end
	hook(target, "beforeTake", info)
	extraHooks(target, "beforeTake", info)
	if info.cancel then
		return 0, info.cancelReason or "cancelled"
	end
	-- percentage bonuses add, never compound
	if src and info.kind ~= "true" then
		info.bonus += Status.dmgBonus(src)
	end
	if info.kind ~= "true" then
		info.bonus += Status.vuln(target)
	end
	local dmg = info.amount * math.max(0, 1 + info.bonus)
	if opts.cap then
		dmg = math.min(dmg, opts.cap)
	end
	local pre = dmg
	-- guard
	local guarded, perfect = false, false
	if direct and not opts.noGuard and not opts.unblockable and target.guarding and not target.isSummon then
		if facingAngle(target, info.fromPos) <= Config.GUARD_ARC / 2 then
			guarded = true
			perfect = target.guardStart and (now - target.guardStart) <= Config.PERFECT_GUARD_WINDOW
		end
	end
	local reduction = 0
	if info.kind ~= "true" and not opts.noReduction then
		reduction = Status.dr(target)
	end
	if guarded then
		local drain = pre * Config.GUARD_HIT_DRAIN + info.guardDmg
		if perfect then
			drain *= 0.5
			reduction = Config.PERFECT_GUARD_REDUCTION
			if not target.lastPerfectGuard or now - target.lastPerfectGuard >= Config.P_PERFECT_GUARD_ICD then
				target.lastPerfectGuard = now
				Combat.addProxima(target, Config.P_PERFECT_GUARD_GAIN, "perfect")
			end
			pop(target.root.Position, "PERFECT", Color3.fromRGB(255, 255, 120), "info")
			hook(target, "perfectGuard", src, info)
			extraHooks(target, "perfectGuard", src, info)
		else
			reduction = math.min(Config.MAX_COMBINED_REDUCTION, 1 - (1 - Config.GUARD_REDUCTION) * (1 - reduction))
		end
		target.guard -= drain
		target.lastGuardHit = now
		if target.guard <= 0 then
			target.guard = 0
			Combat.guardBreak(target, src)
		end
		hook(target, "guarded", src, info)
		extraHooks(target, "guarded", src, info)
	else
		reduction = math.min(reduction, Config.MAX_COMBINED_REDUCTION)
	end
	dmg = dmg * (1 - reduction)
	local prevented = pre - dmg
	-- shields
	local absorbed = 0
	if not opts.pierceShield and #target.shields > 0 then
		dmg, absorbed = absorb(target, dmg, info)
	end
	info.final = dmg
	info.absorbed = absorbed
	info.prevented = prevented
	info.guarded = guarded
	info.perfect = perfect
	-- apply to health
	if dmg > 0 then
		target.health -= dmg
		target.lastHit = now
		target.lastDamager = src and (src.owner or src) or target.lastDamager
		target.lastDamagerTime = now
	end
	if direct or info.kind == "field" then
		target.lastDirectHit = now
	end
	-- sleep breaks on damage
	if dmg > 0 and target.statuses.sleep and not target.statuses.sleep.data.noWake then
		Status.remove(target, "sleep", "woken")
	end
	-- contest + proxima
	if src and src ~= target and (direct or prevented > 0 or absorbed > 0) then
		local real = src.owner or src
		Combat.contest(real, target)
		local c = opts.cast
		if
			c
			and direct
			and not c.isUlt
			and not opts.isBasic
			and not opts.noProxima
			and not opts.fromSummon
			and not src.isSummon
			and S.isReal(target)
			and not c.pGranted
		then
			c.pGranted = true
			Combat.addProxima(src, Config.P_HIT_GAIN, "hit")
		end
	end
	-- popups
	local shown = dmg + absorbed
	if shown >= 0.5 then
		local col = guarded and Color3.fromRGB(150, 170, 255) or Color3.fromRGB(255, 220, 120)
		if absorbed > 0 and dmg <= 0 then
			col = Color3.fromRGB(140, 200, 255)
		end
		pop(target.root.Position, tostring(math.floor(shown + 0.5)), col, info.kind)
	end
	if S.Fighter then
		S.Fighter.syncHealth(target)
	end
	-- after hooks
	if src and src ~= target then
		hook(src, "dealt", target, info)
		extraHooks(src, "dealt", target, info)
		if src.isSummon and src.owner then
			hook(src.owner, "summonDealt", target, info, src)
		end
	end
	hook(target, "taken", info)
	extraHooks(target, "taken", info)
	S.emit("damaged", target, info)
	if target.health <= 0 then
		Combat.defeat(target, src, info)
	end
	return dmg + absorbed, guarded and "guarded" or "hit", info
end

function Combat.defeat(target, src, info)
	if target.dead then
		return
	end
	-- a previously committed effect may intercept defeat (e.g. Phoenix rescue)
	local saved = hook(target, "beforeDefeat", src, info)
	if not saved and target.extraHooks and target.extraHooks.beforeDefeat then
		for _, fn in ipairs(table.clone(target.extraHooks.beforeDefeat)) do
			local ok, res = pcall(fn, target, src, info)
			if ok and res then
				saved = true
				break
			end
		end
	end
	if saved and target.health > 0 then
		return
	end
	target.health = 0
	if S.Fighter then
		S.Fighter.kill(target, src)
	end
end

-- Control -------------------------------------------------------------------------
local CONTROL_LABEL = { stun = "Stun", root = "Root", sleep = "Sleep", lift = "Lifted", guardbreak = "Guard Break", lock = "Locked" }

-- Applies hard control subject to the shared 2s / 6s budget. Returns applied duration.
function Combat.control(target, kind, duration, src, opts)
	if not S.alive(target) or duration <= 0 then
		return 0
	end
	opts = opts or {}
	local now = S.now()
	if target.isSummon and target.controlImmune then
		return 0
	end
	if Combat.isInvulnerable(target) and not opts.force then
		return 0
	end
	local info = { kind = kind, duration = duration, src = src }
	hook(target, "beforeControl", info)
	extraHooks(target, "beforeControl", info)
	if info.cancel then
		return 0
	end
	duration = info.duration
	if target.ccImmuneUntil and target.ccImmuneUntil > now then
		pop(target.root.Position, "IMMUNE", Color3.fromRGB(255, 255, 255), "info")
		return 0
	end
	-- rolling budget
	local used = 0
	for i = #target.controlLog, 1, -1 do
		local e = target.controlLog[i]
		if now - (e.t + e.d) > Config.CONTROL_WINDOW then
			table.remove(target.controlLog, i)
		else
			local startIn = math.max(e.t, now - Config.CONTROL_WINDOW)
			used += math.max(0, (e.t + e.d) - startIn)
		end
	end
	local budget = Config.CONTROL_BUDGET - used
	if budget <= 0.02 then
		target.ccImmuneUntil = now + Config.CONTROL_IMMUNITY
		pop(target.root.Position, "IMMUNE", Color3.fromRGB(255, 255, 255), "info")
		return 0
	end
	local applied = math.min(duration, budget)
	table.insert(target.controlLog, { t = now, d = applied })
	if applied >= budget - 0.01 then
		target.ccImmuneUntil = now + applied + Config.CONTROL_IMMUNITY
	end
	local st = Status.apply(target, kind, {
		duration = applied,
		source = src,
		category = "control",
		label = CONTROL_LABEL[kind] or kind,
		data = { noWake = opts.noWake },
	})
	if st then
		st.removable = false
	end
	if kind == "stun" or kind == "sleep" or kind == "guardbreak" or kind == "lock" then
		Combat.interrupt(target, kind)
		target.guarding = false
	end
	if kind == "lift" and S.Fighter then
		S.Fighter.applyLift(target, opts.height or S.m(2), applied)
	end
	hook(target, "controlled", kind, applied, src)
	extraHooks(target, "controlled", kind, applied, src)
	S.emit("controlled", target, kind, applied, src)
	pop(target.root.Position, (CONTROL_LABEL[kind] or kind):upper(), Color3.fromRGB(255, 200, 255), "info")
	return applied
end

function Combat.stun(t, d, src)
	return Combat.control(t, "stun", d, src)
end
function Combat.root(t, d, src)
	return Combat.control(t, "root", d, src)
end
function Combat.sleep(t, d, src)
	return Combat.control(t, "sleep", d, src)
end
function Combat.lift(t, d, src, height)
	return Combat.control(t, "lift", d, src, { height = height })
end

function Combat.guardBreak(target, src)
	target.guarding = false
	target.guardBrokenUntil = S.now() + Config.GUARD_BREAK_TIME
	local applied = Combat.control(target, "guardbreak", Config.GUARD_BREAK_TIME, src)
	if applied <= 0 then
		target.guardBrokenUntil = S.now() + 0.05
	end
	task.delay(Config.GUARD_BREAK_TIME, function()
		if S.alive(target) then
			target.guard = math.max(target.guard, Config.GUARD_BREAK_RETURN)
		end
	end)
	pop(target.root.Position, "GUARD BREAK", Color3.fromRGB(255, 120, 60), "info")
end

-- interrupt current channel/windup (named interrupt). Returns true if something was interrupted.
function Combat.interrupt(target, reason)
	local c = target.action
	if c and not c.uninterruptible then
		c.interrupted = true
		c.interruptReason = reason
		return true
	end
	return false
end

-- Displacement (distance in studs) ---------------------------------------------------
function Combat.knockback(target, fromPos, dist, src, opts)
	if not S.alive(target) or dist <= 0 then
		return
	end
	opts = opts or {}
	local info = { dist = dist, src = src, kind = "knockback" }
	hook(target, "beforeDisplace", info)
	extraHooks(target, "beforeDisplace", info)
	if info.cancel then
		return
	end
	local d = target.root.Position - fromPos
	d = Vector3.new(d.X, 0, d.Z)
	if d.Magnitude < 0.05 then
		d = -target.root.CFrame.LookVector
	end
	S.Fighter.displace(target, d.Unit, info.dist, opts.time or 0.2, opts.up)
end

function Combat.push(target, dir, dist, src, opts)
	if not S.alive(target) or dist <= 0 then
		return
	end
	opts = opts or {}
	local info = { dist = dist, src = src, kind = "push" }
	hook(target, "beforeDisplace", info)
	extraHooks(target, "beforeDisplace", info)
	if info.cancel then
		return
	end
	local d = Vector3.new(dir.X, 0, dir.Z)
	if d.Magnitude < 0.01 then
		return
	end
	S.Fighter.displace(target, d.Unit, info.dist, opts.time or 0.2, opts.up)
end

function Combat.pull(target, toPos, dist, src, opts)
	if not S.alive(target) then
		return
	end
	opts = opts or {}
	local d = toPos - target.root.Position
	d = Vector3.new(d.X, 0, d.Z)
	local maxd = d.Magnitude - S.m(0.8)
	if maxd <= 0.1 then
		return
	end
	local info = { dist = math.min(dist, maxd), src = src, kind = "pull" }
	hook(target, "beforeDisplace", info)
	extraHooks(target, "beforeDisplace", info)
	if info.cancel then
		return
	end
	S.Fighter.displace(target, d.Unit, info.dist, opts.time or 0.25)
end

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000071"><Properties><string name="Name">FX</string><ProtectedString name="Source"><![CDATA[-- Server-side readable visuals: telegraphs, beams, bursts, labels. All parts are non-colliding and
-- non-queryable so they never interfere with hit detection. Warnings always precede damage.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local S = require(script.Parent.S)

local FX = {}
S.FX = FX

local WHITE = Color3.new(1, 1, 1)

local function base(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = props.material or Enum.Material.Neon
	p.Color = props.color or WHITE
	p.Transparency = props.transparency or 0.3
	p.Shape = props.shape or Enum.PartType.Block
	p.Size = props.size or Vector3.new(1, 1, 1)
	p.CFrame = props.cf or CFrame.new()
	p.Name = props.name or "FX"
	p.Parent = props.parent or S.folders.FX
	return p
end
FX.base = base

local function fadeAndDestroy(p, dur, fade)
	if dur == nil then
		return
	end
	if fade ~= false and dur > 0.1 then
		task.delay(math.max(0, dur * 0.6), function()
			if p.Parent then
				TweenService:Create(p, TweenInfo.new(dur * 0.4), { Transparency = 1 }):Play()
			end
		end)
	end
	Debris:AddItem(p, dur)
end

-- sphere at pos, radius in studs
function FX.sphere(pos, radius, color, dur, transparency)
	local p = base({
		shape = Enum.PartType.Ball,
		size = Vector3.one * radius * 2,
		cf = CFrame.new(pos),
		color = color,
		transparency = transparency or 0.45,
	})
	fadeAndDestroy(p, dur or 0.4)
	return p
end

-- expanding burst
function FX.burst(pos, radius, color, dur)
	dur = dur or 0.35
	local p = base({
		shape = Enum.PartType.Ball,
		size = Vector3.one * 0.5,
		cf = CFrame.new(pos),
		color = color,
		transparency = 0.25,
	})
	TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * radius * 2,
		Transparency = 1,
	}):Play()
	Debris:AddItem(p, dur + 0.05)
	return p
end

-- flat disc on the ground (radius studs)
function FX.disc(pos, radius, color, dur, transparency, height)
	local p = base({
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(height or 0.25, radius * 2, radius * 2),
		cf = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
		color = color,
		transparency = transparency or 0.6,
		material = Enum.Material.ForceField,
	})
	if dur then
		fadeAndDestroy(p, dur)
	end
	return p
end

-- ring outline made of a thin cylinder shell approximated by 24 segments
function FX.ring(pos, radius, color, dur, thickness)
	thickness = thickness or 0.35
	local model = Instance.new("Model")
	model.Name = "Ring"
	local segs = 24
	local segLen = 2 * math.pi * radius / segs * 1.05
	for i = 1, segs do
		local a = (i / segs) * math.pi * 2
		local cf = CFrame.new(pos + Vector3.new(math.cos(a) * radius, 0.15, math.sin(a) * radius))
			* CFrame.Angles(0, -a, 0)
		base({ size = Vector3.new(thickness, 0.2, segLen), cf = cf, color = color, transparency = 0.15, parent = model })
	end
	model.Parent = S.folders.FX
	if dur then
		Debris:AddItem(model, dur)
	end
	return model
end

-- telegraph: outline ring + a disc that fills over `dur`; returns the model
function FX.telegraph(pos, radius, dur, color)
	color = color or Color3.fromRGB(255, 80, 80)
	local m = FX.ring(pos, radius, color, dur + 0.05, 0.3)
	local fill = base({
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.2, 0.2, 0.2),
		cf = CFrame.new(pos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		color = color,
		transparency = 0.55,
		parent = m,
	})
	TweenService:Create(fill, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
		Size = Vector3.new(0.2, radius * 2, radius * 2),
	}):Play()
	return m
end

-- rectangle telegraph along the ground
function FX.rect(cf, width, length, dur, color, transparency)
	local p = base({
		size = Vector3.new(width, 0.2, length),
		cf = cf,
		color = color or Color3.fromRGB(255, 80, 80),
		transparency = transparency or 0.55,
		material = Enum.Material.ForceField,
	})
	if dur then
		Debris:AddItem(p, dur)
	end
	return p
end

function FX.lineTelegraph(origin, dir, length, width, dur, color)
	local d = Vector3.new(dir.X, 0, dir.Z)
	if d.Magnitude < 1e-3 then
		d = Vector3.new(0, 0, -1)
	end
	d = d.Unit
	local mid = origin + d * (length / 2)
	return FX.rect(CFrame.lookAt(mid, mid + d), width, length, dur, color, 0.5)
end

-- straight beam between two points
function FX.beam(a, b, width, color, dur, transparency)
	local len = (b - a).Magnitude
	if len < 0.05 then
		return nil
	end
	local p = base({
		size = Vector3.new(width, width, len),
		cf = CFrame.lookAt((a + b) / 2, b),
		color = color,
		transparency = transparency or 0.2,
	})
	fadeAndDestroy(p, dur or 0.2)
	return p
end

-- cone fan visual
function FX.cone(origin, dir, length, angle, color, dur)
	local d = Vector3.new(dir.X, 0, dir.Z)
	if d.Magnitude < 1e-3 then
		d = Vector3.new(0, 0, -1)
	end
	d = d.Unit
	local n = math.max(3, math.floor(angle / 15))
	for i = 0, n do
		local a = -angle / 2 + angle * i / n
		local dd = CFrame.Angles(0, math.rad(a), 0):VectorToWorldSpace(d)
		FX.beam(origin, origin + dd * length, 0.3, color, dur or 0.3, 0.4)
	end
end

-- floating label (used for announcements such as Chaos outcomes or status pops)
function FX.text(adornee, text, color, dur, size)
	local holder
	if typeof(adornee) == "Vector3" then
		holder = base({ size = Vector3.new(0.2, 0.2, 0.2), cf = CFrame.new(adornee), transparency = 1 })
		adornee = holder
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, size or 36)
	bb.StudsOffset = Vector3.new(0, 4.5, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 140
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.TextColor3 = color or WHITE
	lbl.TextStrokeTransparency = 0.2
	lbl.Text = text
	lbl.Parent = bb
	bb.Adornee = adornee
	bb.Parent = holder or adornee
	Debris:AddItem(holder or bb, dur or 1.5)
	return bb
end

-- coloured highlight on a model for `dur`
function FX.highlight(model, color, dur, fill)
	if not model then
		return nil
	end
	local h = Instance.new("Highlight")
	h.FillColor = color or WHITE
	h.OutlineColor = color or WHITE
	h.FillTransparency = fill or 0.65
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = model
	if dur then
		Debris:AddItem(h, dur)
	end
	return h
end

function FX.trail(part, color, dur)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.5, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.5, 0)
	a1.Parent = part
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Color = ColorSequence.new(color)
	t.Lifetime = 0.25
	t.LightEmission = 0.6
	t.Transparency = NumberSequence.new(0.2, 1)
	t.Parent = part
	if dur then
		Debris:AddItem(t, dur)
		Debris:AddItem(a0, dur)
		Debris:AddItem(a1, dur)
	end
	return t
end

local SOUNDS = {
	swing = "rbxasset://sounds/swordslash.wav",
	lunge = "rbxasset://sounds/swordlunge.wav",
	shoot = "rbxasset://sounds/Rocket shot.wav",
	hit = "rbxasset://sounds/collide.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	unsheath = "rbxasset://sounds/unsheath.wav",
}
function FX.sound(where, name, volume)
	local id = SOUNDS[name]
	if not id then
		return
	end
	local holder = where
	if typeof(where) == "Vector3" then
		holder = base({ size = Vector3.new(0.2, 0.2, 0.2), cf = CFrame.new(where), transparency = 1 })
		Debris:AddItem(holder, 2)
	end
	if not holder then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.4
	s.RollOffMaxDistance = 120
	s.Parent = holder
	s:Play()
	Debris:AddItem(s, 2)
end

return FX
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000072"><Properties><string name="Name">Fighter</string><ProtectedString name="Source"><![CDATA[-- A Fighter is any damageable combatant: players, bots, training dummies and summons.
local Players = game:GetService("Players")
local S = require(script.Parent.S)
local Status = require(script.Parent.Status)

local Fighter = {}
S.Fighter = Fighter

local Config = S.Config
local M = Config.METRE

function Fighter.get(model)
	return S.byModel[model]
end

function Fighter.fromPart(part)
	local m = part
	while m and m ~= workspace do
		local f = S.byModel[m]
		if f then
			return f
		end
		m = m.Parent
	end
	return nil
end

function Fighter.new(model, opts)
	opts = opts or {}
	S.nextId += 1
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	local hum = model:FindFirstChildOfClass("Humanoid")
	local maxHealth = opts.maxHealth or Config.MAX_HEALTH
	local now = S.now()
	local f = {
		id = S.nextId,
		model = model,
		root = root,
		humanoid = hum,
		player = opts.player,
		isBot = opts.isBot,
		isDummy = opts.isDummy,
		isSummon = opts.isSummon,
		owner = opts.owner,
		team = opts.team,
		name = opts.name or model.Name,
		maxHealth = maxHealth,
		health = maxHealth,
		energy = Config.MAX_ENERGY,
		heat = 0,
		proxima = 0,
		guard = Config.MAX_GUARD,
		dodgeCharges = Config.DODGE_CHARGES,
		dodgeRechargeAt = 0,
		lastEnergySpend = 0,
		lastAbilityUse = 0,
		lastGuardHit = 0,
		lastHit = 0,
		lastDirectHit = 0,
		lastContest = 0,
		contest = {},
		shields = {},
		statuses = {},
		controlLog = {},
		cooldowns = { 0, 0, 0, 0, 0 },
		recasts = {},
		holds = {},
		res = {},
		state = {},
		hooks = {},
		objects = {},
		summons = {},
		zones = {},
		stationary = 0,
		invulnCount = 0,
		untargetable = 0,
		hitScale = 1,
		speedMult = 1,
		jumpMult = 1,
		lastBasic = 0,
		spawnTime = now,
		attrCache = {},
		aim = nil,
		radius = opts.radius,
	}
	S.fighters[f.id] = f
	S.byModel[model] = f
	if hum then
		hum.MaxHealth = maxHealth
		hum.Health = maxHealth
		hum.UseJumpPower = false
		hum.JumpHeight = Config.JUMP_HEIGHT * M
		hum.WalkSpeed = Config.RUN_SPEED * M
		hum.BreakJointsOnDeath = false
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	if root then
		f.lastLegal = root.Position
	end
	model:SetAttribute("FighterId", f.id)
	model:SetAttribute("MaxHealth", maxHealth)
	if opts.kit then
		Fighter.setKit(f, opts.kit)
	end
	Fighter.attachNameplate(f)
	return f
end

function Fighter.setKit(f, kitName)
	local kits = S.Kits
	local kit = kits and kits.get(kitName)
	if not kit then
		warn("[EB] unknown kit " .. tostring(kitName))
		kitName = Config.DEFAULT_KIT
		kit = kits.get(kitName)
	end
	-- teardown previous kit state
	if f.kit and f.kit.passive and f.kit.passive.cleanup then
		S.safe(f.kit.passive.cleanup, f)
	end
	f.kitName = kitName
	f.kit = kit
	f.kitData = kits.data(kitName)
	f.hooks = {}
	f.extraHooks = {}
	f.state = {}
	f.res = {}
	f.overrides = {}
	f.cooldowns = { 0, 0, 0, 0, 0 }
	if kit.passive then
		for k, v in pairs(kit.passive) do
			if type(v) == "function" and k ~= "init" and k ~= "tick" and k ~= "cleanup" then
				f.hooks[k] = v
			end
		end
		if kit.passive.init then
			S.safe(kit.passive.init, f)
		end
	end
	f.model:SetAttribute("Kit", kitName)
	f.resDirty = true
end

-- Resource bar for kit-specific counters (shown on the HUD).
function Fighter.setRes(f, key, value, max, order)
	local r = f.res[key]
	if not r then
		r = { order = order or 10 }
		f.res[key] = r
	end
	if r.value ~= value or r.max ~= max then
		r.value = value
		r.max = max
		f.resDirty = true
	end
end

function Fighter.clearRes(f, key)
	if f.res[key] then
		f.res[key] = nil
		f.resDirty = true
	end
end

local function resString(f)
	local items = {}
	for k, r in pairs(f.res) do
		local v = r.value
		local txt
		if type(v) == "number" then
			txt = k .. " " .. S.Util.fmt(v) .. (r.max and ("/" .. S.Util.fmt(r.max)) or "")
		else
			txt = k .. ": " .. tostring(v)
		end
		table.insert(items, { o = r.order or 10, t = txt })
	end
	table.sort(items, function(a, b)
		if a.o == b.o then
			return a.t < b.t
		end
		return a.o < b.o
	end)
	local out = {}
	for _, it in ipairs(items) do
		table.insert(out, it.t)
	end
	return table.concat(out, "   ")
end

local function setAttr(f, key, value)
	if f.attrCache[key] ~= value then
		f.attrCache[key] = value
		f.model:SetAttribute(key, value)
	end
end
Fighter.setAttr = setAttr

function Fighter.syncHealth(f)
	if f.health > f.maxHealth then
		f.health = f.maxHealth
	end
	if f.humanoid and not f.dead then
		f.humanoid.MaxHealth = f.maxHealth
		f.humanoid.Health = math.max(f.health, 0.01)
	end
	setAttr(f, "Health", math.max(0, math.floor(f.health + 0.5)))
	setAttr(f, "Shield", math.floor(S.Combat.totalShield(f) + 0.5))
end

function Fighter.attachNameplate(f)
	if not f.root then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "EBPlate"
	bb.Size = UDim2.fromOffset(150, 46)
	bb.StudsOffset = Vector3.new(0, f.isSummon and 2.5 or 3.6, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	bb.Adornee = f.model:FindFirstChild("Head") or f.root
	local name = Instance.new("TextLabel")
	name.Name = "NameLabel"
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 16)
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.3
	name.Text = f.name
	name.Parent = bb
	local back = Instance.new("Frame")
	back.Name = "Bar"
	back.Position = UDim2.fromOffset(0, 18)
	back.Size = UDim2.new(1, 0, 0, 8)
	back.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	back.BorderSizePixel = 0
	back.Parent = bb
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(90, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local sh = Instance.new("Frame")
	sh.Name = "ShieldFill"
	sh.Size = UDim2.fromScale(0, 1)
	sh.BackgroundColor3 = Color3.fromRGB(140, 200, 255)
	sh.BackgroundTransparency = 0.2
	sh.BorderSizePixel = 0
	sh.Parent = back
	local st = Instance.new("TextLabel")
	st.Name = "Status"
	st.BackgroundTransparency = 1
	st.Position = UDim2.fromOffset(0, 28)
	st.Size = UDim2.new(1, 0, 0, 16)
	st.Font = Enum.Font.Gotham
	st.TextScaled = true
	st.TextColor3 = Color3.fromRGB(255, 220, 160)
	st.TextStrokeTransparency = 0.4
	st.Text = ""
	st.Parent = bb
	bb.Parent = f.root
	f.plate = bb
end

local function updatePlate(f)
	local bb = f.plate
	if not bb then
		return
	end
	local fill = bb.Bar.Fill
	local pct = math.clamp(f.health / f.maxHealth, 0, 1)
	fill.Size = UDim2.fromScale(pct, 1)
	fill.BackgroundColor3 = Color3.fromRGB(255, 70, 70):Lerp(Color3.fromRGB(90, 220, 90), pct)
	local shv = math.clamp(S.Combat.totalShield(f) / f.maxHealth, 0, 1)
	bb.Bar.ShieldFill.Size = UDim2.fromScale(shv, 1)
	local lbl = f.statusText or ""
	if f.kitName and not f.isSummon then
		bb.NameLabel.Text = f.name .. "  [" .. f.kitName .. "]"
	end
	bb.Status.Text = lbl
end

-- Movement ----------------------------------------------------------------------
function Fighter.canMove(f)
	local s = f.statuses
	return not (s.stun or s.root or s.sleep or s.lift or s.guardbreak or s.lock) and f.stationary <= 0
end

function Fighter.canAct(f)
	local s = f.statuses
	return not (s.stun or s.sleep or s.guardbreak or s.lock) and not f.dead
end

function Fighter.applyMovement(f)
	local hum = f.humanoid
	if not hum or f.dead then
		return
	end
	local speed = Config.RUN_SPEED * M
	local mult = (1 - Status.slow(f)) * (1 + Status.speedBonus(f)) * (f.speedMult or 1)
	if f.guarding then
		mult *= Config.GUARD_MOVE_MULT
	end
	local a = f.action
	if a and a.phase == "windup" and not a.moveFree then
		mult *= 0.5
	elseif a and a.halfSpeed then
		mult *= 0.5
	end
	if f.isDummy then
		mult = 0
	end
	local s = f.statuses
	local jump = Config.JUMP_HEIGHT * M * (f.jumpMult or 1)
	if s.stun or s.root or s.sleep or s.lift or s.guardbreak or s.lock or f.stationary > 0 then
		mult = 0
		jump = 0
	end
	local ws = speed * mult
	if math.abs(hum.WalkSpeed - ws) > 0.05 then
		hum.WalkSpeed = ws
	end
	if math.abs(hum.JumpHeight - jump) > 0.05 then
		hum.JumpHeight = jump
	end
end

-- velocity-based displacement (works for client-owned characters)
function Fighter.displace(f, dirUnit, dist, time, up)
	if not S.alive(f) or dist <= 0 then
		return
	end
	if f.isSummon then
		local target = S.Hit.clearPath(f.root.Position, dirUnit, dist, 1)
		f.root.CFrame = CFrame.new(target) * f.root.CFrame.Rotation
		return
	end
	time = math.max(0.08, time or 0.2)
	-- clip to walls
	local endPos = S.Hit.clearPath(f.root.Position, dirUnit, dist, 1.3)
	local real = (endPos - f.root.Position).Magnitude
	if real < 0.2 then
		return
	end
	local att = f.root:FindFirstChild("EBMoveAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "EBMoveAtt"
		att.Parent = f.root
	end
	local old = f.root:FindFirstChild("EBDisplace")
	if old then
		old:Destroy()
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = "EBDisplace"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.MaxForce = 1e7
	lv.VectorVelocity = dirUnit * (real / time) + Vector3.new(0, up or 0, 0)
	lv.Parent = f.root
	f.displacedUntil = S.now() + time
	task.delay(time, function()
		if lv.Parent then
			lv:Destroy()
		end
	end)
end

-- dash used by movement abilities and dodge; returns final travel distance (studs)
function Fighter.dash(f, dirUnit, dist, time, opts)
	opts = opts or {}
	if not S.alive(f) then
		return 0
	end
	local flat = Vector3.new(dirUnit.X, opts.allowY and dirUnit.Y or 0, dirUnit.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(f.root.CFrame.LookVector.X, 0, f.root.CFrame.LookVector.Z)
	end
	flat = flat.Unit
	local endPos = S.Hit.clearPath(f.root.Position, flat, dist, 1.3)
	local real = (endPos - f.root.Position).Magnitude
	if real < 0.2 then
		return 0
	end
	if f.isSummon then
		f.root.CFrame = CFrame.new(endPos) * f.root.CFrame.Rotation
		return real
	end
	Fighter.displace(f, flat, real, time, opts.up)
	return real
end

function Fighter.teleport(f, pos, keepFacing)
	if not S.alive(f) then
		return false
	end
	local rot = f.root.CFrame.Rotation
	if f.model.PrimaryPart or f.humanoid then
		f.model:PivotTo(CFrame.new(pos) * (keepFacing ~= false and rot or CFrame.new()))
	else
		f.root.CFrame = CFrame.new(pos) * rot
	end
	return true
end

function Fighter.applyLift(f, height, dur)
	if not S.alive(f) or f.isSummon then
		return
	end
	local att = f.root:FindFirstChild("EBMoveAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "EBMoveAtt"
		att.Parent = f.root
	end
	local old = f.root:FindFirstChild("EBLift")
	if old then
		old:Destroy()
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = "EBLift"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.MaxForce = 1e7
	local riseT = math.min(0.25, dur * 0.5)
	lv.VectorVelocity = Vector3.new(0, height / riseT, 0)
	lv.Parent = f.root
	task.delay(riseT, function()
		if lv.Parent then
			lv.VectorVelocity = Vector3.zero
		end
	end)
	task.delay(dur, function()
		if lv.Parent then
			lv:Destroy()
		end
	end)
end

-- Guard / dodge / basic -------------------------------------------------------------
function Fighter.setGuard(f, on)
	if not on then
		f.guarding = false
		return
	end
	if f.dead or f.noGuard or f.guard <= 0 then
		return
	end
	if not Fighter.canAct(f) then
		return
	end
	if S.Cast and S.Cast.isBusy(f) then
		return
	end
	if f.ultHold then
		S.Cast.abandonHold(f)
	end
	if not f.guarding then
		f.guarding = true
		f.guardStart = S.now()
	end
end

function Fighter.dodge(f, moveDir)
	if f.dead or f.dodgeCharges <= 0 or f.noDodge then
		return false
	end
	local s = f.statuses
	if s.root or s.stun or s.sleep or s.lift or s.guardbreak or s.lock then
		return false
	end
	if f.ultHold then
		S.Cast.abandonHold(f)
		return false
	end
	if S.Cast and S.Cast.isBusy(f) then
		return false
	end
	f.dodgeCharges -= 1
	if f.dodgeRechargeAt <= S.now() then
		f.dodgeRechargeAt = S.now() + Config.DODGE_RECHARGE
	end
	f.guarding = false
	local dir = moveDir
	if not dir or dir.Magnitude < 0.1 then
		dir = f.root.CFrame.LookVector
	end
	local now = S.now()
	task.delay(Config.DODGE_IFRAME_START, function()
		f.iframeUntil = S.now() + Config.DODGE_IFRAME_LEN
	end)
	f.dodgingUntil = now + Config.DODGE_TIME
	Fighter.dash(f, dir, Config.DODGE_DISTANCE * M, Config.DODGE_TIME)
	S.FX.trail(f.root, Color3.fromRGB(220, 220, 255), 0.4)
	S.Combat.hook(f, "dodge", dir)
	S.Combat.extraHooks(f, "dodge", dir)
	return true
end

function Fighter.basic(f)
	if f.dead or not Fighter.canAct(f) then
		return
	end
	if S.Cast and S.Cast.isBusy(f) then
		return
	end
	if f.noBasic then
		return
	end
	local now = S.now()
	local interval = f.basicInterval or Config.BASIC_INTERVAL
	if now - f.lastBasic < interval then
		return
	end
	f.lastBasic = now
	f.guarding = false
	if f.basicOverride then
		S.safe(f.basicOverride, f)
		return
	end
	if f.kit and f.kit.basic then
		S.safe(f.kit.basic, f)
		return
	end
	Fighter.defaultBasic(f, Config.BASIC_DAMAGE, Config.BASIC_RANGE)
end

function Fighter.defaultBasic(f, dmg, rangeM, opts)
	opts = opts or {}
	local look = f.root.CFrame.LookVector
	if f.aim and f.aim.dir then
		look = Vector3.new(f.aim.dir.X, 0, f.aim.dir.Z)
		if look.Magnitude > 0.01 then
			look = look.Unit
			if f.humanoid and not f.isBot then
				f.root.CFrame = CFrame.lookAt(f.root.Position, f.root.Position + look)
			end
		else
			look = f.root.CFrame.LookVector
		end
	end
	local hits = S.Hit.cone(f.root.Position, look, rangeM * M, Config.BASIC_ARC, function(t)
		return t ~= f and S.isEnemy(f, t)
	end, true)
	S.FX.cone(f.root.Position, look, rangeM * M, 70, opts.color or Color3.fromRGB(255, 255, 255), 0.12)
	S.FX.sound(f.root, "swing", 0.3)
	local any = false
	for _, t in ipairs(hits) do
		any = true
		S.Combat.damage(f, t, dmg, { isBasic = true, melee = true, element = f.kitName })
		if opts.onHit then
			opts.onHit(t)
		end
	end
	-- basics also chip constructs in front
	local objs = S.Objects and S.Objects.inRadius(f.root.Position + look * M * 1.5, M * 1.5, function(o)
		return o.owner == nil or S.isEnemy(f, o.owner)
	end) or {}
	for _, o in ipairs(objs) do
		S.Objects.damage(o, dmg, f)
	end
	return any
end

-- Defeat ----------------------------------------------------------------------------
function Fighter.kill(f, src)
	if f.dead then
		return
	end
	f.dead = true
	f.health = 0
	f.guarding = false
	if f.action then
		f.action.interrupted = true
		f.action.interruptReason = "defeat"
	end
	if f.ultHold then
		f.ultHold = nil
	end
	setAttr(f, "Health", 0)
	-- owner-dependent summons vanish
	for _, sm in ipairs(table.clone(f.summons)) do
		if S.Summons then
			S.Summons.remove(sm, "owner defeated")
		end
	end
	if f.kit and f.kit.passive and f.kit.passive.cleanup then
		S.safe(f.kit.passive.cleanup, f)
	end
	if f.humanoid then
		f.humanoid.Health = 0
	end
	local killer = src and (src.owner or src) or f.lastDamager
	S.emit("defeated", f, killer)
end

function Fighter.remove(f)
	S.fighters[f.id] = nil
	S.byModel[f.model] = nil
	f.dead = true
	for _, sm in ipairs(table.clone(f.summons)) do
		if S.Summons then
			S.Summons.remove(sm, "removed")
		end
	end
	if S.Objects then
		S.Objects.removeOwned(f)
	end
	if S.Zones then
		S.Zones.removeOwned(f)
	end
end

-- Per-tick update (called at ~10 Hz) -------------------------------------------------
function Fighter.tick(f, dt, now)
	if f.dead or not f.root or not f.root.Parent then
		return
	end
	local burnout = f.burnoutUntil and f.burnoutUntil > now
	-- energy
	if now - f.lastEnergySpend >= Config.ENERGY_REGEN_DELAY and not f.noEnergyRegen then
		f.energy = math.min(Config.MAX_ENERGY, f.energy + Config.ENERGY_REGEN * dt * (f.energyRegenMult or 1))
	end
	-- heat
	if not f.rupturePending and not burnout and now - f.lastAbilityUse >= Config.HEAT_COOL_DELAY then
		f.heat = math.max(0, f.heat - Config.HEAT_COOL * dt)
	end
	-- burnout end
	if f.burnoutUntil and not burnout and f.burnoutActive then
		f.burnoutActive = false
		f.heat = Config.BURNOUT_END_HEAT
		setAttr(f, "Burnout", 0)
	end
	-- proxima
	if not f.isSummon then
		local best = 0
		local myPos = f.root.Position
		for other, t in pairs(f.contest) do
			if now - t > Config.CONTEST_WINDOW or not S.alive(other) then
				f.contest[other] = nil
			else
				local d = (other.root.Position - myPos).Magnitude / M
				if d <= Config.P_FAR_RANGE and S.Hit.los(myPos, other.root.Position, true) then
					local rate = d <= Config.P_NEAR_RANGE and Config.P_NEAR_RATE or Config.P_FAR_RATE
					if rate > best then
						best = rate
					end
				end
			end
		end
		if best > 0 and not f.rupturePending then
			S.Combat.addProxima(f, best * dt, "proximity")
		end
		if now - f.lastContest > Config.P_DECAY_DELAY and now - (f.lastHit or 0) > Config.P_DECAY_DELAY then
			f.proxima = math.max(0, f.proxima - Config.P_DECAY_RATE * dt)
		end
	end
	-- guard
	if f.guarding then
		f.guard -= Config.GUARD_DRAIN * dt
		if f.guard <= 0 then
			f.guard = 0
			S.Combat.guardBreak(f, nil)
		end
		if not Fighter.canAct(f) then
			f.guarding = false
		end
	elseif now - f.lastGuardHit >= Config.GUARD_RECOVER_DELAY and now - f.lastDirectHit >= Config.GUARD_RECOVER_DELAY then
		if not (f.guardBrokenUntil and f.guardBrokenUntil > now) then
			f.guard = math.min(Config.MAX_GUARD, f.guard + Config.GUARD_RECOVER * dt)
		end
	end
	-- dodge recharge (sequential)
	if f.dodgeCharges < Config.DODGE_CHARGES and now >= f.dodgeRechargeAt and f.dodgeRechargeAt > 0 then
		f.dodgeCharges += 1
		if f.dodgeCharges < Config.DODGE_CHARGES then
			f.dodgeRechargeAt = now + Config.DODGE_RECHARGE
		else
			f.dodgeRechargeAt = 0
		end
	end
	-- shields expiry
	for i = #f.shields, 1, -1 do
		if f.shields[i].expires <= now then
			table.remove(f.shields, i)
		end
	end
	Status.update(f, now)
	-- unstable hold
	if f.ultHold and S.Cast then
		S.Cast.updateHold(f, now)
	end
	-- rupture when idle
	if f.rupturePending and S.Cast and not S.Cast.isBusy(f) and not f.formActive then
		S.Cast.rupture(f)
	end
	-- kit passive tick
	if f.kit and f.kit.passive and f.kit.passive.tick then
		S.safe(f.kit.passive.tick, f, dt, now)
	end
	Fighter.applyMovement(f)
	-- out of bounds / last legal ground
	if f.humanoid and not f.isSummon then
		local pos = f.root.Position
		local bounds = S.arenaBounds
		if bounds then
			local out = pos.Y < bounds.floorY - 30
				or math.abs(pos.X - bounds.center.X) > bounds.half + 80
				or math.abs(pos.Z - bounds.center.Z) > bounds.half + 80
			if out then
				Fighter.outOfBounds(f)
			elseif f.humanoid.FloorMaterial ~= Enum.Material.Air then
				f.legalTimer = (f.legalTimer or 0) + dt
				if f.legalTimer > 0.5 then
					f.legalTimer = 0
					if math.abs(pos.X - bounds.center.X) < bounds.half and math.abs(pos.Z - bounds.center.Z) < bounds.half then
						f.lastLegal = pos
					end
				end
			end
		end
	end
	-- attributes
	setAttr(f, "Energy", math.floor(f.energy + 0.5))
	setAttr(f, "Heat", math.floor(f.heat + 0.5))
	setAttr(f, "Proxima", math.floor(f.proxima))
	setAttr(f, "Guard", math.floor(f.guard + 0.5))
	setAttr(f, "Guarding", f.guarding == true)
	setAttr(f, "Dodge", f.dodgeCharges)
	setAttr(f, "Rupture", f.rupturePending == true)
	setAttr(f, "Shield", math.floor(S.Combat.totalShield(f) + 0.5))
	setAttr(f, "CCImmune", (f.ccImmuneUntil and f.ccImmuneUntil > now) and f.ccImmuneUntil or 0)
	if f.statusDirty then
		f.statusDirty = false
		f.statusText = Status.label(f)
		setAttr(f, "Statuses", f.statusText)
	end
	if f.resDirty then
		f.resDirty = false
		setAttr(f, "KitRes", resString(f))
	end
	updatePlate(f)
end

function Fighter.outOfBounds(f)
	local now = S.now()
	local back = f.lastLegal or (S.arenaBounds and S.arenaBounds.center + Vector3.new(0, 6, 0))
	if f.root:FindFirstChild("EBDisplace") then
		f.root.EBDisplace:Destroy()
	end
	f.root.AssemblyLinearVelocity = Vector3.zero
	Fighter.teleport(f, back + Vector3.new(0, 1, 0))
	if not f.lastOOB or now - f.lastOOB > 8 then
		f.lastOOB = now
		S.Combat.damage(f.lastDamager, f, Config.OOB_PENALTY, { kind = "true", tag = "oob" })
		S.Combat.control(f, "lock", Config.OOB_LOCK, nil, { force = true })
	end
end

function Fighter.forPlayer(player)
	local ch = player.Character
	return ch and S.byModel[ch]
end

Players.PlayerRemoving:Connect(function(p)
	local ch = p.Character
	local f = ch and S.byModel[ch]
	if f then
		Fighter.remove(f)
	end
end)

return Fighter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000073"><Properties><string name="Name">Hit</string><ProtectedString name="Source"><![CDATA[-- Geometry queries against fighter capsules, world line-of-sight and legal placement.
-- All inputs here are in studs.
local S = require(script.Parent.S)

local Hit = {}
S.Hit = Hit

local Config = S.Config

local worldParams = RaycastParams.new()
worldParams.FilterType = Enum.RaycastFilterType.Include
worldParams.FilterDescendantsInstances = { S.folders.Arena, S.folders.Constructs }
worldParams.IgnoreWater = true
Hit.worldParams = worldParams

local arenaParams = RaycastParams.new()
arenaParams.FilterType = Enum.RaycastFilterType.Include
arenaParams.FilterDescendantsInstances = { S.folders.Arena }
arenaParams.IgnoreWater = true
Hit.arenaParams = arenaParams

-- capsule of a fighter: returns bottom point, top point, radius
function Hit.capsule(f)
	local p = f.root.Position
	local sc = f.hitScale or 1
	if f.isSummon then
		local r = (f.radius or 1.2) * sc
		return p - Vector3.new(0, r * 0.5, 0), p + Vector3.new(0, r * 0.5, 0), r
	end
	return p - Vector3.new(0, Config.BODY_DOWN * sc, 0), p + Vector3.new(0, Config.BODY_UP * sc, 0), Config.BODY_RADIUS * sc
end

local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

-- closest distance between segments p1q1 and p2q2; also returns s (param along first)
function Hit.segSeg(p1, q1, p2, q2)
	local d1 = q1 - p1
	local d2 = q2 - p2
	local r = p1 - p2
	local a = d1:Dot(d1)
	local e = d2:Dot(d2)
	local f = d2:Dot(r)
	local s, t
	if a <= 1e-8 and e <= 1e-8 then
		return (p1 - p2).Magnitude, 0
	end
	if a <= 1e-8 then
		s = 0
		t = clamp01(f / e)
	else
		local c = d1:Dot(r)
		if e <= 1e-8 then
			t = 0
			s = clamp01(-c / a)
		else
			local b = d1:Dot(d2)
			local denom = a * e - b * b
			if denom ~= 0 then
				s = clamp01((b * f - c * e) / denom)
			else
				s = 0
			end
			t = (b * s + f) / e
			if t < 0 then
				t = 0
				s = clamp01(-c / a)
			elseif t > 1 then
				t = 1
				s = clamp01((b - c) / a)
			end
		end
	end
	local c1 = p1 + d1 * s
	local c2 = p2 + d2 * t
	return (c1 - c2).Magnitude, s
end

function Hit.pointSeg(p, a, b)
	local ab = b - a
	local denom = ab:Dot(ab)
	local t = 0
	if denom > 1e-8 then
		t = clamp01((p - a):Dot(ab) / denom)
	end
	return (p - (a + ab * t)).Magnitude
end

local function eachCandidate(filter, fn)
	for _, f in pairs(S.fighters) do
		if S.alive(f) and (filter == nil or filter(f)) then
			fn(f)
		end
	end
end
Hit.eachCandidate = eachCandidate

-- swept sphere a->b of radius r; returns list of {f=, s=} sorted along the segment
function Hit.segment(a, b, r, filter)
	local out = {}
	eachCandidate(filter, function(f)
		local ca, cb, cr = Hit.capsule(f)
		local d, s = Hit.segSeg(a, b, ca, cb)
		if d <= r + cr then
			table.insert(out, { f = f, s = s })
		end
	end)
	table.sort(out, function(x, y)
		return x.s < y.s
	end)
	return out
end

function Hit.sphere(center, r, filter)
	local out = {}
	eachCandidate(filter, function(f)
		local ca, cb, cr = Hit.capsule(f)
		if Hit.pointSeg(center, ca, cb) <= r + cr then
			table.insert(out, f)
		end
	end)
	return out
end

-- ground cylinder: horizontal radius r, vertical extent [center.Y - below, center.Y + above]
function Hit.cylinder(center, r, filter, above, below)
	above = above or S.m(4)
	below = below or S.m(2)
	local out = {}
	eachCandidate(filter, function(f)
		local ca, cb, cr = Hit.capsule(f)
		local p = f.root.Position
		local dx = Vector3.new(p.X - center.X, 0, p.Z - center.Z).Magnitude
		if dx <= r + cr * 0.6 and cb.Y >= center.Y - below and ca.Y <= center.Y + above then
			table.insert(out, f)
		end
	end)
	return out
end

-- ring between inner and outer radius
function Hit.ring(center, inner, outer, filter)
	local out = {}
	for _, f in ipairs(Hit.cylinder(center, outer, filter)) do
		local p = f.root.Position
		local dx = Vector3.new(p.X - center.X, 0, p.Z - center.Z).Magnitude
		if dx >= inner - Config.BODY_RADIUS * 0.6 then
			table.insert(out, f)
		end
	end
	return out
end

-- oriented box (cf at centre, size full extents)
function Hit.box(cf, size, filter)
	local out = {}
	local half = size / 2
	eachCandidate(filter, function(f)
		local _, _, cr = Hit.capsule(f)
		local lp = cf:PointToObjectSpace(f.root.Position)
		if math.abs(lp.X) <= half.X + cr and math.abs(lp.Z) <= half.Z + cr and math.abs(lp.Y) <= half.Y + Config.BODY_DOWN then
			table.insert(out, f)
		end
	end)
	return out
end

-- cone: origin, flat dir, length, full angle in degrees; requires line of sight from origin
function Hit.cone(origin, dir, length, angle, filter, needLos)
	local out = {}
	local d = Vector3.new(dir.X, 0, dir.Z)
	if d.Magnitude < 1e-4 then
		return out
	end
	d = d.Unit
	local cosHalf = math.cos(math.rad(angle / 2))
	eachCandidate(filter, function(f)
		local p = f.root.Position
		local v = Vector3.new(p.X - origin.X, 0, p.Z - origin.Z)
		local dist = v.Magnitude
		if dist <= length + Config.BODY_RADIUS and math.abs(p.Y - origin.Y) < S.m(4) then
			if dist < Config.BODY_RADIUS * 1.5 or v.Unit:Dot(d) >= cosHalf then
				if needLos == false or Hit.los(origin, p) then
					table.insert(out, f)
				end
			end
		end
	end)
	return out
end

-- line of sight between two points (world + blocking constructs)
function Hit.los(a, b, ignoreConstructs)
	local dir = b - a
	if dir.Magnitude < 0.05 then
		return true
	end
	local res = workspace:Raycast(a, dir, ignoreConstructs and arenaParams or worldParams)
	return res == nil
end

function Hit.raycast(a, dir, ignoreConstructs)
	return workspace:Raycast(a, dir, ignoreConstructs and arenaParams or worldParams)
end

-- ground below a point (returns position, or nil if over the void)
function Hit.ground(pos, maxDown)
	local res = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -(maxDown or 80), 0), worldParams)
	if res then
		return res.Position, res.Instance
	end
	return nil
end

-- furthest reachable point travelling from `from` along `dir` (unit) for `dist` studs at body height
function Hit.clearPath(from, dir, dist, radius)
	radius = radius or 1.2
	if dist <= 0 then
		return from, nil
	end
	local res = workspace:Spherecast(from, radius, dir * dist, worldParams)
	if res then
		local d = math.max(0, res.Distance - 0.25)
		return from + dir * d, res
	end
	return from + dir * dist, nil
end

-- is a body-sized space free at pos (root height)?
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.FilterDescendantsInstances = { S.folders.Arena, S.folders.Constructs }
function Hit.spaceFree(pos, scale)
	scale = scale or 1
	local parts = workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(2, 4.2, 2) * scale, overlap)
	for _, p in ipairs(parts) do
		if p.CanCollide then
			return false
		end
	end
	return true
end

-- legal standing destination: free space + ground within 12 studs below
function Hit.legal(pos, scale)
	if not Hit.spaceFree(pos, scale) then
		return false
	end
	local g = Hit.ground(pos, 14)
	return g ~= nil
end

-- snap a ground point to stand position (root height above ground)
function Hit.standAt(groundPos)
	return groundPos + Vector3.new(0, Config.BODY_DOWN + 0.4, 0)
end

-- find a legal stand position near `pos`, searching outward
function Hit.findLegal(pos, scale)
	local g = Hit.ground(pos + Vector3.new(0, 6, 0), 40)
	if g then
		local st = Hit.standAt(g)
		if Hit.spaceFree(st, scale) then
			return st
		end
	end
	for r = 2, 12, 2 do
		for i = 0, 7 do
			local a = i * math.pi / 4
			local p = pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			local gg = Hit.ground(p + Vector3.new(0, 6, 0), 40)
			if gg then
				local st = Hit.standAt(gg)
				if Hit.spaceFree(st, scale) then
					return st
				end
			end
		end
	end
	return nil
end

return Hit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000074"><Properties><string name="Name">K</string><ProtectedString name="Source"><![CDATA[-- Kit API: concise, metre-based helpers used by every power in Kits/.
-- `c` is a cast context (from Cast) or, where noted, a fighter.
local RunService = game:GetService("RunService")
local S = require(script.Parent.S)
local Combat = require(script.Parent.Combat)
local Status = require(script.Parent.Status)
local Hit = require(script.Parent.Hit)
local FX = require(script.Parent.FX)

local K = {}
S.K = K

local Config = S.Config
local M = Config.METRE
K.M = M
K.S = S
K.FX = FX
K.Status = Status
K.Combat = Combat
K.Hit = Hit
K.Config = Config

local function F(c)
	if c == nil then
		return nil
	end
	if c.f then
		return c.f
	end
	return c
end
K.F = F

function K.m(x)
	return x * M
end
function K.now()
	return S.now()
end
function K.alive(f)
	return S.alive(f)
end
function K.isEnemy(a, b)
	return S.isEnemy(F(a), F(b))
end
function K.isAlly(a, b)
	return S.isAlly(F(a), F(b))
end
function K.isReal(f)
	return S.isReal(f)
end
function K.synergy()
	return S.synergy == true
end
function K.color(c)
	return S.Util.color(F(c).kitName)
end
function K.pos(x)
	if typeof(x) == "Vector3" then
		return x
	end
	return F(x).root.Position
end
-- distance in metres between fighters/points
function K.dist(a, b)
	return (K.pos(a) - K.pos(b)).Magnitude / M
end
function K.flatDist(a, b)
	local d = K.pos(a) - K.pos(b)
	return Vector3.new(d.X, 0, d.Z).Magnitude / M
end
function K.flat(v)
	return S.Util.flat(v)
end
function K.rotate(v, deg)
	return S.Util.rotateY(v, deg)
end
function K.ground(pos)
	return Hit.ground(pos + Vector3.new(0, 4, 0), 60) or pos
end
function K.feet(f)
	f = F(f)
	return Hit.ground(f.root.Position) or (f.root.Position - Vector3.new(0, Config.BODY_DOWN, 0))
end
function K.forward(c, distM)
	local f = F(c)
	local d = c.dir and c:dir() or K.flat(f.root.CFrame.LookVector)
	return K.ground(f.root.Position + d * distM * M)
end
function K.los(a, b)
	return Hit.los(K.pos(a), K.pos(b))
end
function K.after(t, fn, ...)
	local args = table.pack(...)
	return task.delay(t, function()
		S.safe(fn, table.unpack(args, 1, args.n))
	end)
end
function K.spawn(fn, ...)
	return task.spawn(function(...)
		S.safe(fn, ...)
	end, ...)
end
-- run fn(i, elapsed) every interval for duration (non-blocking). fn returns false to stop.
function K.every(interval, duration, fn)
	return task.spawn(function()
		local start = S.now()
		local i = 0
		while S.now() - start < duration do
			task.wait(interval)
			i += 1
			local ok, r = pcall(fn, i, S.now() - start)
			if not ok then
				warn("[EB] every: " .. tostring(r))
				break
			end
			if r == false then
				break
			end
		end
	end)
end

-- filters ---------------------------------------------------------------------------------
function K.enemyFilter(c, opts)
	local f = F(c)
	opts = opts or {}
	return function(t)
		if t == f or not S.isEnemy(f, t) then
			return false
		end
		if opts.noSummons and t.isSummon then
			return false
		end
		if opts.exclude and opts.exclude[t] then
			return false
		end
		return true
	end
end
function K.allyFilter(c, includeSelf, opts)
	local f = F(c)
	opts = opts or {}
	return function(t)
		if t == f then
			return includeSelf == true
		end
		if t.isSummon and not opts.summons then
			return false
		end
		return S.isAlly(f, t)
	end
end

-- queries (metres) --------------------------------------------------------------------------
function K.enemiesIn(c, pos, rM, opts)
	opts = opts or {}
	local filter = K.enemyFilter(c, opts)
	local list
	if opts.sphere then
		list = Hit.sphere(pos, rM * M, filter)
	else
		list = Hit.cylinder(pos, rM * M, filter, opts.above and opts.above * M, opts.below and opts.below * M)
	end
	if opts.los then
		local out = {}
		for _, t in ipairs(list) do
			if Hit.los(pos + Vector3.new(0, 2, 0), t.root.Position) then
				table.insert(out, t)
			end
		end
		return out
	end
	return list
end
function K.alliesIn(c, pos, rM, includeSelf, opts)
	return Hit.cylinder(pos, rM * M, K.allyFilter(c, includeSelf, opts))
end
function K.enemiesRing(c, pos, innerM, outerM)
	return Hit.ring(pos, innerM * M, outerM * M, K.enemyFilter(c))
end
function K.enemiesCone(c, rangeM, angle, origin, dir, needLos)
	local f = F(c)
	origin = origin or f.root.Position
	dir = dir or (c.dir and c:dir()) or f.root.CFrame.LookVector
	return Hit.cone(origin, dir, rangeM * M, angle, K.enemyFilter(c), needLos)
end
-- oriented box from origin along dir
function K.enemiesLine(c, origin, dir, lengthM, widthM, heightM)
	local d = K.flat(dir)
	local mid = origin + d * lengthM * M / 2
	local cf = CFrame.lookAt(mid, mid + d)
	return Hit.box(cf, Vector3.new(widthM * M, (heightM or 4) * M, lengthM * M), K.enemyFilter(c))
end
function K.nearestEnemy(c, rangeM, pos, needLos)
	local f = F(c)
	pos = pos or f.root.Position
	local best, bd
	for _, t in pairs(S.fighters) do
		if S.alive(t) and t ~= f and S.isEnemy(f, t) and t.untargetable <= 0 then
			local d = (t.root.Position - pos).Magnitude
			if d <= rangeM * M and (not bd or d < bd) and (needLos == false or Hit.los(pos + Vector3.new(0, 1, 0), t.root.Position)) then
				best, bd = t, d
			end
		end
	end
	return best
end
function K.enemies(c, rangeM)
	local f = F(c)
	local out = {}
	for _, t in pairs(S.fighters) do
		if S.alive(t) and t ~= f and S.isEnemy(f, t) and (not rangeM or (t.root.Position - f.root.Position).Magnitude <= rangeM * M) then
			table.insert(out, t)
		end
	end
	return out
end

-- damage & support ----------------------------------------------------------------------------
function K.dmg(c, t, amount, opts)
	if not t or not S.alive(t) then
		return 0
	end
	local f = F(c)
	local o = opts and table.clone(opts) or {}
	if c and c.f then
		o.cast = o.cast or c
		o.slot = o.slot or c.slot
		o.isUlt = o.isUlt or c.isUlt
	end
	o.element = o.element or (f and f.kitName)
	if o.fromPos == nil and f and f.root then
		o.fromPos = f.root.Position
	end
	return Combat.damage(f, t, amount, o)
end
-- damage a list; onHit(t) after each
function K.dmgAll(c, list, amount, opts, onHit)
	local n = 0
	for _, t in ipairs(list) do
		local d = K.dmg(c, t, amount, opts)
		if onHit then
			S.safe(onHit, t, d)
		end
		n += 1
	end
	return n
end
function K.heal(c, t, amount, opts)
	return Combat.heal(F(c), t, amount, opts)
end
function K.shield(c, t, amount, dur, name)
	return Combat.shield(t, amount, dur, name or ((F(c).kitName or "") .. "Shield"), F(c))
end
function K.totalShield(t)
	return Combat.totalShield(t)
end
function K.addEnergy(f, n)
	Combat.addEnergy(F(f), n)
end
function K.addHeat(f, n)
	Combat.addHeat(F(f), n)
end
function K.addP(f, n)
	return Combat.addProxima(F(f), n, "kit")
end
function K.reduceCd(f, slot, seconds)
	S.Cast.reduceCooldown(F(f), slot, seconds)
end
function K.setCd(f, slot, seconds)
	S.Cast.setCooldown(F(f), slot, seconds)
end
function K.cdLeft(f, slot)
	return S.Cast.cooldownLeft(F(f), slot)
end

-- statuses & control -------------------------------------------------------------------------
function K.slow(c, t, pct, dur, name)
	return Status.apply(t, name or "Slow", { duration = dur, slow = pct, source = F(c), category = "slow", label = "Slow " .. math.floor(pct * 100) .. "%" })
end
function K.speed(f, pct, dur, name)
	return Status.apply(F(f), name or "Haste", { duration = dur, speed = pct, harmful = false, label = "Speed +" .. math.floor(pct * 100) .. "%" })
end
function K.dr(f, pct, dur, name)
	return Status.apply(F(f), name or "Guarded", { duration = dur, dr = pct, harmful = false, label = (name or "DR") .. " " .. math.floor(pct * 100) .. "%" })
end
function K.vuln(c, t, pct, dur, name)
	return Status.apply(t, name or "Exposed", { duration = dur, vuln = pct, source = F(c), category = "curse", label = (name or "Exposed") .. " +" .. math.floor(pct * 100) .. "%" })
end
function K.dmgBuff(f, pct, dur, name)
	return Status.apply(F(f), name or "Empowered", { duration = dur, dmgBonus = pct, harmful = false })
end
function K.buff(f, name, opts)
	opts = opts or {}
	opts.harmful = false
	return Status.apply(F(f), name, opts)
end
function K.debuff(c, t, name, opts)
	opts = opts or {}
	opts.source = opts.source or F(c)
	return Status.apply(t, name, opts)
end
function K.mark(c, t, name, dur, opts)
	opts = opts or {}
	opts.duration = dur
	opts.source = F(c)
	opts.category = opts.category or "mark"
	local st = Status.apply(t, name, opts)
	if st and not st.data.hl and t.model then
		st.data.hl = FX.highlight(t.model, opts.color or K.color(c), dur, 0.8)
	end
	return st
end
function K.has(t, name)
	return Status.has(t, name)
end
function K.stacks(t, name)
	return Status.stacks(t, name)
end
function K.unmark(t, name)
	local st = Status.get(t, name)
	if st and st.data.hl then
		st.data.hl:Destroy()
	end
	return Status.remove(t, name)
end
function K.dot(c, t, name, total, dur, category, interval)
	return Status.dot(t, name, total, dur, F(c), { category = category or "dot", interval = interval, element = F(c).kitName })
end
function K.burn(c, t, total, dur)
	return Status.dot(t, "Burn", total, dur, F(c), { category = "burn", label = "Burn", element = F(c).kitName })
end
function K.bleed(c, t, total, dur)
	return Status.dot(t, "Bleed", total, dur, F(c), { category = "bleed", label = "Bleed", element = F(c).kitName })
end
function K.cleanse(t, category, n)
	return Status.cleanse(t, category, n)
end
function K.root(c, t, dur)
	return Combat.control(t, "root", dur, F(c))
end
function K.stun(c, t, dur)
	return Combat.control(t, "stun", dur, F(c))
end
function K.sleep(c, t, dur)
	return Combat.control(t, "sleep", dur, F(c))
end
function K.lift(c, t, dur, heightM)
	return Combat.control(t, "lift", dur, F(c), { height = (heightM or 2) * M })
end
function K.silence(c, t, dur)
	return Status.apply(t, "silence", { duration = dur, source = F(c), category = "silence", label = "Silenced" })
end
function K.interrupt(t, reason)
	return Combat.interrupt(t, reason or "interrupt")
end
function K.knock(c, t, fromPos, distM, opts)
	Combat.knockback(t, fromPos, distM * M, F(c), opts)
end
function K.push(c, t, dir, distM, opts)
	Combat.push(t, dir, distM * M, F(c), opts)
end
function K.pull(c, t, toPos, distM, opts)
	Combat.pull(t, toPos, distM * M, F(c), opts)
end
function K.reveal(c, t, dur)
	local st = Status.apply(t, "Revealed", { duration = dur, source = F(c), category = "reveal", label = "Revealed" })
	if st and t.model and not st.data.hl then
		local h = FX.highlight(t.model, Color3.fromRGB(255, 255, 255), dur, 1)
		if h then
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		end
		st.data.hl = h
	end
	return st
end
function K.invuln(f, dur)
	f = F(f)
	f.invulnUntil = math.max(f.invulnUntil or 0, S.now() + dur)
end
function K.untargetable(f, dur)
	f = F(f)
	f.untargetable += 1
	task.delay(dur, function()
		f.untargetable = math.max(0, f.untargetable - 1)
	end)
end
-- partially hide a fighter's body (in-world concealment; never hides warnings)
function K.conceal(f, dur, transparency)
	f = F(f)
	local parts = {}
	for _, p in ipairs(f.model:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			parts[p] = p.Transparency
			p.Transparency = math.max(p.Transparency, transparency or 0.8)
		elseif p:IsA("Decal") then
			parts[p] = p.Transparency
			p.Transparency = 1
		end
	end
	if f.plate then
		f.plate.Enabled = false
	end
	f.concealed = (f.concealed or 0) + 1
	local function restore()
		f.concealed = math.max(0, (f.concealed or 1) - 1)
		if f.concealed > 0 then
			return
		end
		for p, tr in pairs(parts) do
			if p.Parent then
				p.Transparency = tr
			end
		end
		if f.plate then
			f.plate.Enabled = true
		end
	end
	task.delay(dur, restore)
	return restore
end

-- hooks for timed stances. returns remover
function K.hook(f, name, fn, dur)
	local remover = Combat.addHook(F(f), name, fn)
	if dur then
		task.delay(dur, remover)
	end
	return remover
end

-- resources -----------------------------------------------------------------------------------
function K.res(f, key, value, max, order)
	S.Fighter.setRes(F(f), key, value, max, order)
end
function K.clearRes(f, key)
	S.Fighter.clearRes(F(f), key)
end
function K.announce(f, text, color, dur)
	f = F(f)
	FX.text(f.root, text, color or K.color(f), dur or 1.6, 34)
end
function K.notify(f, text)
	S.Cast.notify(F(f), text)
end

-- shapes ----------------------------------------------------------------------------------------
--[[ K.proj(c, opts) metres: speed (m/s), width (m), range (m), origin, dir, dmg, hit(t, p), wall(pos, normal, obj, p),
	finish(pos, reason, p), pierce, lob (true: arcs to aimPoint), target point, homing, color, size (studs) ]]
function K.proj(c, opts)
	opts = opts or {}
	local f = F(c)
	local origin = opts.origin or (c.chest and c:chest()) or f.root.Position
	local dir = opts.dir or (c.dir3 and c:dir3()) or f.root.CFrame.LookVector
	local range = (opts.range or (c.def and c.def.range) or 20)
	local p
	p = S.Proj.fire({
		owner = f,
		cast = c.f and c or nil,
		origin = origin,
		dir = dir,
		speed = (opts.speed or Config.PROJ_SPEED) * M,
		radius = (opts.width or Config.PROJ_WIDTH) * M / 2,
		range = range * M,
		gravity = opts.gravity,
		targetPoint = opts.targetPoint,
		pierce = opts.pierce,
		homing = opts.homing,
		turnRate = opts.turnRate,
		kind = opts.kind or (c.isUlt and "ultimate" or "energy"),
		color = opts.color,
		size = opts.size,
		shape = opts.shape,
		dmg = opts.dmg,
		objDmg = opts.objDmg,
		allies = opts.allies,
		filter = opts.filter,
		lifetime = opts.lifetime,
		ground = opts.ground,
		noObjects = opts.noObjects,
		data = opts.data,
		tags = opts.tags,
		onStep = opts.step,
		onAlly = opts.ally and function(pp, t)
			return opts.ally(t, pp)
		end or nil,
		onHit = function(pp, t)
			if opts.dmg then
				K.dmg(c, t, opts.dmg, { fromPos = pp.pos, projectile = true, guardDmg = opts.guardDmg, cap = opts.cap })
			end
			if opts.hit then
				return opts.hit(t, pp)
			end
			return nil
		end,
		onWall = opts.wall and function(pp, pos, normal, obj)
			return opts.wall(pos, normal, obj, pp)
		end or nil,
		onEnd = opts.finish and function(pp, pos, reason)
			opts.finish(pos, reason, pp)
		end or nil,
	})
	FX.sound(f.root, "shoot", 0.25)
	return p
end

-- arcing throw to a ground point; land(pos) on impact (also fires if it hits a body: hit(t))
function K.lob(c, opts)
	opts = opts or {}
	local target = opts.target or c:aimPoint(opts.range or c.def.range)
	local landed = false
	local o = table.clone(opts)
	o.gravity = (opts.gravityM or 20) * M
	o.targetPoint = target
	o.speed = opts.speed or 18
	local userFinish = opts.finish
	o.finish = function(pos, reason, p)
		if not landed then
			landed = true
			if opts.land then
				opts.land(pos, reason, p)
			end
		end
		if userFinish then
			userFinish(pos, reason, p)
		end
	end
	return K.proj(c, o)
end

-- instant beam. opts: origin, dir (3D), length (m), width (m), dmg, pierce (true = all), hit(t), color, dur
function K.beam(c, opts)
	opts = opts or {}
	local f = F(c)
	local origin = opts.origin or (c.chest and c:chest()) or f.root.Position
	local dir = (opts.dir or (c.dir3 and c:dir3()) or f.root.CFrame.LookVector).Unit
	local len = (opts.length or (c.def and c.def.range) or 20) * M
	local res = opts.throughWalls and nil or Hit.raycast(origin, dir * len, opts.ignoreConstructs)
	local endPos = res and res.Position or (origin + dir * len)
	local width = (opts.width or 0.5) * M
	local hits = Hit.segment(origin, endPos, width / 2, opts.filter or K.enemyFilter(c))
	local struck = {}
	for _, h in ipairs(hits) do
		local t = h.f
		if Combat.isInvulnerable(t) then
			Combat.damage(f, t, 1, { kind = "direct" }) -- registers evade
		else
			table.insert(struck, t)
			if opts.dmg then
				K.dmg(c, t, opts.dmg, { fromPos = origin, beam = true, guardDmg = opts.guardDmg })
			end
			if opts.hit then
				S.safe(opts.hit, t)
			end
			if not opts.pierce then
				endPos = origin + (endPos - origin) * h.s
				break
			end
		end
	end
	if res and opts.objDmg ~= false then
		local obj = S.Objects.fromPart(res.Instance)
		if obj and (opts.dmg or opts.objDmg) then
			S.Objects.damage(obj, opts.objDmg or opts.dmg, f)
		end
		if opts.wall then
			S.safe(opts.wall, res.Position, res.Normal, obj)
		end
	end
	if not opts.noVisual then
		FX.beam(origin, endPos, width, opts.color or K.color(c), opts.dur or 0.25, 0.15)
	end
	return endPos, struck, res
end

-- melee arc in front. opts: range (m), arc (deg), dmg, hit(t), guardDmg, origin, dir
function K.melee(c, opts)
	opts = opts or {}
	local f = F(c)
	local dir = opts.dir or (c.dir and c:dir()) or K.flat(f.root.CFrame.LookVector)
	if c.face then
		c:face(dir)
	end
	local origin = opts.origin or f.root.Position
	local list = Hit.cone(origin, dir, (opts.range or 3) * M, opts.arc or 100, opts.filter or K.enemyFilter(c), true)
	FX.cone(origin, dir, (opts.range or 3) * M, math.min(opts.arc or 100, 160), opts.color or K.color(c), 0.15)
	FX.sound(f.root, "swing", 0.35)
	local hits = {}
	for _, t in ipairs(list) do
		if opts.dmg then
			K.dmg(c, t, opts.dmg, { melee = true, guardDmg = opts.guardDmg, fromPos = origin })
		end
		if opts.hit then
			S.safe(opts.hit, t)
		end
		table.insert(hits, t)
	end
	if opts.objDmg ~= false then
		for _, o in ipairs(S.Objects.inRadius(origin + dir * (opts.range or 3) * M * 0.6, (opts.range or 3) * M * 0.6, function(o)
			return o.owner == nil or S.isEnemy(f, o.owner)
		end)) do
			S.Objects.damage(o, opts.objDmg or opts.dmg or 40, f)
		end
	end
	if #hits == 0 then
		S.emit("meleeWhiff", f, origin, dir, (opts.range or 3) * M)
	end
	return hits
end

-- cone blast. opts: range, angle, dmg, hit(t), origin, dir, needLos
function K.cone(c, opts)
	opts = opts or {}
	local f = F(c)
	local dir = opts.dir or (c.dir and c:dir()) or K.flat(f.root.CFrame.LookVector)
	local origin = opts.origin or f.root.Position
	local list = Hit.cone(origin, dir, (opts.range or 6) * M, opts.angle or 60, opts.filter or K.enemyFilter(c), opts.needLos ~= false)
	FX.cone(origin, dir, (opts.range or 6) * M, opts.angle or 60, opts.color or K.color(c), 0.25)
	for _, t in ipairs(list) do
		if opts.dmg then
			K.dmg(c, t, opts.dmg, { fromPos = origin, guardDmg = opts.guardDmg })
		end
		if opts.hit then
			S.safe(opts.hit, t)
		end
	end
	return list
end

-- instant circle. opts: dmg, hit(t), allies (bool -> ally list instead), includeSelf, fx (false), sphere, objDmg
function K.circle(c, pos, rM, opts)
	opts = opts or {}
	local list
	if opts.allies then
		list = K.alliesIn(c, pos, rM, opts.includeSelf)
	elseif opts.everyone then
		list = Hit.cylinder(pos, rM * M, function(t)
			return opts.includeSelf or t ~= F(c)
		end)
	else
		list = K.enemiesIn(c, pos, rM, { sphere = opts.sphere, los = opts.los, noSummons = opts.noSummons })
	end
	if opts.fx ~= false then
		FX.burst(pos + Vector3.new(0, 1, 0), rM * M, opts.color or K.color(c), 0.35)
	end
	for _, t in ipairs(list) do
		if opts.dmg then
			K.dmg(c, t, opts.dmg, { fromPos = pos, guardDmg = opts.guardDmg, kind = opts.kind })
		end
		if opts.hit then
			S.safe(opts.hit, t)
		end
	end
	if opts.objDmg then
		for _, o in ipairs(S.Objects.inRadius(pos, rM * M, function(o)
			return o.owner == nil or o.owner == F(c) and opts.selfObjects or S.isEnemy(F(c), o.owner)
		end)) do
			S.Objects.damage(o, opts.objDmg, F(c))
		end
	end
	return list
end

-- instant rectangle from origin along dir. opts like circle
function K.line(c, origin, dir, lengthM, widthM, opts)
	opts = opts or {}
	local list = K.enemiesLine(c, origin, dir, lengthM, widthM, opts.height)
	if opts.fx ~= false then
		local d = K.flat(dir)
		local mid = K.ground(origin) + d * lengthM * M / 2 + Vector3.new(0, 0.3, 0)
		FX.rect(CFrame.lookAt(mid, mid + d), widthM * M, lengthM * M, 0.3, opts.color or K.color(c), 0.3)
	end
	for _, t in ipairs(list) do
		if opts.dmg then
			K.dmg(c, t, opts.dmg, { fromPos = origin, guardDmg = opts.guardDmg })
		end
		if opts.hit then
			S.safe(opts.hit, t)
		end
	end
	return list
end

function K.ringHit(c, pos, innerM, outerM, opts)
	opts = opts or {}
	local list = K.enemiesRing(c, pos, innerM, outerM)
	if opts.fx ~= false then
		FX.ring(pos, outerM * M, opts.color or K.color(c), 0.4, math.max(0.4, (outerM - innerM) * M))
	end
	for _, t in ipairs(list) do
		if opts.dmg then
			K.dmg(c, t, opts.dmg, { fromPos = pos })
		end
		if opts.hit then
			S.safe(opts.hit, t)
		end
	end
	return list
end

-- telegraphs -----------------------------------------------------------------------------------
function K.telegraph(c, pos, rM, t, color)
	return FX.telegraph(pos, rM * M, t, color or K.color(c))
end
function K.telegraphLine(c, origin, dir, lengthM, widthM, t, color)
	return FX.lineTelegraph(K.ground(origin) + Vector3.new(0, 0.2, 0), dir, lengthM * M, widthM * M, t, color or K.color(c))
end
-- blocking warning; returns true if the cast is still valid
function K.warn(c, pos, rM, t, color)
	K.telegraph(c, pos, rM, t, color)
	return c:wait(t)
end
-- independent delayed effect: telegraph now, fn(pos) after t
function K.delayed(c, pos, rM, t, fn, color)
	K.telegraph(c, pos, rM, t, color)
	return task.delay(t, function()
		S.safe(fn, pos)
	end)
end

-- zones (metres) --------------------------------------------------------------------------------
--[[ opts: pos, radius, shape, width, length, dir, inner, duration, tick, immediate, targets, dmg (per tick, kind "field"),
	heal (per tick to allies), slow = {pct, dur}, tickFn(z, list), enter(z, t, first), exit(z, t), finish(z, reason),
	follow, above, color, transparency, tags, data, includeOwner, cap (per target total) ]]
function K.zone(c, opts)
	local f = F(c)
	local capTotals = {}
	local z = S.Zones.create({
		owner = f,
		cast = c.f and c or nil,
		pos = opts.pos or K.feet(f),
		radius = (opts.radius or 3) * M,
		shape = opts.shape,
		width = opts.width and opts.width * M,
		length = opts.length and opts.length * M,
		dir = opts.dir,
		inner = opts.inner and opts.inner * M,
		duration = opts.duration,
		tick = opts.tick,
		immediate = opts.immediate,
		targets = opts.targets or (opts.heal and "allies" or "enemies"),
		color = opts.color or K.color(f),
		transparency = opts.transparency,
		above = opts.above and opts.above * M,
		follow = opts.follow,
		tags = opts.tags,
		data = opts.data,
		element = opts.element,
		includeOwner = opts.includeOwner,
		noVisual = opts.noVisual,
		onTick = function(z, list)
			for _, t in ipairs(list) do
				if opts.dmg and S.isEnemy(f, t) or (opts.dmg and opts.includeOwner and t == f) then
					local amt = opts.dmg
					if opts.cap then
						local done = capTotals[t] or 0
						amt = math.min(amt, opts.cap - done)
						capTotals[t] = done + math.max(0, amt)
					end
					if amt > 0 then
						Combat.damage(f, t, amt, { kind = opts.kind or "field", element = f.kitName, fromPos = z.pos, slot = c.slot, isUlt = c.isUlt })
					end
				end
				if opts.heal and S.isAlly(f, t) then
					Combat.heal(f, t, opts.heal)
				end
				if opts.slow and (S.isEnemy(f, t)) then
					K.slow(f, t, opts.slow[1], opts.slow[2] or 1.2, opts.slowName)
				end
			end
			if opts.tickFn then
				opts.tickFn(z, list)
			end
		end,
		onEnter = opts.enter,
		onExit = opts.exit,
		onEnd = opts.finish,
	})
	return z
end

function K.zonesNear(pos, rM, element, filter)
	return S.Zones.near(pos, rM * M, function(z)
		return (element == nil or z.element == element) and (filter == nil or filter(z))
	end)
end
function K.ownedZones(f, tag)
	return S.Zones.owned(F(f), tag)
end

-- objects (metres) ------------------------------------------------------------------------------
-- wall perpendicular to `dir`, centred on ground point pos. opts: width, height, thick, hp, duration, color...
function K.wall(c, opts)
	local f = F(c)
	local dir = K.flat(opts.dir or (c.dir and c:dir()) or f.root.CFrame.LookVector)
	local pos = opts.pos or K.forward(c, 3)
	local w, h, th = (opts.width or 4) * M, (opts.height or 2.5) * M, (opts.thick or 0.5) * M
	local cf = CFrame.lookAt(pos + Vector3.new(0, h / 2, 0), pos + Vector3.new(0, h / 2, 0) + dir)
	local o = table.clone(opts)
	o.owner = f
	o.cf = cf
	o.size = Vector3.new(w, h, th)
	o.color = opts.color or K.color(f)
	o.material = opts.material or Enum.Material.Glass
	o.transparency = opts.transparency or 0.25
	o.isUlt = opts.isUlt or (c.isUlt == true)
	return S.Objects.create(o)
end
-- generic construct: pos (ground point), size (metres Vector3 or number), shape
function K.object(c, opts)
	local f = F(c)
	local size = opts.size or 1.5
	if type(size) == "number" then
		size = Vector3.new(size, size, size)
	end
	size = size * M
	local pos = opts.pos or K.feet(f)
	local o = table.clone(opts)
	o.owner = opts.neutral and nil or f
	o.cf = opts.cf or CFrame.new(pos + Vector3.new(0, size.Y / 2, 0))
	o.size = size
	o.color = opts.color or K.color(f)
	o.material = opts.material or Enum.Material.SmoothPlastic
	o.isUlt = opts.isUlt or (c.isUlt == true)
	return S.Objects.create(o)
end
function K.objects(c, pos, rM, filter)
	return S.Objects.inRadius(pos, rM * M, filter)
end
function K.enemyObjects(c, pos, rM)
	local f = F(c)
	return S.Objects.inRadius(pos, rM * M, function(o)
		return o.owner == nil or S.isEnemy(f, o.owner)
	end)
end
function K.owned(f, name)
	return S.Objects.owned(F(f), name)
end
function K.objDmg(c, o, amount)
	return S.Objects.damage(o, amount, F(c))
end
function K.objAt(o)
	return o.part and o.part.Position
end

-- summons (metres) -------------------------------------------------------------------------------
function K.summon(c, opts)
	local f = F(c)
	local o = table.clone(opts)
	o.owner = f
	if opts.size and type(opts.size) == "number" then
		o.size = Vector3.one * opts.size * M
	elseif opts.size then
		o.size = opts.size * M
	end
	o.pos = opts.pos or (f.root.Position + K.flat(f.root.CFrame.RightVector) * 3)
	return S.Summons.create(o)
end
function K.summons(f, name)
	return S.Summons.owned(F(f), name)
end

-- projectiles in area (for interception/reflection)
function K.projNear(pos, rM, filter)
	return S.Proj.inRadius(pos, rM * M, filter)
end
function K.enemyProj(c, pos, rM)
	local f = F(c)
	return S.Proj.inRadius(pos, rM * M, function(p)
		return p.owner and S.isEnemy(f, p.owner)
	end)
end

-- movement ----------------------------------------------------------------------------------------
-- blocking dash. opts: onPass(t) once per target, passWidth (m), up
function K.dash(c, dir, distM, time, opts)
	opts = opts or {}
	local f = F(c)
	time = time or math.max(0.12, distM / 25)
	local start = f.root.Position
	local real = S.Fighter.dash(f, dir, distM * M, time, { up = opts.up, allowY = opts.allowY })
	if c.recovery == nil and c.f then
		c.recovery = Config.MOVE_RECOVERY
	end
	local passed = {}
	local t0 = S.now()
	local last = start
	while S.now() - t0 < time do
		task.wait(0.03)
		if not S.alive(f) then
			break
		end
		local now = f.root.Position
		if opts.onPass then
			for _, h in ipairs(Hit.segment(last, now, (opts.passWidth or 1) * M / 2, K.enemyFilter(c))) do
				if not passed[h.f] then
					passed[h.f] = true
					S.safe(opts.onPass, h.f)
				end
			end
		end
		last = now
		if opts.stopOnHit and next(passed) then
			local lv = f.root:FindFirstChild("EBDisplace")
			if lv then
				lv:Destroy()
			end
			break
		end
	end
	return real / M, passed
end
-- teleport to pos if legal (pos is ground or stand point). Returns true on success.
function K.blink(c, pos, opts)
	opts = opts or {}
	local f = F(c)
	local stand = Hit.findLegal(pos, f.hitScale)
	if not stand then
		return false
	end
	if not opts.throughWalls and not Hit.los(f.root.Position, stand + Vector3.new(0, 1, 0), true) then
		-- short combat teleports do not cross sealed walls
		local dir = (stand - f.root.Position)
		local p = Hit.clearPath(f.root.Position, dir.Unit, dir.Magnitude, 1)
		stand = Hit.findLegal(p, f.hitScale)
		if not stand then
			return false
		end
	end
	FX.burst(f.root.Position, 3, K.color(f), 0.25)
	S.Fighter.teleport(f, stand)
	FX.burst(stand, 3, K.color(f), 0.25)
	if c.recovery == nil and c.f then
		c.recovery = Config.MOVE_RECOVERY
	end
	return true
end
-- follow an arbitrary path: pathFn(alpha 0..1) -> world position. Blocking.
function K.path(c, pathFn, time)
	local f = F(c)
	if not S.alive(f) then
		return
	end
	if f.isSummon or not f.humanoid then
		local t0 = S.now()
		while S.now() - t0 < time do
			task.wait()
			local a = math.min(1, (S.now() - t0) / time)
			f.root.CFrame = CFrame.new(pathFn(a)) * f.root.CFrame.Rotation
		end
		return
	end
	local att = f.root:FindFirstChild("EBMoveAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "EBMoveAtt"
		att.Parent = f.root
	end
	local old = f.root:FindFirstChild("EBDisplace")
	if old then
		old:Destroy()
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = "EBDisplace"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.MaxForce = 1e7
	lv.Parent = f.root
	local t0 = S.now()
	while S.now() - t0 < time and lv.Parent and S.alive(f) do
		local dt = RunService.Heartbeat:Wait()
		local a = math.min(1, (S.now() - t0 + dt) / time)
		local want = pathFn(a)
		local v = (want - f.root.Position) / math.max(dt, 1 / 60)
		if v.Magnitude > 300 then
			v = v.Unit * 300
		end
		lv.VectorVelocity = v
	end
	if lv.Parent then
		lv:Destroy()
	end
	f.root.AssemblyLinearVelocity = Vector3.zero
	if c.recovery == nil and c.f then
		c.recovery = Config.MOVE_RECOVERY
	end
end
-- arcing leap to ground point; returns landing position
function K.leap(c, target, time, heightM)
	local f = F(c)
	local start = f.root.Position
	local stand = Hit.standAt(target)
	local dir = stand - start
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude > 0.1 then
		local clear = Hit.clearPath(start + Vector3.new(0, 2, 0), flat.Unit, flat.Magnitude, 1.2)
		stand = Vector3.new(clear.X, stand.Y, clear.Z)
	end
	local h = (heightM or 2.5) * M
	K.path(c, function(a)
		local p = start:Lerp(stand, a)
		return p + Vector3.new(0, math.sin(a * math.pi) * h, 0)
	end, time or 0.5)
	return K.feet(f)
end

function K.face(c, dir)
	if c.face then
		c:face(dir)
	end
end

-- synergy helpers ----------------------------------------------------------------------------------
function K.partner(c, element, rM, pos)
	if not S.synergy then
		return nil
	end
	local f = F(c)
	pos = pos or f.root.Position
	for _, t in pairs(S.fighters) do
		if S.alive(t) and t ~= f and not t.isSummon and t.kitName == element and S.isAlly(f, t) then
			if not rM or (t.root.Position - pos).Magnitude <= rM * M then
				return t
			end
		end
	end
	return nil
end

-- spawn a visual-only decoy body copy of a fighter at pos (cosmetic, for illusions/clones)
function K.decoyModel(f, cf, color)
	f = F(f)
	local m = Instance.new("Model")
	m.Name = "Decoy"
	for _, p in ipairs(f.model:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			local q = p:Clone()
			for _, ch in ipairs(q:GetChildren()) do
				if not ch:IsA("SpecialMesh") and not ch:IsA("Decal") then
					ch:Destroy()
				end
			end
			q.Anchored = true
			q.CanCollide = false
			q.CanQuery = false
			q.CanTouch = false
			if color then
				q.Color = color
			end
			q.CFrame = cf * f.root.CFrame:ToObjectSpace(p.CFrame)
			q.Parent = m
		end
	end
	m.Parent = S.folders.FX
	return m
end

-- copy-safe access to another kit's move (used by Copy/Mystery style kits)
function K.kitMove(kitName, slot)
	local kit = S.Kits.get(kitName)
	return kit and kit[slot], S.Kits.data(kitName)
end

return K
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000075"><Properties><string name="Name">Match</string><ProtectedString name="Source"><![CDATA[-- Match flow: players, kit selection, respawns, kill feed, leaderstats, teams, bots and dummies.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local S = require(script.Parent.S)
local Fighter = require(script.Parent.Fighter)

local Match = {}
S.Match = Match

local Config = S.Config
local remotes

Match.botTarget = 0
Match.teamsOn = false
Match.dummies = {}

local function setWorldAttrs()
	workspace:SetAttribute("Synergy", S.synergy == true)
	workspace:SetAttribute("Teams", Match.teamsOn)
	workspace:SetAttribute("BotCount", Match.botTarget)
end

local function ensureTeams()
	local sun = Teams:FindFirstChild("Sun")
	if not sun then
		sun = Instance.new("Team")
		sun.Name = "Sun"
		sun.TeamColor = BrickColor.new("Bright orange")
		sun.AutoAssignable = false
		sun.Parent = Teams
	end
	local moon = Teams:FindFirstChild("Moon")
	if not moon then
		moon = Instance.new("Team")
		moon.Name = "Moon"
		moon.TeamColor = BrickColor.new("Bright blue")
		moon.AutoAssignable = false
		moon.Parent = Teams
	end
	return sun, moon
end

local function teamCounts()
	local sun, moon = 0, 0
	for _, f in pairs(S.fighters) do
		if not f.isSummon and not f.isDummy then
			if f.team == "Sun" then
				sun += 1
			elseif f.team == "Moon" then
				moon += 1
			end
		end
	end
	return sun, moon
end

local function pickTeam()
	if not Match.teamsOn then
		return nil
	end
	local s, m = teamCounts()
	return s <= m and "Sun" or "Moon"
end

local function leaderstats(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local k = Instance.new("IntValue")
	k.Name = "Kills"
	k.Parent = ls
	local d = Instance.new("IntValue")
	d.Name = "Deaths"
	d.Parent = ls
	ls.Parent = player
end

local function feed(text)
	if remotes then
		remotes.Feed:FireAllClients(text)
	end
end
Match.feed = feed

-- Players ------------------------------------------------------------------------------------
local function onCharacter(player, char)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	if not root or not hum then
		return
	end
	task.wait()
	local spawnPos = S.Arena.randomSpawn()
	char:PivotTo(CFrame.new(spawnPos, Vector3.new(0, spawnPos.Y, 0)))
	local kit = player:GetAttribute("Kit") or Config.DEFAULT_KIT
	local team = Match.teamsOn and player.Team and player.Team.Name or nil
	local f = Fighter.new(char, { player = player, kit = kit, team = team, name = player.DisplayName })
	f.invulnUntil = S.now() + Config.SPAWN_PROTECTION
	S.FX.highlight(char, Color3.fromRGB(255, 255, 255), Config.SPAWN_PROTECTION, 0.85)
	hum.Died:Connect(function()
		if not f.dead then
			Fighter.kill(f, f.lastDamager)
		end
	end)
end

local function loadCharacter(player)
	if player.Parent then
		player:LoadCharacter()
	end
end

function Match.onPlayerAdded(player)
	leaderstats(player)
	pcall(function()
		player.DevEnableMouseLock = false -- LeftShift is dodge; the HUD provides its own aim lock (Z)
	end)
	player:SetAttribute("Kit", player:GetAttribute("Kit") or Config.DEFAULT_KIT)
	if Match.teamsOn then
		local sun, moon = ensureTeams()
		local s, m = teamCounts()
		player.Team = s <= m and sun or moon
	end
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	task.defer(loadCharacter, player)
end

-- Kit selection: swaps immediately when out of combat, otherwise on respawn.
function Match.selectKit(player, name)
	local display = S.Kits.displayName(name)
	if not display then
		return
	end
	player:SetAttribute("Kit", display)
	local f = Fighter.forPlayer(player)
	if not f or f.dead then
		return
	end
	local now = S.now()
	local inCombat = now - (f.lastContest or 0) < 5 or now - (f.lastHit or 0) < 5
	if inCombat or S.Cast.isBusy(f) or f.formActive then
		S.Cast.notify(f, display .. " equips on respawn (in combat)")
		return
	end
	S.Objects.removeOwned(f)
	S.Zones.removeOwned(f)
	for _, sm in ipairs(table.clone(f.summons)) do
		S.Summons.remove(sm, "kit swap")
	end
	for name2 in pairs(f.statuses) do
		S.Status.remove(f, name2, "kit swap")
	end
	f.shields = {}
	f.proxima = 0
	f.heat = 0
	f.energy = Config.MAX_ENERGY
	f.speedMult, f.jumpMult, f.hitScale = 1, 1, 1
	f.noGuard, f.noDodge, f.noBasic, f.basicOverride, f.disabled = nil, nil, nil, nil, nil
	Fighter.setKit(f, display)
	for slot = 1, 5 do
		f.model:SetAttribute("CD" .. slot, 0)
		f.model:SetAttribute("RC" .. slot, 0)
	end
	S.Cast.notify(f, "Equipped " .. display)
end

-- Defeat / respawn -------------------------------------------------------------------------------
local function credit(victim, killer)
	if victim.player then
		local ls = victim.player:FindFirstChild("leaderstats")
		if ls then
			ls.Deaths.Value += 1
		end
	end
	if killer and killer ~= victim and killer.player then
		local ls = killer.player:FindFirstChild("leaderstats")
		if ls then
			ls.Kills.Value += 1
		end
	end
	if not victim.isSummon then
		local kname = killer and killer ~= victim and (killer.name .. " [" .. tostring(killer.kitName) .. "]") or "the arena"
		feed(kname .. "  defeated  " .. victim.name .. " [" .. tostring(victim.kitName) .. "]")
	end
end

S.on("defeated", function(f, killer)
	if f.isSummon then
		return
	end
	credit(f, killer)
	if f.player then
		local player = f.player
		task.delay(Config.RESPAWN_TIME, function()
			Fighter.remove(f)
			if player.Parent then
				if Match.teamsOn and not player.Team then
					local sun, moon = ensureTeams()
					local s, m = teamCounts()
					player.Team = s <= m and sun or moon
				end
				loadCharacter(player)
			end
		end)
	elseif f.isBot then
		task.delay(Config.RESPAWN_TIME, function()
			Fighter.remove(f)
			if f.model then
				f.model:Destroy()
			end
			Match.syncBots()
		end)
	elseif f.isDummy then
		task.delay(3, function()
			Fighter.remove(f)
			if f.model then
				f.model:Destroy()
			end
			Match.spawnDummy(f.dummyIndex)
		end)
	end
end)

-- Rigs -----------------------------------------------------------------------------------------------
local function makeRig(name, color)
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = color
	desc.TorsoColor = color
	desc.LeftArmColor = color
	desc.RightArmColor = color
	desc.LeftLegColor = Color3.fromRGB(60, 60, 70)
	desc.RightLegColor = Color3.fromRGB(60, 60, 70)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		-- minimal fallback rig
		model = Instance.new("Model")
		local root = Instance.new("Part")
		root.Name = "HumanoidRootPart"
		root.Size = Vector3.new(2, 2, 1)
		root.Transparency = 1
		root.Parent = model
		local torso = Instance.new("Part")
		torso.Name = "UpperTorso"
		torso.Size = Vector3.new(2, 4.5, 1.2)
		torso.Color = color
		torso.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = torso
		w.Parent = root
		local head = Instance.new("Part")
		head.Name = "Head"
		head.Size = Vector3.new(1.4, 1.4, 1.4)
		head.Color = color
		head.CFrame = CFrame.new(0, 3, 0)
		head.Parent = model
		local w2 = Instance.new("WeldConstraint")
		w2.Part0 = torso
		w2.Part1 = head
		w2.Parent = torso
		local hum = Instance.new("Humanoid")
		hum.HipHeight = 2
		hum.Parent = model
		model.PrimaryPart = root
	end
	model.Name = name
	return model
end

function Match.spawnBot(kitName)
	kitName = kitName or S.Kits.random()
	local model = makeRig("Bot " .. kitName, S.Util.color(kitName))
	local pos = S.Arena.randomSpawn()
	model:PivotTo(CFrame.new(pos))
	model.Parent = S.folders.Bots
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local f = Fighter.new(model, { isBot = true, kit = kitName, team = pickTeam(), name = "Bot " .. kitName })
	f.invulnUntil = S.now() + Config.SPAWN_PROTECTION
	local hum = f.humanoid
	if hum then
		hum.Died:Connect(function()
			if not f.dead then
				Fighter.kill(f, f.lastDamager)
			end
		end)
	end
	return f
end

function Match.botCount()
	local n = 0
	for _, f in pairs(S.fighters) do
		if f.isBot then
			n += 1
		end
	end
	return n
end

function Match.syncBots()
	local n = Match.botCount()
	while n < Match.botTarget do
		Match.spawnBot()
		n += 1
	end
	if n > Match.botTarget then
		for _, f in pairs(S.fighters) do
			if n <= Match.botTarget then
				break
			end
			if f.isBot then
				Fighter.remove(f)
				if f.model then
					f.model:Destroy()
				end
				n -= 1
			end
		end
	end
end

function Match.spawnDummy(i)
	local spot = S.Arena.dummySpots[i]
	if not spot then
		return
	end
	local model = makeRig("Training Dummy " .. i, Color3.fromRGB(200, 170, 110))
	model:PivotTo(CFrame.new(spot + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.pi, 0))
	model.Parent = S.folders.Bots
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local f = Fighter.new(model, { isDummy = true, name = "Training Dummy" })
	f.kitName = "Dummy"
	f.dummyIndex = i
	f.noGuard = true
	Match.dummies[i] = f
	return f
end

-- Dummies reset to full health 4 seconds after their last hit.
task.spawn(function()
	while true do
		task.wait(1)
		local now = S.now()
		for _, f in pairs(Match.dummies) do
			if S.alive(f) and now - (f.lastHit or 0) > 4 and f.health < f.maxHealth then
				f.health = f.maxHealth
				f.shields = {}
				Fighter.syncHealth(f)
			end
		end
	end
end)

-- Settings (casual servers: any player may change them) -----------------------------------------------
function Match.setting(player, key, value)
	if key == "synergy" then
		S.synergy = value == true
		feed("Synergy Mode " .. (S.synergy and "ON" or "OFF") .. " (" .. player.DisplayName .. ")")
	elseif key == "teams" then
		Match.teamsOn = value == true
		local sun, moon = ensureTeams()
		local i = 0
		for _, p in ipairs(Players:GetPlayers()) do
			if Match.teamsOn then
				p.Team = (i % 2 == 0) and sun or moon
				p.Neutral = false
			else
				p.Team = nil
				p.Neutral = true
			end
			i += 1
		end
		for _, f in pairs(S.fighters) do
			if f.player then
				f.team = Match.teamsOn and f.player.Team and f.player.Team.Name or nil
			elseif f.isBot then
				f.team = nil
				if Match.teamsOn then
					f.team = pickTeam()
				end
			end
		end
		feed("Teams " .. (Match.teamsOn and "ON (Sun vs Moon)" or "OFF (free-for-all)"))
	elseif key == "bots" then
		local n = tonumber(value)
		if n then
			Match.botTarget = math.clamp(math.floor(n), 0, Config.MAX_BOTS)
			Match.syncBots()
		end
	elseif key == "botKit" then
		local name = S.Kits.displayName(value)
		if name and Match.botCount() < Config.MAX_BOTS then
			Match.botTarget = math.min(Config.MAX_BOTS, Match.botTarget + 1)
			Match.spawnBot(name)
		end
	end
	setWorldAttrs()
end

function Match.init(r)
	remotes = r
	setWorldAttrs()
	Players.CharacterAutoLoads = false
	pcall(function()
		game:GetService("StarterPlayer").EnableMouseLockOption = false
	end)
	Players.RespawnTime = Config.RESPAWN_TIME
	for _, p in ipairs(Players:GetPlayers()) do
		Match.onPlayerAdded(p)
	end
	Players.PlayerAdded:Connect(Match.onPlayerAdded)
	for i = 1, #S.Arena.dummySpots do
		Match.spawnDummy(i)
	end
end

return Match
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000076"><Properties><string name="Name">Objects</string><ProtectedString name="Source"><![CDATA[-- World objects / constructs with durability, reinforcement layers, lifetimes and owner caps.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local S = require(script.Parent.S)

local Objects = {}
S.Objects = Objects

local Config = S.Config
local list = {} -- [id] = obj
local byPart = {}
local nextId = 0

Objects.list = list

--[[ opts:
	owner (fighter or nil = neutral), name, cf, size (studs), shape ("Block"|"Ball"|"Cylinder"), hp, duration,
	solid (CanCollide, default true), blocks (blocks projectiles / LOS, default = solid), color, material,
	transparency, element, tags (set), onDestroy(obj, src), onExpire(obj), onDamage(obj, amt, src),
	allyPass, noCap (exempt from 8-object cap), isUlt, prop (non-hittable decoration), anchored
]]
function Objects.create(opts)
	nextId += 1
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = opts.solid ~= false
	local blocks = opts.blocks
	if blocks == nil then
		blocks = opts.solid ~= false
	end
	p.CanQuery = blocks or opts.queryable == true
	p.CanTouch = false
	p.Size = opts.size or Vector3.new(4, 4, 4)
	p.CFrame = opts.cf or CFrame.new()
	p.Color = opts.color or Color3.fromRGB(200, 200, 200)
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.Transparency = opts.transparency or 0
	if opts.shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif opts.shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Name = opts.name or "Construct"
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts.allyPass then
		p.CanCollide = false
	end
	local hp = opts.hp or Config.OBJECT_DURABILITY
	local obj = {
		id = nextId,
		owner = opts.owner,
		part = p,
		hp = hp,
		maxHp = hp,
		layers = {},
		element = opts.element or (opts.owner and opts.owner.kitName),
		tags = opts.tags or {},
		name = opts.name or "Construct",
		alive = true,
		blocks = blocks,
		solid = opts.solid ~= false,
		created = S.now(),
		expires = opts.duration and (S.now() + opts.duration) or nil,
		onDestroy = opts.onDestroy,
		onExpire = opts.onExpire,
		onDamage = opts.onDamage,
		allyPass = opts.allyPass,
		isUlt = opts.isUlt,
		data = opts.data or {},
		upgrades = {},
		invulnerable = opts.invulnerable,
	}
	p.Parent = (blocks and not opts.prop) and S.folders.Constructs or S.folders.Props
	list[obj.id] = obj
	byPart[p] = obj
	p:SetAttribute("Durability", math.floor(hp))
	p:SetAttribute("Owner", opts.owner and opts.owner.name or "neutral")
	-- durability label for readability
	if not opts.noLabel then
		local bb = Instance.new("BillboardGui")
		bb.Name = "HP"
		bb.Size = UDim2.fromOffset(70, 16)
		bb.StudsOffset = Vector3.new(0, p.Size.Y / 2 + 0.8, 0)
		bb.MaxDistance = 60
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextStrokeTransparency = 0.3
		t.Text = tostring(math.floor(hp))
		t.Parent = bb
		bb.Parent = p
		obj.label = t
	end
	-- owner cap
	if opts.owner and not opts.noCap and not opts.isUlt then
		local owned = opts.owner.objects
		table.insert(owned, obj)
		local count = 0
		for _, o in ipairs(owned) do
			if o.alive then
				count += 1
			end
		end
		if count > Config.MAX_OBJECTS_PER_CASTER then
			for _, o in ipairs(owned) do
				if o.alive and o ~= obj then
					Objects.remove(o, "replaced")
					break
				end
			end
		end
	elseif opts.owner then
		table.insert(opts.owner.objects, obj)
	end
	return obj
end

local function refreshLabel(obj)
	if obj.label then
		local bonus = 0
		for _, l in ipairs(obj.layers) do
			bonus += l.amount
		end
		obj.label.Text = tostring(math.floor(obj.hp + 0.5)) .. (bonus > 0 and (" +" .. math.floor(bonus)) or "")
	end
	if obj.part then
		obj.part:SetAttribute("Durability", math.floor(obj.hp))
	end
end

function Objects.fromPart(part)
	return part and byPart[part]
end

function Objects.damage(obj, amount, src, opts)
	if not obj or not obj.alive or amount <= 0 or obj.invulnerable then
		return 0
	end
	opts = opts or {}
	local info = { amount = amount, src = src, opts = opts }
	if obj.beforeDamage then
		obj.beforeDamage(obj, info)
		if info.cancel then
			return 0
		end
	end
	amount = info.amount
	-- reinforcement layers absorb first
	while amount > 0 and #obj.layers > 0 do
		local l = obj.layers[#obj.layers]
		if l.amount > amount then
			l.amount -= amount
			amount = 0
		else
			amount -= l.amount
			table.remove(obj.layers)
		end
	end
	obj.hp -= amount
	if obj.onDamage then
		S.safe(obj.onDamage, obj, amount, src)
	end
	refreshLabel(obj)
	if obj.part and amount > 0 then
		S.Combat.pop(obj.part.Position, tostring(math.floor(amount + 0.5)), Color3.fromRGB(200, 200, 200), "object")
	end
	if obj.hp <= 0 then
		Objects.destroy(obj, src)
	end
	return amount
end

function Objects.reinforce(obj, amount, src)
	if not obj.alive then
		return false
	end
	local total = 0
	for _, l in ipairs(obj.layers) do
		total += l.amount
	end
	if #obj.layers >= Config.MAX_REINFORCE_LAYERS then
		return false
	end
	amount = math.min(amount, Config.MAX_REINFORCE - total)
	if amount <= 0 then
		return false
	end
	table.insert(obj.layers, { amount = amount, src = src })
	refreshLabel(obj)
	return true
end

function Objects.stripLayer(obj)
	if obj.alive and #obj.layers > 0 then
		table.remove(obj.layers)
		refreshLabel(obj)
		return true
	end
	return false
end

function Objects.heal(obj, amount)
	if obj.alive then
		obj.hp = math.min(obj.maxHp, obj.hp + amount)
		refreshLabel(obj)
	end
end

function Objects.remove(obj, reason)
	if not obj.alive then
		return
	end
	obj.alive = false
	list[obj.id] = nil
	if obj.part then
		byPart[obj.part] = nil
		local p = obj.part
		p.CanCollide = false
		p.CanQuery = false
		TweenService:Create(p, TweenInfo.new(0.25), { Transparency = 1 }):Play()
		Debris:AddItem(p, 0.3)
	end
	if obj.cleanup then
		S.safe(obj.cleanup, obj, reason)
	end
end

function Objects.destroy(obj, src)
	if not obj.alive then
		return
	end
	local pos = obj.part and obj.part.Position
	Objects.remove(obj, "destroyed")
	if pos then
		S.FX.burst(pos, math.max(2, obj.part.Size.Magnitude / 3), obj.part.Color, 0.3)
	end
	if obj.onDestroy then
		S.safe(obj.onDestroy, obj, src)
	end
	S.emit("objectDestroyed", obj, src)
end

function Objects.inRadius(pos, r, filter)
	local out = {}
	for _, o in pairs(list) do
		if o.alive and o.part then
			local p = o.part
			local half = p.Size.Magnitude / 2
			if (p.Position - pos).Magnitude <= r + half * 0.6 and (filter == nil or filter(o)) then
				table.insert(out, o)
			end
		end
	end
	return out
end

function Objects.owned(f, name)
	local out = {}
	for _, o in ipairs(f.objects) do
		if o.alive and (name == nil or o.name == name) then
			table.insert(out, o)
		end
	end
	return out
end

function Objects.removeOwned(f, name)
	for _, o in ipairs(f.objects) do
		if o.alive and (name == nil or o.name == name) then
			Objects.remove(o, "owner")
		end
	end
	if name == nil then
		table.clear(f.objects)
	end
end

function Objects.update(now)
	for _, o in pairs(list) do
		if o.alive then
			if o.expires and now >= o.expires then
				Objects.remove(o, "expired")
				if o.onExpire then
					S.safe(o.onExpire, o)
				end
			elseif o.allyPass and o.owner and o.part then
				-- ally-pass barriers physically stop enemies by pushing them back out
				local part = o.part
				for _, f in pairs(S.fighters) do
					if S.alive(f) and S.isEnemy(o.owner, f) and not f.isSummon then
						local lp = part.CFrame:PointToObjectSpace(f.root.Position)
						local half = part.Size / 2 + Vector3.new(1.2, 2, 1.2)
						if math.abs(lp.X) < half.X and math.abs(lp.Y) < half.Y and math.abs(lp.Z) < half.Z then
							local out = part.CFrame:VectorToWorldSpace(Vector3.new(0, 0, lp.Z >= 0 and 1 or -1))
							S.Fighter.teleport(f, f.root.Position + out * (half.Z - math.abs(lp.Z) + 0.5))
						end
					end
				end
			end
		end
	end
end

return Objects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000077"><Properties><string name="Name">Proj</string><ProtectedString name="Source"><![CDATA[-- Server-simulated projectiles. Default: 24 m/s, 0.3 m wide, stops on first solid collision.
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local S = require(script.Parent.S)

local Proj = {}
S.Proj = Proj

local Config = S.Config
local M = Config.METRE
local list = {}
local nextId = 0
Proj.list = list

--[[ opts (studs unless noted):
	owner, cast, origin, dir (unit), speed, radius, range, gravity (studs/s^2 downward, for lobs),
	targetPoint (lob: computes arc to land there), pierce (extra targets, or true = infinite),
	onHit(p, target) -> return "continue" to keep flying, onWall(p, pos, normal, obj), onEnd(p, pos, reason),
	onStep(p, dt), filter(f) (who can be hit; default enemies), allies (hit allies too -> onAlly(p, ally)),
	kind ("energy"|"physical"|"ultimate"), color, size (visual), shape ("Ball"|"Block"), element,
	homing (fighter), turnRate (deg/s), objDmg, dmg (used for construct damage default), lifetime,
	reflectable, noObjects (pass through constructs), ground (follows floor), noVisual
]]
function Proj.fire(opts)
	nextId += 1
	local owner = opts.owner
	local dir = opts.dir
	if dir.Magnitude < 1e-4 then
		dir = Vector3.new(0, 0, -1)
	end
	dir = dir.Unit
	local speed = opts.speed or Config.PROJ_SPEED * M
	local p = {
		id = nextId,
		owner = owner,
		cast = opts.cast,
		pos = opts.origin,
		vel = dir * speed,
		speed = speed,
		radius = opts.radius or (Config.PROJ_WIDTH * M / 2),
		range = opts.range or S.m(30),
		traveled = 0,
		gravity = opts.gravity,
		pierce = opts.pierce,
		hits = {},
		hitCount = 0,
		onHit = opts.onHit,
		onAlly = opts.onAlly,
		onWall = opts.onWall,
		onEnd = opts.onEnd,
		onStep = opts.onStep,
		filter = opts.filter,
		allies = opts.allies,
		kind = opts.kind or "energy",
		element = opts.element or (owner and owner.kitName),
		homing = opts.homing,
		turnRate = opts.turnRate or 180,
		objDmg = opts.objDmg,
		dmg = opts.dmg,
		born = S.now(),
		lifetime = opts.lifetime,
		alive = true,
		reflected = false,
		data = opts.data or {},
		noObjects = opts.noObjects,
		ground = opts.ground,
		tags = opts.tags or {},
	}
	if opts.targetPoint and opts.gravity then
		-- solve a lob that lands at targetPoint with the given horizontal speed
		local to = opts.targetPoint - opts.origin
		local flat = Vector3.new(to.X, 0, to.Z)
		local dist = flat.Magnitude
		local t = math.max(0.25, dist / speed)
		local vy = (to.Y + 0.5 * opts.gravity * t * t) / t
		p.vel = (dist > 0.01 and flat.Unit * (dist / t) or Vector3.zero) + Vector3.new(0, vy, 0)
		p.range = math.huge
		p.lifetime = p.lifetime or (t + 2)
	end
	if not opts.noVisual then
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = opts.color or (owner and S.Util.color(owner.kitName)) or Color3.new(1, 1, 1)
		if opts.shape == "Block" then
			part.Size = opts.size or Vector3.new(p.radius * 2, p.radius * 2, math.max(1, p.radius * 4))
		else
			part.Shape = Enum.PartType.Ball
			part.Size = opts.size or Vector3.one * math.max(0.6, p.radius * 2)
		end
		part.Transparency = opts.transparency or 0.1
		part.CFrame = CFrame.lookAt(p.pos, p.pos + p.vel)
		part.Name = "Projectile"
		part.Parent = S.folders.FX
		p.part = part
		S.FX.trail(part, part.Color)
	end
	list[p.id] = p
	return p
end

function Proj.stop(p, reason, pos)
	if not p.alive then
		return
	end
	p.alive = false
	list[p.id] = nil
	if p.part then
		Debris:AddItem(p.part, 0.05)
	end
	if p.onEnd then
		S.safe(p.onEnd, p, pos or p.pos, reason)
	end
end

function Proj.reflect(p, newOwner, newDir)
	if not p.alive or p.reflected then
		return false
	end
	p.reflected = true
	p.owner = newOwner
	p.cast = nil
	p.hits = {}
	p.vel = (newDir or -p.vel).Unit * p.speed
	if p.part then
		p.part.Color = S.Util.color(newOwner.kitName)
	end
	return true
end

function Proj.inRadius(pos, r, filter)
	local out = {}
	for _, p in pairs(list) do
		if p.alive and (p.pos - pos).Magnitude <= r + p.radius and (filter == nil or filter(p)) then
			table.insert(out, p)
		end
	end
	return out
end

local function defaultFilter(p, f)
	if f == p.owner then
		return false
	end
	if p.owner and f.owner == p.owner then
		return false
	end
	return S.isEnemy(p.owner, f)
end

local function step(p, dt)
	if p.lifetime and S.now() - p.born > p.lifetime then
		Proj.stop(p, "lifetime")
		return
	end
	if p.homing and S.alive(p.homing) then
		local to = (p.homing.root.Position - p.pos)
		if to.Magnitude > 0.1 then
			local cur = p.vel.Unit
			local want = to.Unit
			local ang = math.acos(math.clamp(cur:Dot(want), -1, 1))
			local maxAng = math.rad(p.turnRate) * dt
			if ang > 1e-3 then
				local t = math.min(1, maxAng / ang)
				local nd = cur:Lerp(want, t)
				if nd.Magnitude > 1e-3 then
					p.vel = nd.Unit * p.speed
				end
			end
		end
	end
	if p.gravity then
		p.vel -= Vector3.new(0, p.gravity * dt, 0)
	end
	if p.onStep then
		S.safe(p.onStep, p, dt)
		if not p.alive then
			return
		end
	end
	local a = p.pos
	local move = p.vel * dt
	local b = a + move
	if p.ground then
		local g = S.Hit.ground(b + Vector3.new(0, 2, 0), 8)
		if g then
			b = Vector3.new(b.X, g.Y + p.radius + 0.3, b.Z)
			move = b - a
		end
	end
	-- world / constructs
	local wallDist = math.huge
	local wallRes
	if move.Magnitude > 0 then
		local res = workspace:Raycast(a, move, p.noObjects and S.Hit.arenaParams or S.Hit.worldParams)
		if res then
			wallDist = (res.Position - a).Magnitude
			wallRes = res
		end
	end
	-- fighters
	local segEnd = wallRes and wallRes.Position or b
	local candidates = S.Hit.segment(a, segEnd, p.radius, function(f)
		if p.hits[f] then
			return false
		end
		if p.filter then
			return p.filter(f)
		end
		if p.allies and f ~= p.owner and S.isAlly(p.owner, f) and not f.isSummon then
			return true
		end
		return defaultFilter(p, f)
	end)
	for _, c in ipairs(candidates) do
		local f = c.f
		p.hits[f] = true
		if S.Combat.isInvulnerable(f) then
			S.Combat.hook(f, "evaded", p.owner, { projectile = p })
			S.Combat.extraHooks(f, "evaded", p.owner, { projectile = p })
			S.emit("evaded", f, p.owner, { projectile = p })
		else
			local result
			if p.allies and S.isAlly(p.owner, f) and p.onAlly then
				result = p.onAlly(p, f)
			elseif p.onHit then
				local ok, r = pcall(p.onHit, p, f)
				if not ok then
					warn("[EB] projectile onHit: " .. tostring(r))
				end
				result = r
			end
			-- target hooks for projectile interception (mirrors, shields...)
			if p.alive then
				p.hitCount += 1
				local unlimited = p.pierce == true
				if result ~= "continue" and not unlimited and p.hitCount > (p.pierce or 0) then
					p.pos = a + (segEnd - a) * c.s
					Proj.stop(p, "hit", p.pos)
					return
				end
			else
				return
			end
		end
	end
	if wallRes then
		p.pos = wallRes.Position
		local obj = S.Objects.fromPart(wallRes.Instance)
		local result
		if p.onWall then
			result = p.onWall(p, wallRes.Position, wallRes.Normal, obj)
		end
		if obj and result ~= "pass" then
			if not (p.owner and obj.owner and not S.isEnemy(p.owner, obj.owner) and obj.allyPass) then
				S.Objects.damage(obj, p.objDmg or p.dmg or 40, p.owner, { projectile = p })
			end
		end
		if result ~= "pass" and result ~= "continue" then
			Proj.stop(p, "wall", wallRes.Position)
			return
		end
	end
	p.pos = b
	p.traveled += move.Magnitude
	if p.part then
		if p.vel.Magnitude > 0.01 then
			p.part.CFrame = CFrame.lookAt(p.pos, p.pos + p.vel)
		else
			p.part.CFrame = CFrame.new(p.pos)
		end
	end
	if p.traveled >= p.range then
		Proj.stop(p, "range", p.pos)
	end
end

RunService.Heartbeat:Connect(function(dt)
	for _, p in pairs(list) do
		if p.alive then
			local ok, err = pcall(step, p, dt)
			if not ok then
				warn("[EB] projectile error: " .. tostring(err))
				Proj.stop(p, "error")
			end
		end
	end
end)

return Proj
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000078"><Properties><string name="Name">S</string><ProtectedString name="Source"><![CDATA[-- Shared server state + late-bound module registry (avoids require cycles).
-- Every core module registers itself here: S.Combat, S.Status, S.Hit, S.FX, S.Proj, S.Objects,
-- S.Zones, S.Summons, S.Cast, S.Fighter, S.K, S.Match, S.Kits.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local S = {}

S.Shared = ReplicatedStorage:WaitForChild("Shared")
S.Config = require(S.Shared.Config)
S.Util = require(S.Shared.Util)

S.fighters = {} -- [id] = fighter
S.byModel = {} -- [model] = fighter
S.nextId = 0
S.synergy = S.Config.START_SYNERGY

-- workspace folders
local function folder(name)
	local f = workspace:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = workspace
	end
	return f
end
S.folders = {
	Arena = folder("Arena"),
	Constructs = folder("Constructs"),
	Props = folder("Props"),
	FX = folder("FX"),
	Summons = folder("Summons"),
	Bots = folder("Bots"),
}

function S.now()
	return workspace:GetServerTimeNow()
end

function S.m(metres)
	return metres * S.Config.METRE
end

-- Simple event bus for cross-kit hooks.
S.listeners = {}
function S.on(event, fn)
	S.listeners[event] = S.listeners[event] or {}
	table.insert(S.listeners[event], fn)
	return function()
		local l = S.listeners[event]
		if l then
			local i = table.find(l, fn)
			if i then
				table.remove(l, i)
			end
		end
	end
end
function S.emit(event, ...)
	local l = S.listeners[event]
	if not l then
		return
	end
	for _, fn in ipairs(table.clone(l)) do
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[EB] listener error for " .. event .. ": " .. tostring(err))
		end
	end
end

function S.alive(f)
	return f ~= nil and not f.dead and f.root ~= nil and f.root.Parent ~= nil
end

function S.isEnemy(a, b)
	if a == nil or b == nil then
		return false
	end
	local oa = a.owner or a
	local ob = b.owner or b
	if oa == ob then
		return false
	end
	if oa.team ~= nil and oa.team == ob.team then
		return false
	end
	return true
end

function S.isAlly(a, b)
	if a == nil or b == nil then
		return false
	end
	return not S.isEnemy(a, b)
end

-- "Real player" for Proxima/passives: players, bots, (optionally) dummies; never summons.
function S.isReal(f)
	if f == nil or f.isSummon then
		return false
	end
	if f.player then
		return true
	end
	return S.Config.DUMMIES_COUNT_AS_REAL and (f.isBot or f.isDummy) or false
end

function S.forEachFighter(fn)
	for _, f in pairs(S.fighters) do
		if S.alive(f) then
			fn(f)
		end
	end
end

function S.safe(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[EB] " .. tostring(err))
	end
	return ok, err
end

return S
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000079"><Properties><string name="Name">Status</string><ProtectedString name="Source"><![CDATA[-- Status effects: slows, buffs, damage-over-time, marks, control. Same-name statuses refresh their
-- duration and add stacks up to their cap, but never reset their tick clock.
local S = require(script.Parent.S)

local Status = {}
S.Status = Status

local CONTROL = { stun = true, root = true, sleep = true, lift = true, guardbreak = true, lock = true }
Status.CONTROL = CONTROL

local DOT_CATEGORIES = { burn = true, poison = true, bleed = true, dot = true }
Status.DOT_CATEGORIES = DOT_CATEGORIES

function Status.get(f, name)
	return f and f.statuses[name]
end

function Status.has(f, name)
	return f ~= nil and f.statuses[name] ~= nil
end

function Status.stacks(f, name)
	local st = f and f.statuses[name]
	return st and st.stacks or 0
end

function Status.remaining(f, name)
	local st = f and f.statuses[name]
	if not st then
		return 0
	end
	return math.max(0, st.expires - S.now())
end

--[[ opts:
	duration, stacks (to add, default 1), max (stack cap, default 1), source (fighter), category,
	harmful (default true), removable (default = harmful), slow, speed, dr, drShred (per stack),
	vuln (per stack), dmgBonus, healMult, tick (interval), onTick(f, st), onExpire(f, st),
	onRemove(f, st, reason), label, data, noRefresh, setStacks
]]
function Status.apply(f, name, opts)
	if not S.alive(f) then
		return nil
	end
	opts = opts or {}
	local now = S.now()
	local st = f.statuses[name]
	local dur = opts.duration or 3
	if st then
		local add = opts.stacks or 1
		if opts.setStacks then
			st.stacks = math.min(opts.max or st.max, opts.setStacks)
		else
			st.stacks = math.min(opts.max or st.max, st.stacks + add)
		end
		if not opts.noRefresh then
			st.expires = math.max(st.expires, now + dur)
		end
		if opts.source then
			st.source = opts.source
		end
		for _, k in ipairs({ "slow", "speed", "dr", "drShred", "vuln", "dmgBonus", "healMult", "label" }) do
			if opts[k] ~= nil then
				st[k] = opts[k]
			end
		end
		if opts.data then
			for k, v in pairs(opts.data) do
				st.data[k] = v
			end
		end
	else
		local harmful = opts.harmful
		if harmful == nil then
			harmful = true
		end
		local removable = opts.removable
		if removable == nil then
			removable = harmful
		end
		st = {
			name = name,
			stacks = math.min(opts.max or 1, opts.setStacks or opts.stacks or 1),
			max = opts.max or 1,
			expires = now + dur,
			applied = now,
			source = opts.source,
			category = opts.category or (harmful and "debuff" or "buff"),
			harmful = harmful,
			removable = removable and not CONTROL[name],
			slow = opts.slow,
			speed = opts.speed,
			dr = opts.dr,
			drShred = opts.drShred,
			vuln = opts.vuln,
			dmgBonus = opts.dmgBonus,
			healMult = opts.healMult,
			tick = opts.tick,
			nextTick = opts.tick and (now + opts.tick) or nil,
			onTick = opts.onTick,
			onExpire = opts.onExpire,
			onRemove = opts.onRemove,
			label = opts.label,
			data = opts.data or {},
		}
		f.statuses[name] = st
	end
	f.statusDirty = true
	return st
end

function Status.remove(f, name, reason)
	local st = f and f.statuses[name]
	if not st then
		return false
	end
	f.statuses[name] = nil
	f.statusDirty = true
	if st.onRemove then
		S.safe(st.onRemove, f, st, reason or "removed")
	end
	return true
end

function Status.removeStacks(f, name, n)
	local st = f and f.statuses[name]
	if not st then
		return 0
	end
	local removed = math.min(st.stacks, n or 1)
	st.stacks -= removed
	f.statusDirty = true
	if st.stacks <= 0 then
		Status.remove(f, name, "cleansed")
	end
	return removed
end

-- Cleanse: category filter (string, table set, or nil = any removable harmful). Removes `count` statuses
-- choosing the longest remaining (ties: earliest applied). Returns number removed and list of names.
function Status.cleanse(f, category, count)
	count = count or 1
	local removed = {}
	for _ = 1, count do
		local best
		for _, st in pairs(f.statuses) do
			if st.harmful and st.removable then
				local okCat = category == nil
					or (type(category) == "string" and (st.category == category or (category == "dot" and DOT_CATEGORIES[st.category])))
					or (type(category) == "table" and category[st.category])
				if okCat then
					if
						not best
						or st.expires > best.expires
						or (st.expires == best.expires and st.applied < best.applied)
					then
						best = st
					end
				end
			end
		end
		if not best then
			break
		end
		-- stacking statuses lose one stack per cleanse
		if best.stacks > 1 and best.max > 1 then
			Status.removeStacks(f, best.name, 1)
		else
			Status.remove(f, best.name, "cleansed")
		end
		table.insert(removed, best.name)
	end
	if #removed > 0 then
		S.emit("cleansed", f, removed)
	end
	return #removed, removed
end

function Status.update(f, now)
	for name, st in pairs(f.statuses) do
		if st.tick and st.nextTick and now >= st.nextTick and now <= st.expires + 0.05 then
			st.nextTick += st.tick
			if st.onTick then
				S.safe(st.onTick, f, st)
			end
		end
		if now >= st.expires and f.statuses[name] == st then
			f.statuses[name] = nil
			f.statusDirty = true
			if st.onExpire then
				S.safe(st.onExpire, f, st)
			end
			if st.onRemove then
				S.safe(st.onRemove, f, st, "expired")
			end
		end
	end
end

-- Aggregates ---------------------------------------------------------------
function Status.slow(f)
	local m = 0
	for _, st in pairs(f.statuses) do
		if st.slow and st.slow > m then
			m = st.slow
		end
	end
	return math.min(m, S.Config.MAX_SLOW)
end

function Status.speedBonus(f)
	local s = 0
	for _, st in pairs(f.statuses) do
		if st.speed then
			s += st.speed * (st.speedPerStack and st.stacks or 1)
		end
	end
	return math.min(s, S.Config.MAX_SPEED_BONUS)
end

function Status.dr(f)
	local m = 0
	for _, st in pairs(f.statuses) do
		if st.dr and st.dr > m then
			m = st.dr
		end
	end
	local shred = 0
	for _, st in pairs(f.statuses) do
		if st.drShred then
			shred += st.drShred * st.stacks
		end
	end
	return math.max(0, m - shred)
end

function Status.vuln(f)
	local s = 0
	for _, st in pairs(f.statuses) do
		if st.vuln then
			s += st.vuln * (st.vulnPerStack and st.stacks or 1)
		end
	end
	return s
end

function Status.dmgBonus(f)
	local s = 0
	for _, st in pairs(f.statuses) do
		if st.dmgBonus then
			s += st.dmgBonus
		end
	end
	return s
end

-- strongest healing reduction (healMult is the remaining fraction, e.g. 0.75)
function Status.healMult(f)
	local m = 1
	for _, st in pairs(f.statuses) do
		if st.healMult and st.healMult < m then
			m = st.healMult
		end
	end
	return m
end

function Status.anyControl(f)
	for name in pairs(CONTROL) do
		if f.statuses[name] then
			return name
		end
	end
	return nil
end

-- Damage over time. total damage over duration, ticking every `interval` (default 0.5s).
function Status.dot(f, name, total, duration, src, opts)
	opts = opts or {}
	local interval = opts.interval or 0.5
	local ticks = math.max(1, math.floor(duration / interval + 0.5))
	local per = total / ticks
	local st = f.statuses[name]
	if st then
		st.data.per = per
		st.expires = math.max(st.expires, S.now() + duration)
		st.source = src or st.source
		return st
	end
	return Status.apply(f, name, {
		duration = duration,
		source = src,
		category = opts.category or "dot",
		tick = interval,
		label = opts.label or name,
		max = 1,
		data = { per = per, element = opts.element },
		onTick = function(target, s)
			S.Combat.damage(s.source, target, s.data.per, {
				kind = "dot",
				noGuard = true,
				element = s.data.element,
				tag = name,
			})
		end,
	})
end

function Status.label(f)
	local parts = {}
	for _, st in pairs(f.statuses) do
		local l = st.label
		if l ~= false then
			l = l or st.name
			if st.stacks and st.stacks > 1 then
				l = l .. " x" .. st.stacks
			end
			table.insert(parts, (st.harmful and "-" or "+") .. l)
		end
	end
	table.sort(parts)
	return table.concat(parts, "  ")
end

return Status
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000007A"><Properties><string name="Name">Summons</string><ProtectedString name="Source"><![CDATA[-- Summons / companions / constructs that act: lightweight kinematic fighters owned by a caster.
-- They cannot capture objectives, generate Proxima, create more summons or count as real players.
local RunService = game:GetService("RunService")
local S = require(script.Parent.S)

local Summons = {}
S.Summons = Summons

local M = S.Config.METRE
local active = {}
Summons.active = active

--[[ opts:
	owner, name, pos (studs), hp, duration, speed (m/s), size (Vector3 studs), color, shape ("Ball"|"Block"),
	material, attack = { range (m), dmg, interval, kind ("melee"|"ranged"), projSpeed (m/s), onHit(sm, t), push },
	ai = "chase" | "stay" | "follow" | "turret" | "none", aggro (m), leash (m), target, flying (height studs),
	onDeath(sm, src), onExpire(sm), onTick(sm, dt), controlImmune, data, visible tell
]]
function Summons.create(opts)
	local owner = opts.owner
	local model = Instance.new("Model")
	model.Name = (opts.name or "Summon")
	local size = opts.size or Vector3.new(2.4, 2.4, 2.4)
	local body = Instance.new("Part")
	body.Name = "HumanoidRootPart"
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.Size = size
	if opts.shape ~= "Block" then
		body.Shape = Enum.PartType.Ball
	end
	body.Material = opts.material or Enum.Material.Neon
	body.Color = opts.color or (owner and S.Util.color(owner.kitName)) or Color3.new(1, 1, 1)
	body.Transparency = opts.transparency or 0.1
	local pos = opts.pos or (owner and owner.root.Position)
	body.CFrame = CFrame.new(pos)
	body.Parent = model
	local eye = Instance.new("Part")
	eye.Name = "Eye"
	eye.Anchored = true
	eye.CanCollide = false
	eye.CanQuery = false
	eye.Size = Vector3.new(size.X * 0.5, size.Y * 0.2, 0.2)
	eye.Color = Color3.new(0, 0, 0)
	eye.Material = Enum.Material.SmoothPlastic
	eye.CFrame = body.CFrame * CFrame.new(0, size.Y * 0.15, -size.Z / 2)
	eye.Parent = model
	model.PrimaryPart = body
	model.Parent = S.folders.Summons
	local f = S.Fighter.new(model, {
		isSummon = true,
		owner = owner,
		team = owner and owner.team,
		maxHealth = opts.hp or 150,
		name = (owner and (owner.name .. "'s ") or "") .. (opts.name or "Summon"),
		radius = math.max(size.X, size.Z) / 2,
	})
	f.kitName = owner and owner.kitName
	f.sm = {
		speed = (opts.speed or S.Config.SUMMON_SPEED) * M,
		attack = opts.attack,
		ai = opts.ai or "chase",
		aggro = (opts.aggro or 20) * M,
		leash = opts.leash and opts.leash * M or nil,
		target = opts.target,
		goal = nil,
		lastAttack = 0,
		lastSeen = 0,
		expires = opts.duration and (S.now() + opts.duration) or nil,
		onDeath = opts.onDeath,
		onExpire = opts.onExpire,
		onTick = opts.onTick,
		flying = opts.flying,
		size = size,
		eye = eye,
		hover = size.Y / 2 + (opts.flying or 0.2),
	}
	f.data = opts.data or {}
	f.controlImmune = opts.controlImmune
	f.energy = 0
	if owner then
		table.insert(owner.summons, f)
	end
	active[f] = true
	return f
end

function Summons.remove(f, reason)
	if not active[f] then
		return
	end
	active[f] = nil
	f.dead = true
	if f.owner then
		local i = table.find(f.owner.summons, f)
		if i then
			table.remove(f.owner.summons, i)
		end
	end
	S.fighters[f.id] = nil
	S.byModel[f.model] = nil
	if f.model then
		S.FX.burst(f.root.Position, 3, f.root.Color, 0.25)
		f.model:Destroy()
	end
	if reason == "expired" and f.sm.onExpire then
		S.safe(f.sm.onExpire, f)
	end
end

function Summons.command(f, target)
	if f.sm then
		f.sm.target = target
		f.sm.goal = nil
		f.sm.lastSeen = S.now()
	end
end

function Summons.moveTo(f, pos)
	if f.sm then
		f.sm.goal = pos
		f.sm.target = nil
	end
end

function Summons.owned(owner, name)
	local out = {}
	for _, f in ipairs(owner.summons) do
		if active[f] and (name == nil or f.model.Name == name) then
			table.insert(out, f)
		end
	end
	return out
end

local function nearestEnemy(f, range)
	local best, bd
	for _, t in pairs(S.fighters) do
		if S.alive(t) and S.isEnemy(f, t) and not (t.untargetable > 0) then
			local d = (t.root.Position - f.root.Position).Magnitude
			if d <= range and (not bd or d < bd) and S.Hit.los(f.root.Position, t.root.Position) then
				best, bd = t, d
			end
		end
	end
	return best
end
Summons.nearestEnemy = nearestEnemy

local function doAttack(f, t)
	local a = f.sm.attack
	local now = S.now()
	if now - f.sm.lastAttack < (a.interval or 1) then
		return
	end
	f.sm.lastAttack = now
	local src = f
	if a.kind == "ranged" then
		S.Proj.fire({
			owner = f,
			origin = f.root.Position,
			dir = (t.root.Position - f.root.Position).Unit,
			speed = (a.projSpeed or 24) * M,
			range = (a.range or 12) * M + 4,
			radius = 0.6,
			color = f.root.Color,
			dmg = a.dmg,
			onHit = function(_, target)
				S.Combat.damage(src, target, a.dmg or 30, { fromSummon = true, element = f.kitName })
				if a.onHit then
					a.onHit(f, target)
				end
			end,
		})
	else
		S.FX.beam(f.root.Position, t.root.Position, 0.4, f.root.Color, 0.12)
		S.Combat.damage(src, t, a.dmg or 30, { fromSummon = true, melee = true, element = f.kitName })
		if a.push then
			S.Combat.knockback(t, f.root.Position, a.push * M, src)
		end
		if a.onHit then
			a.onHit(f, t)
		end
	end
end

local aiTimer = 0
RunService.Heartbeat:Connect(function(dt)
	local now = S.now()
	aiTimer += dt
	local think = aiTimer >= 0.2
	if think then
		aiTimer = 0
	end
	for f in pairs(active) do
		if f.dead or not f.root or not f.root.Parent then
			Summons.remove(f, "dead")
		else
			local sm = f.sm
			if sm.expires and now >= sm.expires then
				Summons.remove(f, "expired")
			elseif f.owner and f.owner.dead and not sm.persist then
				Summons.remove(f, "owner")
			else
				if think then
					-- statuses / shields are updated by the main fighter tick
					if sm.onTick then
						S.safe(sm.onTick, f, 0.2)
					end
					-- choose target
					if sm.ai ~= "none" and sm.ai ~= "follow" then
						local t = sm.target
						if t and (not S.alive(t)) then
							t = nil
							sm.target = nil
						end
						if t then
							if S.Hit.los(f.root.Position, t.root.Position) then
								sm.lastSeen = now
							elseif now - sm.lastSeen > 1 then
								sm.target = nil
								t = nil
							end
						end
						if not t and sm.ai ~= "stay" then
							t = nearestEnemy(f, sm.aggro)
							if t then
								sm.autoTarget = t
							end
						elseif not t and sm.ai == "stay" then
							t = nearestEnemy(f, sm.attack and (sm.attack.range or 3) * M or 6)
						end
						sm.current = t
						if t and sm.attack then
							local d = (t.root.Position - f.root.Position).Magnitude
							if d <= (sm.attack.range or 2) * M + 2 then
								doAttack(f, t)
							end
						end
					end
					if f.sm and not active[f] then
						continue
					end
					if S.alive(f) and f.sm then
						f.model:SetAttribute("Health", math.floor(f.health))
					end
				end
				-- movement
				if not S.Fighter.canMove(f) then
					continue
				end
				local goal = sm.goal
				local t = sm.current
				if sm.ai == "follow" and f.owner and S.alive(f.owner) then
					goal = f.owner.root.Position + f.owner.root.CFrame.RightVector * 4
				elseif t and (sm.ai == "chase") then
					goal = t.root.Position
				end
				if sm.leash and f.owner and S.alive(f.owner) then
					if (f.root.Position - f.owner.root.Position).Magnitude > sm.leash then
						goal = f.owner.root.Position
					end
				end
				if goal and sm.ai ~= "turret" and sm.ai ~= "stay" or (goal and sm.goal) then
					local pos = f.root.Position
					local to = Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z)
					local stopAt = (t and sm.attack and (sm.attack.range or 2) * M * 0.8) or 1
					if to.Magnitude > stopAt then
						local mult = (1 - S.Status.slow(f)) * (1 + S.Status.speedBonus(f)) * (f.speedMult or 1)
						local stepLen = math.min(to.Magnitude - stopAt * 0.5, sm.speed * mult * dt)
						local dir = to.Unit
						local nextPos = pos + dir * stepLen
						local blocked = workspace:Raycast(pos, dir * (stepLen + sm.size.X / 2), S.Hit.worldParams)
						if blocked and not sm.flying then
							-- try sliding along the obstacle
							local n = blocked.Normal
							local slide = dir - n * dir:Dot(n)
							if slide.Magnitude > 0.1 then
								nextPos = pos + Vector3.new(slide.X, 0, slide.Z).Unit * stepLen
							else
								nextPos = pos
							end
						end
						local g = S.Hit.ground(nextPos + Vector3.new(0, 3, 0), 30)
						local y = g and (g.Y + sm.hover) or nextPos.Y
						local np = Vector3.new(nextPos.X, y, nextPos.Z)
						f.root.CFrame = CFrame.lookAt(np, np + dir)
					elseif sm.goal and to.Magnitude <= stopAt then
						sm.goal = nil
					end
				end
				if sm.eye and sm.eye.Parent then
					sm.eye.CFrame = f.root.CFrame * CFrame.new(0, sm.size.Y * 0.15, -sm.size.Z / 2)
				end
			end
		end
	end
end)

-- death of summons is routed through the defeated event
S.on("defeated", function(f, killer)
	if f.isSummon and active[f] then
		if f.sm.onDeath then
			S.safe(f.sm.onDeath, f, killer)
		end
		Summons.remove(f, "defeated")
	end
end)

return Summons
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000007B"><Properties><string name="Name">Zones</string><ProtectedString name="Source"><![CDATA[-- Persistent fields (circles, rectangles, rings). Tick clocks never restart when a zone moves.
local Debris = game:GetService("Debris")
local S = require(script.Parent.S)

local Zones = {}
S.Zones = Zones

local list = {}
local nextId = 0
Zones.list = list

local Zone = {}
Zone.__index = Zone

--[[ opts:
	owner, cast, pos (studs, ground point), radius, shape ("circle" | "rect" | "ring"), width, length, dir (rect),
	inner (ring), duration, tick (default 1), immediate (first tick at once), targets ("enemies"|"allies"|"all"|fn),
	onTick(zone, list), onEnter(zone, f), onExit(zone, f), onEnd(zone), color, transparency, element,
	above (height studs), follow (fighter), noVisual, tags, data, includeOwner
]]
function Zones.create(opts)
	nextId += 1
	local now = S.now()
	local z = setmetatable({
		id = nextId,
		owner = opts.owner,
		cast = opts.cast,
		pos = opts.pos,
		radius = opts.radius or S.m(3),
		shape = opts.shape or "circle",
		width = opts.width,
		length = opts.length,
		dir = opts.dir and Vector3.new(opts.dir.X, 0, opts.dir.Z).Unit or Vector3.new(0, 0, -1),
		inner = opts.inner or 0,
		expires = now + (opts.duration or 5),
		tick = opts.tick or S.Config.FIELD_TICK,
		nextTick = opts.immediate and now or (now + (opts.tick or S.Config.FIELD_TICK)),
		targetMode = opts.targets or "enemies",
		onTick = opts.onTick,
		onEnter = opts.onEnter,
		onExit = opts.onExit,
		onEnd = opts.onEnd,
		element = opts.element or (opts.owner and opts.owner.kitName),
		above = opts.above or S.m(4),
		follow = opts.follow,
		inside = {},
		entered = {},
		alive = true,
		tags = opts.tags or {},
		data = opts.data or {},
		includeOwner = opts.includeOwner,
		created = now,
		color = opts.color or (opts.owner and S.Util.color(opts.owner.kitName)) or Color3.new(1, 1, 1),
	}, Zone)
	if not opts.noVisual then
		z:buildVisual(opts.transparency)
	end
	list[z.id] = z
	if opts.owner then
		table.insert(opts.owner.zones, z)
	end
	return z
end

function Zone:buildVisual(transparency)
	if self.visual then
		self.visual:Destroy()
	end
	local tr = transparency or 0.65
	if self.shape == "rect" then
		local mid = self.pos + self.dir * (self.length / 2)
		self.visual = S.FX.rect(CFrame.lookAt(mid, mid + self.dir), self.width, self.length, nil, self.color, tr)
	else
		self.visual = S.FX.disc(self.pos + Vector3.new(0, 0.05, 0), self.radius, self.color, nil, tr, 0.2)
	end
	if self.shape == "ring" and self.inner > 0 then
		local hole = S.FX.disc(self.pos + Vector3.new(0, 0.12, 0), self.inner, Color3.new(0, 0, 0), nil, 0.85, 0.22)
		hole.Parent = self.visual
	end
end

function Zone:contains(f)
	local p = f.root.Position
	if p.Y > self.pos.Y + self.above + S.Config.BODY_DOWN or p.Y < self.pos.Y - S.m(2) then
		return false
	end
	if self.shape == "rect" then
		local cf = CFrame.lookAt(self.pos, self.pos + self.dir)
		local lp = cf:PointToObjectSpace(p)
		return math.abs(lp.X) <= self.width / 2 + 0.8 and -lp.Z >= -0.8 and -lp.Z <= self.length + 0.8
	end
	local d = Vector3.new(p.X - self.pos.X, 0, p.Z - self.pos.Z).Magnitude
	if self.shape == "ring" then
		return d <= self.radius + 0.8 and d >= self.inner - 0.8
	end
	return d <= self.radius + 0.8
end

function Zone:filter(f)
	local mode = self.targetMode
	if type(mode) == "function" then
		return mode(f, self)
	end
	local o = self.owner
	if not o then
		return true
	end
	if f == o and not self.includeOwner then
		return mode == "allies" or mode == "allIncludingOwner"
	end
	if mode == "enemies" then
		return S.isEnemy(o, f) or (self.includeOwner and f == o)
	elseif mode == "allies" then
		return S.isAlly(o, f)
	end
	return true
end

function Zone:targets()
	local out = {}
	for _, f in pairs(S.fighters) do
		if S.alive(f) and self:filter(f) and self:contains(f) then
			table.insert(out, f)
		end
	end
	return out
end

function Zone:move(pos)
	self.pos = pos
	if self.visual then
		if self.shape == "rect" then
			local mid = pos + self.dir * (self.length / 2)
			self.visual.CFrame = CFrame.lookAt(mid, mid + self.dir)
		else
			self.visual:PivotTo(CFrame.new(pos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)))
		end
	end
end

function Zone:resize(radius)
	self.radius = radius
	self:buildVisual()
end

function Zone:remove(reason)
	if not self.alive then
		return
	end
	self.alive = false
	list[self.id] = nil
	if self.visual then
		local v = self.visual
		Debris:AddItem(v, 0)
	end
	if self.onEnd then
		S.safe(self.onEnd, self, reason or "removed")
	end
end

function Zone:extend(seconds)
	self.expires += seconds
end

function Zone:remaining()
	return math.max(0, self.expires - S.now())
end

function Zones.update(now)
	for _, z in pairs(list) do
		if z.alive then
			if z.follow then
				if S.alive(z.follow) then
					local g = S.Hit.ground(z.follow.root.Position) or z.follow.root.Position
					z:move(g)
				else
					z:remove("follow lost")
				end
			end
			if z.alive then
				local current = {}
				for _, f in ipairs(z:targets()) do
					current[f] = true
					if not z.inside[f] then
						z.inside[f] = true
						if z.onEnter then
							S.safe(z.onEnter, z, f, not z.entered[f])
						end
						z.entered[f] = true
					end
				end
				for f in pairs(z.inside) do
					if not current[f] then
						z.inside[f] = nil
						if z.onExit then
							S.safe(z.onExit, z, f)
						end
					end
				end
				if now >= z.nextTick then
					z.nextTick += z.tick
					if z.onTick then
						local t = {}
						for f in pairs(current) do
							table.insert(t, f)
						end
						S.safe(z.onTick, z, t)
					end
				end
				if now >= z.expires then
					z:remove("expired")
				end
			end
		end
	end
end

function Zones.near(pos, r, filter)
	local out = {}
	for _, z in pairs(list) do
		if z.alive then
			local d = Vector3.new(z.pos.X - pos.X, 0, z.pos.Z - pos.Z).Magnitude
			if d <= r + (z.radius or 0) and (filter == nil or filter(z)) then
				table.insert(out, z)
			end
		end
	end
	return out
end

function Zones.owned(f, tag)
	local out = {}
	for _, z in ipairs(f.zones) do
		if z.alive and (tag == nil or z.tags[tag]) then
			table.insert(out, z)
		end
	end
	return out
end

function Zones.removeOwned(f)
	for _, z in ipairs(f.zones) do
		z:remove("owner")
	end
	table.clear(f.zones)
end

return Zones
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX0000007D"><Properties><string name="Name">Kits</string><ProtectedString name="Source"><![CDATA[-- Kit registry: maps power names to behaviour modules (children of this module) and generated data.
local S = require(script.Parent.Core.S)

local Kits = {}
S.Kits = Kits

local KitDataFolder = S.Shared:WaitForChild("KitData")
local Index = require(S.Shared:WaitForChild("KitIndex"))
Kits.index = Index

local nameToId = {}
local idToName = {}
for _, e in ipairs(Index) do
	nameToId[e.name] = e.id
	nameToId[e.id] = e.id
	nameToId[string.lower(e.name)] = e.id
	idToName[e.id] = e.name
end

local cache = {}
local dataCache = {}

function Kits.id(name)
	return name and nameToId[name] or nil
end

function Kits.displayName(name)
	local id = Kits.id(name)
	return id and idToName[id] or nil
end

function Kits.data(name)
	local id = Kits.id(name)
	if not id then
		return nil
	end
	if not dataCache[id] then
		local mod = KitDataFolder:FindFirstChild(id)
		if not mod then
			return nil
		end
		dataCache[id] = require(mod)
	end
	return dataCache[id]
end

-- Fallback behaviour used only if a kit module is missing or fails to load, so a broken kit never
-- breaks the server. It reads the first damage figure from each move description.
local function fallback(id)
	local K = S.K
	local data = Kits.data(id)
	local kit = { passive = {} }
	for slot = 1, 5 do
		local def = data.moves[slot]
		local dmg = tonumber(string.match(def.desc, "(%d+) damage")) or (slot == 5 and 150 or 60)
		kit[slot] = function(c)
			if slot == 5 then
				local pos = c:aimPoint(def.range > 0 and def.range or 10)
				if K.warn(c, pos, 6, 1) then
					K.circle(c, pos, 6, { dmg = dmg })
				end
			elseif def.range == 0 then
				K.circle(c, c:feet(), 4, { dmg = dmg })
			else
				K.proj(c, { dmg = dmg, range = def.range })
			end
		end
	end
	return kit
end

function Kits.get(name)
	local id = Kits.id(name)
	if not id then
		return nil
	end
	if cache[id] then
		return cache[id]
	end
	local mod = script:FindFirstChild(id)
	local kit
	if mod then
		local ok, res = pcall(require, mod)
		if ok and type(res) == "table" then
			kit = res
		else
			warn("[EB] kit " .. id .. " failed to load: " .. tostring(res))
		end
	end
	if not kit then
		kit = fallback(id)
		kit.isFallback = true
	end
	cache[id] = kit
	return kit
end

function Kits.names()
	local out = {}
	for _, e in ipairs(Index) do
		table.insert(out, e.name)
	end
	return out
end

function Kits.random(rng)
	rng = rng or Random.new()
	return Index[rng:NextInteger(1, #Index)].name
end

return Kits
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000007E"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- EB: Proxima — server bootstrap.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Server = script.Parent
local Core = Server:WaitForChild("Core")

local S = require(Core.S)
require(Core.FX)
require(Core.Hit)
local Status = require(Core.Status)
local Combat = require(Core.Combat)
local Fighter = require(Core.Fighter)
local Objects = require(Core.Objects)
local Zones = require(Core.Zones)
require(Core.Proj)
require(Core.Summons)
local Cast = require(Core.Cast)
require(Core.K)
require(Server:WaitForChild("Kits"))
local Arena = require(Core.Arena)
local Match = require(Core.Match)
require(Core.Bots)
local _ = Status

-- Remotes ----------------------------------------------------------------------------------------
local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "Remotes"
local function remote(name, class)
	local r = Instance.new(class or "RemoteEvent")
	r.Name = name
	r.Parent = remoteFolder
	return r
end
local remotes = {
	Input = remote("Input"),
	Aim = remote("Aim", "UnreliableRemoteEvent"),
	Pop = remote("Pop"),
	Notice = remote("Notice"),
	Feed = remote("Feed"),
}
remoteFolder.Parent = ReplicatedStorage

Combat.init(remotes)
Cast.init(remotes)

Arena.build()
Match.init(remotes)

-- Input --------------------------------------------------------------------------------------------
local function isVec(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z and v.Magnitude < 1e5
end

remotes.Input.OnServerEvent:Connect(function(player, action, a, b, c)
	if type(action) ~= "string" then
		return
	end
	if action == "selectKit" then
		if type(a) == "string" then
			Match.selectKit(player, a)
		end
		return
	elseif action == "setting" then
		if type(a) == "string" then
			Match.setting(player, a, b)
		end
		return
	end
	local f = Fighter.forPlayer(player)
	if not f or f.dead then
		return
	end
	if action == "cast" then
		if type(a) == "number" then
			Cast.press(f, math.floor(a), b == true, c == true)
		end
	elseif action == "basic" then
		Fighter.basic(f)
	elseif action == "dodge" then
		Fighter.dodge(f, isVec(a) and a or nil)
	elseif action == "guard" then
		Fighter.setGuard(f, a == true)
	elseif action == "kit" then
		Cast.kitAction(f, a)
	end
end)

remotes.Aim.OnServerEvent:Connect(function(player, origin, dir, hit, target)
	local f = Fighter.forPlayer(player)
	if not f or f.dead then
		return
	end
	if not (isVec(origin) and isVec(dir) and isVec(hit)) then
		return
	end
	if dir.Magnitude < 0.01 then
		return
	end
	-- the aim origin must be near the character (camera offset tolerance)
	if (origin - f.root.Position).Magnitude > 60 then
		return
	end
	if typeof(target) ~= "Instance" or not target:IsA("Model") then
		target = nil
	end
	f.aim = { origin = origin, dir = dir.Unit, hit = hit, target = target }
end)

-- Main tick (10 Hz resources/statuses, zones; objects) ------------------------------------------
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.1 then
		return
	end
	local step = acc
	acc = 0
	local now = S.now()
	for _, f in pairs(S.fighters) do
		local ok, err = pcall(Fighter.tick, f, step, now)
		if not ok then
			warn("[EB] fighter tick: " .. tostring(err))
		end
	end
	local ok1, e1 = pcall(Zones.update, now)
	if not ok1 then
		warn("[EB] zones: " .. tostring(e1))
	end
	local ok2, e2 = pcall(Objects.update, now)
	if not ok2 then
		warn("[EB] objects: " .. tostring(e2))
	end
end)

Players.PlayerAdded:Connect(function(p)
	task.delay(2, function()
		if p.Parent then
			remotes.Notice:FireClient(p, "Welcome to EB: Proxima — press TAB to choose a power")
		end
	end)
end)

print("[EB: Proxima] server ready — " .. #S.Kits.index .. " powers loaded")
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX0000008B"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX00000081"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000088"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000082"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[-- Input, over-the-shoulder aiming camera, aim replication and touch/gamepad bindings.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")

local Controls = {}

local ctx
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

Controls.locked = true
Controls.menuOpen = false
Controls.modifier = false

local KEY_SLOTS = {
	[Enum.KeyCode.Q] = 1,
	[Enum.KeyCode.E] = 2,
	[Enum.KeyCode.R] = 3,
	[Enum.KeyCode.F] = 4,
	[Enum.KeyCode.G] = 5,
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.ButtonX] = 1,
	[Enum.KeyCode.ButtonY] = 2,
	[Enum.KeyCode.ButtonB] = 3,
	[Enum.KeyCode.DPadUp] = 4,
	[Enum.KeyCode.ButtonR1] = 5,
}
Controls.KEY_LABELS = { "Q", "E", "R", "F", "G" }

local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude

local lastAim = { hit = Vector3.zero, dir = Vector3.new(0, 0, -1), origin = Vector3.zero }
Controls.aim = lastAim

local function character()
	return player.Character
end

local function computeAim()
	local ch = character()
	local ignore = { workspace:FindFirstChild("FX"), workspace:FindFirstChild("Props") }
	if ch then
		table.insert(ignore, ch)
	end
	aimParams.FilterDescendantsInstances = ignore
	local ray
	local vp = camera.ViewportSize
	if Controls.locked or UserInputService.TouchEnabled then
		ray = camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
	else
		local m = UserInputService:GetMouseLocation()
		ray = camera:ViewportPointToRay(m.X, m.Y)
	end
	local res = workspace:Raycast(ray.Origin, ray.Direction * 600, aimParams)
	local hit = res and res.Position or (ray.Origin + ray.Direction * 300)
	local target
	if res and res.Instance then
		local m = res.Instance:FindFirstAncestorWhichIsA("Model")
		while m and m ~= workspace do
			if m:GetAttribute("FighterId") then
				target = m
				break
			end
			m = m.Parent and m.Parent:FindFirstAncestorWhichIsA("Model")
		end
	end
	lastAim.origin = ray.Origin
	lastAim.dir = ray.Direction.Unit
	lastAim.hit = hit
	lastAim.target = target
	return lastAim
end

local function sendAim()
	local a = computeAim()
	ctx.remotes.Aim:FireServer(a.origin, a.dir, a.hit, a.target)
end
Controls.sendAim = sendAim

local function input(action, ...)
	ctx.remotes.Input:FireServer(action, ...)
end
Controls.input = input

function Controls.cast(slot, down)
	if Controls.menuOpen then
		return
	end
	if down then
		sendAim()
	end
	input("cast", slot, down, Controls.modifier)
end

local basicHeld = false
function Controls.basic(down)
	basicHeld = down
	if down and not Controls.menuOpen then
		sendAim()
		input("basic")
	end
end

function Controls.guard(down)
	if Controls.menuOpen and down then
		return
	end
	input("guard", down)
end

function Controls.dodge()
	if Controls.menuOpen then
		return
	end
	local ch = character()
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local dir = hum and hum.MoveDirection or Vector3.zero
	if dir.Magnitude < 0.1 then
		local lv = camera.CFrame.LookVector
		dir = Vector3.new(lv.X, 0, lv.Z)
	end
	input("dodge", dir.Magnitude > 0 and dir.Unit or nil)
end

function Controls.kitAction()
	if not Controls.menuOpen then
		sendAim()
		input("kit")
	end
end

function Controls.setLocked(on)
	Controls.locked = on
	if not on then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	local ch = character()
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.AutoRotate = not on
		hum.CameraOffset = on and Vector3.new(1.75, 0.6, 0) or Vector3.zero
	end
	if ctx.HUD and ctx.HUD.setCrosshair then
		ctx.HUD.setCrosshair(on)
	end
end

function Controls.setMenuOpen(open)
	Controls.menuOpen = open
	if open then
		Controls.wasLocked = Controls.locked
		Controls.setLocked(false)
	elseif Controls.wasLocked ~= nil then
		Controls.setLocked(Controls.wasLocked and not UserInputService.TouchEnabled)
	end
end

function Controls.init(c)
	ctx = c
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		Controls.locked = false
	end
	UserInputService.InputBegan:Connect(function(io, processed)
		if io.KeyCode == Enum.KeyCode.Tab then
			ctx.KitMenu.toggle()
			return
		end
		if processed then
			return
		end
		if io.UserInputType == Enum.UserInputType.MouseButton1 then
			Controls.basic(true)
			return
		elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
			Controls.guard(true)
			return
		end
		local kc = io.KeyCode
		if kc == Enum.KeyCode.LeftControl or kc == Enum.KeyCode.RightControl or kc == Enum.KeyCode.ButtonL3 then
			Controls.modifier = true
			return
		end
		if kc == Enum.KeyCode.LeftShift or kc == Enum.KeyCode.ButtonL1 then
			Controls.dodge()
			return
		end
		if kc == Enum.KeyCode.ButtonL2 then
			Controls.guard(true)
			return
		end
		if kc == Enum.KeyCode.ButtonR2 then
			Controls.basic(true)
			return
		end
		if kc == Enum.KeyCode.V or kc == Enum.KeyCode.ButtonR3 then
			Controls.kitAction()
			return
		end
		if kc == Enum.KeyCode.Z or kc == Enum.KeyCode.LeftAlt then
			if not Controls.menuOpen then
				Controls.setLocked(not Controls.locked)
			end
			return
		end
		local slot = KEY_SLOTS[kc]
		if slot then
			Controls.cast(slot, true)
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 then
			Controls.basic(false)
			return
		elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
			Controls.guard(false)
			return
		end
		local kc = io.KeyCode
		if kc == Enum.KeyCode.LeftControl or kc == Enum.KeyCode.RightControl or kc == Enum.KeyCode.ButtonL3 then
			Controls.modifier = false
			return
		end
		if kc == Enum.KeyCode.ButtonL2 then
			Controls.guard(false)
			return
		end
		if kc == Enum.KeyCode.ButtonR2 then
			Controls.basic(false)
			return
		end
		local slot = KEY_SLOTS[kc]
		if slot then
			ctx.remotes.Input:FireServer("cast", slot, false, Controls.modifier)
		end
	end)

	-- touch buttons
	if UserInputService.TouchEnabled then
		local function bind(name, label, pos, fn)
			ContextActionService:BindAction(name, function(_, state)
				if state == Enum.UserInputState.Begin then
					fn(true)
				elseif state == Enum.UserInputState.End then
					fn(false)
				end
				return Enum.ContextActionResult.Sink
			end, true)
			ContextActionService:SetTitle(name, label)
			ContextActionService:SetPosition(name, pos)
		end
		bind("EBBasic", "Hit", UDim2.new(1, -170, 1, -90), Controls.basic)
		bind("EBGuard", "Guard", UDim2.new(1, -250, 1, -60), Controls.guard)
		bind("EBDodge", "Dodge", UDim2.new(1, -90, 1, -170), function(d)
			if d then
				Controls.dodge()
			end
		end)
		for slot = 1, 5 do
			bind("EBMove" .. slot, slot == 5 and "ULT" or tostring(slot), UDim2.new(1, -330 + slot * 62, 1, -250), function(d)
				Controls.cast(slot, d)
			end)
		end
		bind("EBKit", "Kit", UDim2.new(1, -90, 1, -250), function(d)
			if d then
				Controls.kitAction()
			end
		end)
		bind("EBMod", "Mod", UDim2.new(1, -330, 1, -170), function(d)
			Controls.modifier = d
		end)
	end

	-- camera lock + aim stream
	local aimTimer = 0
	local basicTimer = 0
	RunService.RenderStepped:Connect(function(dt)
		local ch = character()
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if Controls.locked and not Controls.menuOpen and hum and root and hum.Health > 0 then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			hum.AutoRotate = false
			if hum.CameraOffset.Magnitude < 0.1 then
				hum.CameraOffset = Vector3.new(1.75, 0.6, 0)
			end
			local lv = camera.CFrame.LookVector
			local flat = Vector3.new(lv.X, 0, lv.Z)
			if flat.Magnitude > 0.01 then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
			end
		elseif hum and not Controls.locked then
			hum.AutoRotate = true
		end
		aimTimer += dt
		if aimTimer >= 1 / 15 then
			aimTimer = 0
			if ch then
				sendAim()
			end
		end
		if basicHeld and not Controls.menuOpen then
			basicTimer += dt
			if basicTimer > 0.2 then
				basicTimer = 0
				input("basic")
			end
		end
	end)

	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		Controls.setLocked(Controls.locked and not Controls.menuOpen)
	end)
end

return Controls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000083"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- Heads-up display: health/shield, Energy, Guard, Heat, Proxima, dodge pips, ability bar with
-- cooldowns / recasts / P60 cues, statuses, kit resources, cast bar, crosshair, feed and notices.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local HUD = {}

local ctx, T
local player = Players.LocalPlayer
local slots = {}
local refs = {}

local function now()
	return workspace:GetServerTimeNow()
end

local function esc(s)
	return (string.gsub(string.gsub(string.gsub(s or "", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

local function bar(parent, name, pos, size, color, labelText)
	local back = T.new("Frame", {
		Name = name,
		Position = pos,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(12, 13, 18),
		BackgroundTransparency = 0.2,
		Parent = parent,
	})
	T.corner(back, 4)
	local fill = T.new("Frame", { Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, Parent = back })
	T.corner(fill, 4)
	local over = T.new("Frame", {
		Name = "Over",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = T.shield,
		BackgroundTransparency = 0.25,
		Parent = back,
	})
	T.corner(over, 4)
	local lbl = T.label({
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		Text = labelText or "",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		ZIndex = 3,
		Parent = back,
	})
	return { back = back, fill = fill, over = over, label = lbl }
end

local function marker(b, frac, color)
	T.new("Frame", {
		Position = UDim2.new(frac, -1, 0, -2),
		Size = UDim2.new(0, 2, 1, 4),
		BackgroundColor3 = color or Color3.new(1, 1, 1),
		ZIndex = 4,
		Parent = b.back,
	})
end

function HUD.setCrosshair(on)
	if refs.cross then
		refs.cross.Visible = on
	end
end

function HUD.notice(text)
	local n = refs.notice
	n.Text = text
	n.TextTransparency = 0
	n.TextStrokeTransparency = 0.3
	refs.noticeToken = (refs.noticeToken or 0) + 1
	local tok = refs.noticeToken
	task.delay(2.2, function()
		if refs.noticeToken == tok then
			TweenService:Create(n, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

function HUD.feed(text)
	local item = T.label({
		Size = UDim2.new(1, 0, 0, 20),
		Text = text,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextStrokeTransparency = 0.4,
		Parent = refs.feed,
	})
	task.delay(7, function()
		TweenService:Create(item, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.6)
		item:Destroy()
	end)
	local kids = {}
	for _, c in ipairs(refs.feed:GetChildren()) do
		if c:IsA("TextLabel") then
			table.insert(kids, c)
		end
	end
	if #kids > 6 then
		kids[1]:Destroy()
	end
end

local function buildSlot(parent, i)
	local f = T.new("Frame", {
		Name = "Slot" .. i,
		Size = UDim2.fromOffset(i == 5 and 84 or 72, 72),
		BackgroundColor3 = T.panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = i,
		Parent = parent,
	})
	T.corner(f, 8)
	local stroke = T.stroke(f, Color3.new(1, 1, 1), 2, 0.7)
	local key = T.label({
		Name = "Key",
		Position = UDim2.fromOffset(5, 3),
		Size = UDim2.fromOffset(20, 16),
		Text = ctx.Controls.KEY_LABELS[i],
		Font = Enum.Font.GothamBlack,
		TextSize = 14,
		TextColor3 = T.accent,
		Parent = f,
	})
	local cost = T.label({
		Name = "Cost",
		Position = UDim2.new(1, -40, 0, 3),
		Size = UDim2.fromOffset(36, 16),
		Text = "",
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = T.energy,
		Font = Enum.Font.GothamBold,
		Parent = f,
	})
	local name = T.label({
		Name = "MoveName",
		Position = UDim2.fromOffset(4, 22),
		Size = UDim2.new(1, -8, 0, 34),
		Text = "",
		TextSize = 11,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = f,
	})
	local badge = T.label({
		Name = "Badge",
		Position = UDim2.new(0, 4, 1, -16),
		Size = UDim2.new(1, -8, 0, 14),
		Text = "",
		TextSize = 10,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Color3.fromRGB(255, 235, 120),
		Parent = f,
	})
	local cd = T.new("Frame", {
		Name = "CD",
		Size = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		ZIndex = 5,
		Parent = f,
	})
	T.corner(cd, 8)
	local cdText = T.label({
		Name = "CDText",
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextSize = 22,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		ZIndex = 6,
		Parent = f,
	})
	local btn = T.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 7, Parent = f })
	btn.MouseEnter:Connect(function()
		refs.tipSlot = i
	end)
	btn.MouseLeave:Connect(function()
		if refs.tipSlot == i then
			refs.tipSlot = nil
		end
	end)
	btn.Activated:Connect(function()
		ctx.Controls.cast(i, true)
		task.delay(0.05, function()
			ctx.remotes.Input:FireServer("cast", i, false, false)
		end)
	end)
	slots[i] = { frame = f, stroke = stroke, key = key, cost = cost, name = name, badge = badge, cd = cd, cdText = cdText }
end

function HUD.init(c)
	ctx = c
	T = c.Theme
	local gui = c.gui

	-- bottom cluster
	local bottom = T.new("Frame", {
		Name = "Bottom",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(460, 190),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.bottom = bottom
	refs.kitName = T.label({
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, 18),
		Text = "",
		Font = Enum.Font.GothamBlack,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		Parent = bottom,
	})
	refs.kitRes = T.label({
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 16),
		Text = "",
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(255, 225, 160),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		Parent = bottom,
	})
	refs.health = bar(bottom, "Health", UDim2.fromOffset(0, 38), UDim2.new(1, 0, 0, 18), T.health)
	refs.energy = bar(bottom, "Energy", UDim2.fromOffset(0, 60), UDim2.new(0.62, -4, 0, 12), T.energy)
	refs.guard = bar(bottom, "Guard", UDim2.new(0.62, 4, 0, 60), UDim2.new(0.38, -4, 0, 12), T.guard)
	local row = T.new("Frame", {
		Position = UDim2.fromOffset(0, 78),
		Size = UDim2.new(1, 0, 0, 76),
		BackgroundTransparency = 1,
		Parent = bottom,
	})
	T.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	for i = 1, 5 do
		buildSlot(row, i)
	end
	refs.status = T.label({
		Position = UDim2.fromOffset(0, 158),
		Size = UDim2.new(1, 0, 0, 16),
		Text = "",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(255, 200, 200),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		Parent = bottom,
	})
	refs.help = T.label({
		Position = UDim2.fromOffset(-120, 174),
		Size = UDim2.new(1, 240, 0, 14),
		Text = "Q E R F moves · G ultimate (hold 1s at 60+ Heat = Unstable) · LMB basic · RMB guard · Shift dodge · Ctrl modifier · V kit action · Z camera · Tab powers",
		TextSize = 11,
		TextColor3 = T.dim,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.6,
		Parent = bottom,
	})

	-- left gauges: Proxima and Heat
	local gauges = T.new("Frame", {
		Name = "Gauges",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(0.5, -244, 1, -40),
		Size = UDim2.fromOffset(170, 120),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	T.label({ Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 14), Text = "PROXIMA", Font = Enum.Font.GothamBlack, TextSize = 12, TextColor3 = T.proxima, Parent = gauges })
	refs.prox = bar(gauges, "Proxima", UDim2.fromOffset(0, 16), UDim2.new(1, 0, 0, 16), T.proxima)
	marker(refs.prox, 0.6, Color3.fromRGB(255, 240, 120))
	T.label({ Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 14), Text = "HEAT", Font = Enum.Font.GothamBlack, TextSize = 12, TextColor3 = T.heat, Parent = gauges })
	refs.heat = bar(gauges, "Heat", UDim2.fromOffset(0, 54), UDim2.new(1, 0, 0, 16), T.heat)
	marker(refs.heat, 0.6, Color3.fromRGB(255, 200, 80))
	marker(refs.heat, 0.7, Color3.fromRGB(255, 80, 60))
	refs.dodge = T.label({ Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 0, 16), Text = "", Font = Enum.Font.GothamBold, TextSize = 13, Parent = gauges })
	refs.state = T.label({ Position = UDim2.fromOffset(0, 94), Size = UDim2.new(1, 0, 0, 26), Text = "", Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = Color3.fromRGB(255, 120, 80), Parent = gauges })

	-- cast bar
	local cb = T.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.62, 0),
		Size = UDim2.fromOffset(220, 10),
		BackgroundColor3 = Color3.fromRGB(10, 10, 14),
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = gui,
	})
	T.corner(cb, 4)
	refs.castFill = T.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255), Parent = cb })
	T.corner(refs.castFill, 4)
	refs.castBar = cb

	-- crosshair
	refs.cross = T.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = gui,
	})
	T.corner(refs.cross, 3)
	T.stroke(refs.cross, Color3.new(0, 0, 0), 1, 0.3)

	-- notice + feed
	refs.notice = T.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(600, 28),
		Text = "",
		TextSize = 20,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Parent = gui,
	})
	refs.feed = T.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 60),
		Size = UDim2.fromOffset(420, 160),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	T.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = refs.feed })

	-- tooltip
	refs.tip = T.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -210),
		Size = UDim2.fromOffset(460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.bg,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = gui,
	})
	T.corner(refs.tip, 8)
	T.pad(refs.tip, 10)
	refs.tipText = T.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = "", TextSize = 13, RichText = true, Parent = refs.tip })

	-- spectate / respawn label
	refs.dead = T.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(500, 40),
		Text = "",
		TextSize = 30,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		Parent = gui,
	})

	ctx.remotes.Notice.OnClientEvent:Connect(HUD.notice)
	ctx.remotes.Feed.OnClientEvent:Connect(HUD.feed)

	RunService.RenderStepped:Connect(HUD.update)
end

local function setBar(b, value, max, text, overValue)
	local frac = max > 0 and math.clamp(value / max, 0, 1) or 0
	b.fill.Size = UDim2.fromScale(frac, 1)
	b.label.Text = text or ""
	if overValue then
		b.over.Size = UDim2.fromScale(math.clamp(overValue / max, 0, 1), 1)
	end
end

local lastKit
function HUD.update()
	local ch = player.Character
	if not ch or not ch:GetAttribute("FighterId") then
		refs.bottom.Visible = false
		return
	end
	refs.bottom.Visible = true
	local t = now()
	local kitName = ch:GetAttribute("Kit")
	local data = ctx.kitData(kitName)
	if kitName ~= lastKit and data then
		lastKit = kitName
		refs.kitName.Text = string.format("%02d  %s  —  %s", data.num, string.upper(data.name), data.passive.name)
		refs.kitName.TextColor3 = ctx.Util.color(data.name)
		for i = 1, 5 do
			local m = data.moves[i]
			slots[i].name.Text = m.name
			slots[i].cost.Text = m.energy and (tostring(m.energy) .. "E") or ""
		end
	end
	local hp = ch:GetAttribute("Health") or 0
	local maxHp = ch:GetAttribute("MaxHealth") or 1000
	local sh = ch:GetAttribute("Shield") or 0
	setBar(refs.health, hp, maxHp, string.format("%d / %d%s", hp, maxHp, sh > 0 and ("  +" .. sh .. " shield") or ""), sh)
	local energy = ch:GetAttribute("Energy") or 0
	setBar(refs.energy, energy, 100, "Energy " .. energy)
	local guard = ch:GetAttribute("Guard") or 0
	setBar(refs.guard, guard, 100, (ch:GetAttribute("Guarding") and "GUARDING " or "Guard ") .. guard)
	local prox = ch:GetAttribute("Proxima") or 0
	setBar(refs.prox, prox, 100, "P " .. prox .. (prox >= 100 and "  ULT READY" or (prox >= 60 and "  P60" or "")))
	local heat = ch:GetAttribute("Heat") or 0
	setBar(refs.heat, heat, 100, "Heat " .. heat .. (heat >= 70 and "  STRESS" or ""))
	refs.heat.fill.BackgroundColor3 = heat >= 70 and Color3.fromRGB(255, 60, 40) or ctx.Theme.heat
	local dodge = ch:GetAttribute("Dodge") or 0
	refs.dodge.Text = "Dodge " .. string.rep("● ", dodge) .. string.rep("○ ", 2 - dodge)
	local burn = ch:GetAttribute("Burnout") or 0
	local state = ""
	if burn > t then
		state = string.format("BURNOUT %.1fs", burn - t)
	elseif ch:GetAttribute("Rupture") then
		state = "RUPTURE PENDING"
	end
	local hold = ch:GetAttribute("UltHold") or 0
	if hold > 0 then
		state = string.format("UNSTABLE HOLD %d%%", math.clamp((t - hold) / 1 * 100, 0, 100))
	end
	local imm = ch:GetAttribute("CCImmune") or 0
	if imm > t then
		state = state .. (state ~= "" and "  " or "") .. "CC IMMUNE"
	end
	refs.state.Text = state
	refs.kitRes.Text = ch:GetAttribute("KitRes") or ""
	refs.status.Text = ch:GetAttribute("Statuses") or ""
	-- slots
	for i = 1, 5 do
		local s = slots[i]
		local ready = ch:GetAttribute("CD" .. i) or 0
		local len = ch:GetAttribute("CDLen" .. i) or 1
		local rc = ch:GetAttribute("RC" .. i) or 0
		local left = ready - t
		if ready == -1 then
			s.cd.Size = UDim2.fromScale(1, 1)
			s.cdText.Text = "ACTIVE"
			s.cdText.TextSize = 13
		elseif left > 0 then
			s.cd.Size = UDim2.fromScale(1, math.clamp(left / math.max(len, 0.1), 0, 1))
			s.cdText.Text = left >= 10 and tostring(math.ceil(left)) or string.format("%.1f", left)
			s.cdText.TextSize = 22
		else
			s.cd.Size = UDim2.fromScale(1, 0)
			s.cdText.Text = ""
		end
		local m = data and data.moves[i]
		local badge = ""
		local strokeColor, strokeT = Color3.new(1, 1, 1), 0.7
		if rc > t then
			badge = string.format("RECAST %.1f", rc - t)
			strokeColor, strokeT = Color3.fromRGB(120, 255, 160), 0
		elseif i == 5 then
			if prox >= 100 then
				badge = heat >= 60 and "READY · HOLD=UNSTABLE" or "READY"
				strokeColor, strokeT = Color3.fromRGB(255, 220, 90), 0
			else
				badge = "P " .. prox .. "/100"
			end
		elseif prox >= 60 and m and m.p60 then
			badge = "P60"
			strokeColor, strokeT = Color3.fromRGB(255, 240, 120), 0.2
		end
		if m and m.energy and energy < m.energy then
			s.cost.TextColor3 = Color3.fromRGB(255, 90, 90)
		else
			s.cost.TextColor3 = ctx.Theme.energy
		end
		s.badge.Text = badge
		s.stroke.Color = strokeColor
		s.stroke.Transparency = strokeT
	end
	-- cast bar
	local castEnd = ch:GetAttribute("CastEnd") or 0
	local casting = ch:GetAttribute("Casting") or 0
	if casting > 0 and castEnd > t and data then
		local w = data.moves[casting].windup or 0.1
		refs.castBar.Visible = true
		refs.castFill.Size = UDim2.fromScale(math.clamp(1 - (castEnd - t) / math.max(w, 0.05), 0, 1), 1)
	else
		refs.castBar.Visible = false
	end
	-- tooltip
	if refs.tipSlot and data then
		local m = data.moves[refs.tipSlot]
		local txt = string.format("<b>%s</b>  <font color=\"#9aa\">%s</font>\n%s", esc(m.name), esc(m.statline), esc(m.desc))
		if m.p60 then
			txt ..= "\n<font color=\"#ffe680\"><b>P60.</b> " .. esc(m.p60) .. "</font>"
		end
		if m.unstable then
			txt ..= "\n<font color=\"#ff8a50\"><b>Unstable.</b> " .. esc(m.unstable) .. "</font>"
		end
		if m.counterplay then
			txt ..= "\n<font color=\"#9ab\"><i>Counterplay. " .. esc(m.counterplay) .. "</i></font>"
		end
		refs.tipText.Text = txt
		refs.tip.Visible = true
	else
		refs.tip.Visible = false
	end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	refs.dead.Text = (hum and hum.Health <= 0) and "DEFEATED — respawning..." or ""
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000084"><Properties><string name="Name">KitMenu</string><ProtectedString name="Source"><![CDATA[-- In-game compendium: browse and search all 100 powers, read every rule, equip, and change match settings.
local KitMenu = {}

local ctx, T
local root
local listFrame, detail, search
local selected
local buttons = {}

local function esc(s)
	return (string.gsub(string.gsub(string.gsub(s or "", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

local function section(parent, order, title, body, color)
	local f = T.new("Frame", {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.panel2,
		BackgroundTransparency = 0.2,
		LayoutOrder = order,
		Parent = parent,
	})
	T.corner(f, 6)
	T.pad(f, 8)
	T.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3), Parent = f })
	T.label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = title,
		RichText = true,
		Font = Enum.Font.GothamBlack,
		TextSize = 15,
		TextColor3 = color or T.text,
		LayoutOrder = 1,
		Parent = f,
	})
	T.label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = body,
		RichText = true,
		TextSize = 13,
		LayoutOrder = 2,
		Parent = f,
	})
	return f
end

local function showDetail(name)
	selected = name
	for n, b in pairs(buttons) do
		b.stroke.Transparency = n == name and 0 or 0.85
	end
	for _, ch in ipairs(detail:GetChildren()) do
		if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then
			ch:Destroy()
		end
	end
	local d = ctx.kitData(name)
	if not d then
		return
	end
	local col = ctx.Util.color(d.name)
	local hex = string.format("#%02x%02x%02x", math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255))
	section(detail, 1, string.format("<font color=\"%s\">%02d  %s</font>", hex, d.num, esc(string.upper(d.name))), "<i>" .. esc(d.tagline) .. "</i>\n" .. esc(d.identity))
	section(detail, 2, "Passive — " .. esc(d.passive.name), esc(d.passive.text), Color3.fromRGB(255, 225, 160))
	for i = 1, 5 do
		local m = d.moves[i]
		local body = "<font color=\"#8fa0b8\">" .. esc(m.statline) .. "</font>\n" .. esc(m.desc)
		if m.p60 then
			body ..= "\n<font color=\"#ffe680\"><b>P60.</b> " .. esc(m.p60) .. "</font>"
		end
		if m.unstable then
			body ..= "\n<font color=\"#ff8a50\"><b>Unstable mutation.</b> " .. esc(m.unstable) .. "</font>"
		end
		if m.counterplay then
			body ..= "\n<font color=\"#9fb3c8\"><i>Counterplay. " .. esc(m.counterplay) .. "</i></font>"
		end
		local key = ctx.Controls.KEY_LABELS[i]
		section(detail, 2 + i, string.format("[%s] %d  %s%s", key, i, esc(m.name), i == 5 and "  — ULTIMATE" or ""), body, i == 5 and Color3.fromRGB(255, 200, 90) or T.text)
	end
	section(detail, 8, "Mutation rules — " .. esc(d.mutation.name), esc(d.mutation.text), Color3.fromRGB(255, 140, 90))
	if d.sequence then
		section(detail, 9, "Sequence and weakness", esc(d.sequence), T.accent)
	end
	section(detail, 10, "Team interactions — " .. esc(d.team.partners) .. "  (Synergy Mode)", esc(d.team.text), Color3.fromRGB(150, 255, 180))
	detail.CanvasPosition = Vector2.zero
end

local function rebuildList(filter)
	filter = filter and string.lower(filter) or ""
	for _, e in ipairs(ctx.KitIndex) do
		local b = buttons[e.name]
		if b then
			local match = filter == "" or string.find(string.lower(e.name), filter, 1, true) ~= nil or string.find(string.lower(e.tagline), filter, 1, true) ~= nil or tostring(e.num) == filter
			b.button.Visible = match
		end
	end
end

function KitMenu.open()
	root.Visible = true
	ctx.Controls.setMenuOpen(true)
	local ch = ctx.player.Character
	local cur = ch and ch:GetAttribute("Kit") or ctx.player:GetAttribute("Kit")
	showDetail(selected or cur or ctx.KitIndex[1].name)
end

function KitMenu.close()
	root.Visible = false
	ctx.Controls.setMenuOpen(false)
end

function KitMenu.toggle()
	if root.Visible then
		KitMenu.close()
	else
		KitMenu.open()
	end
end

function KitMenu.init(c)
	ctx = c
	T = c.Theme
	root = T.new("Frame", {
		Name = "Compendium",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.86, 0, 0.84, 0),
		BackgroundColor3 = T.bg,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 10,
		Parent = c.gui,
	})
	T.corner(root, 10)
	T.stroke(root, T.accent, 2, 0.5)
	T.new("UISizeConstraint", { MaxSize = Vector2.new(1300, 860), Parent = root })

	-- header
	T.label({
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(0.5, 0, 0, 30),
		Text = "EB: PROXIMA — POWER COMPENDIUM",
		Font = Enum.Font.GothamBlack,
		TextSize = 22,
		TextColor3 = T.accent,
		Parent = root,
	})
	local close = T.button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(34, 30), Text = "X", Parent = root })
	close.Activated:Connect(KitMenu.close)

	-- settings row
	local settings = T.new("Frame", {
		Position = UDim2.new(0, 16, 0, 44),
		Size = UDim2.new(1, -32, 0, 32),
		BackgroundTransparency = 1,
		Parent = root,
	})
	T.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = settings })
	local function toggle(label, attr, key, order)
		local b = T.button({ Size = UDim2.fromOffset(170, 30), Text = "", LayoutOrder = order, Parent = settings })
		local function refresh()
			b.Text = label .. ": " .. (workspace:GetAttribute(attr) and "ON" or "OFF")
			b.BackgroundColor3 = workspace:GetAttribute(attr) and Color3.fromRGB(40, 110, 70) or T.panel2
		end
		refresh()
		workspace:GetAttributeChangedSignal(attr):Connect(refresh)
		b.Activated:Connect(function()
			ctx.remotes.Input:FireServer("setting", key, not workspace:GetAttribute(attr))
		end)
	end
	toggle("Synergy Mode", "Synergy", "synergy", 1)
	toggle("Teams", "Teams", "teams", 2)
	local botsLbl = T.label({ Size = UDim2.fromOffset(110, 30), Text = "", TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, LayoutOrder = 4, Parent = settings })
	local function refreshBots()
		botsLbl.Text = "Bots: " .. tostring(workspace:GetAttribute("BotCount") or 0)
	end
	refreshBots()
	workspace:GetAttributeChangedSignal("BotCount"):Connect(refreshBots)
	local minus = T.button({ Size = UDim2.fromOffset(34, 30), Text = "-", LayoutOrder = 3, Parent = settings })
	local plus = T.button({ Size = UDim2.fromOffset(34, 30), Text = "+", LayoutOrder = 5, Parent = settings })
	minus.Activated:Connect(function()
		ctx.remotes.Input:FireServer("setting", "bots", (workspace:GetAttribute("BotCount") or 0) - 1)
	end)
	plus.Activated:Connect(function()
		ctx.remotes.Input:FireServer("setting", "bots", (workspace:GetAttribute("BotCount") or 0) + 1)
	end)
	local equip = T.button({
		Size = UDim2.fromOffset(200, 30),
		Text = "EQUIP SELECTED POWER",
		BackgroundColor3 = Color3.fromRGB(50, 120, 220),
		LayoutOrder = 6,
		Parent = settings,
	})
	equip.Activated:Connect(function()
		if selected then
			ctx.remotes.Input:FireServer("selectKit", selected)
			KitMenu.close()
		end
	end)
	local botBtn = T.button({ Size = UDim2.fromOffset(170, 30), Text = "Spawn bot with it", LayoutOrder = 7, Parent = settings })
	botBtn.Activated:Connect(function()
		if selected then
			ctx.remotes.Input:FireServer("setting", "botKit", selected)
		end
	end)

	-- list
	search = T.new("TextBox", {
		Position = UDim2.new(0, 16, 0, 84),
		Size = UDim2.new(0.3, -16, 0, 30),
		BackgroundColor3 = T.panel2,
		PlaceholderText = "Search powers (name, number, theme)...",
		Text = "",
		TextColor3 = T.text,
		PlaceholderColor3 = T.dim,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		ClearTextOnFocus = false,
		Parent = root,
	})
	T.corner(search, 6)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		rebuildList(search.Text)
	end)
	listFrame = T.new("ScrollingFrame", {
		Position = UDim2.new(0, 16, 0, 120),
		Size = UDim2.new(0.3, -16, 1, -136),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = root,
	})
	T.new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -6, 0, 34),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = listFrame,
	})
	for _, e in ipairs(c.KitIndex) do
		local col = c.Util.color(e.name)
		local b = T.button({
			Text = "",
			BackgroundColor3 = T.panel,
			LayoutOrder = e.num,
			Parent = listFrame,
		})
		local stroke = T.stroke(b, col, 2, 0.85)
		T.new("Frame", { Position = UDim2.fromOffset(4, 4), Size = UDim2.new(0, 6, 1, -8), BackgroundColor3 = col, Parent = b })
		T.label({
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -20, 1, 0),
			Text = string.format("%02d  %s", e.num, e.name),
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = b,
		})
		b.Activated:Connect(function()
			showDetail(e.name)
		end)
		buttons[e.name] = { button = b, stroke = stroke }
	end

	-- detail
	detail = T.new("ScrollingFrame", {
		Position = UDim2.new(0.3, 8, 0, 84),
		Size = UDim2.new(0.7, -24, 1, -100),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		Parent = root,
	})
	T.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = detail })
end

return KitMenu
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000085"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- EB: Proxima — client bootstrap.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Client = script.Parent

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local ctx = {
	player = player,
	remotes = {
		Input = remotes:WaitForChild("Input"),
		Aim = remotes:WaitForChild("Aim"),
		Pop = remotes:WaitForChild("Pop"),
		Notice = remotes:WaitForChild("Notice"),
		Feed = remotes:WaitForChild("Feed"),
	},
	Config = require(Shared:WaitForChild("Config")),
	Util = require(Shared:WaitForChild("Util")),
	KitIndex = require(Shared:WaitForChild("KitIndex")),
	KitData = Shared:WaitForChild("KitData"),
}

local dataCache = {}
function ctx.kitData(name)
	if not name then
		return nil
	end
	local id = string.gsub(name, "[^%w]", "")
	if dataCache[id] == nil then
		local m = ctx.KitData:FindFirstChild(id)
		dataCache[id] = m and require(m) or false
	end
	return dataCache[id] or nil
end

local gui = Instance.new("ScreenGui")
gui.Name = "EBProxima"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
ctx.gui = gui

local Theme = require(Client:WaitForChild("Theme"))
ctx.Theme = Theme

local HUD = require(Client:WaitForChild("HUD"))
local KitMenu = require(Client:WaitForChild("KitMenu"))
local Popups = require(Client:WaitForChild("Popups"))
local Controls = require(Client:WaitForChild("Controls"))

ctx.HUD = HUD
ctx.KitMenu = KitMenu
ctx.Popups = Popups
ctx.Controls = Controls

Popups.init(ctx)
HUD.init(ctx)
KitMenu.init(ctx)
Controls.init(ctx)

-- open the compendium on first join
task.delay(1, function()
	KitMenu.open()
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000086"><Properties><string name="Name">Popups</string><ProtectedString name="Source"><![CDATA[-- Floating combat numbers and status words (client-local, never block tactical information).
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Popups = {}

local folder

function Popups.show(pos, text, color, kind)
	if typeof(pos) ~= "Vector3" then
		return
	end
	local cam = workspace.CurrentCamera
	if (cam.CFrame.Position - pos).Magnitude > 140 then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(pos + Vector3.new(math.random(-15, 15) / 10, 2.5, math.random(-15, 15) / 10))
	anchor.Parent = folder
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, kind == "info" and 26 or 30)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Adornee = anchor
	bb.Parent = anchor
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Text = tostring(text)
	lbl.TextColor3 = typeof(color) == "Color3" and color or Color3.new(1, 1, 1)
	lbl.TextStrokeTransparency = 0.2
	lbl.Parent = bb
	if kind == "dot" or kind == "field" then
		bb.Size = UDim2.fromOffset(110, 20)
	end
	TweenService:Create(anchor, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = anchor.CFrame + Vector3.new(0, 3, 0),
	}):Play()
	task.delay(0.5, function()
		TweenService:Create(lbl, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	Debris:AddItem(anchor, 1)
end

function Popups.init(ctx)
	folder = Instance.new("Folder")
	folder.Name = "EBPopups"
	folder.Parent = workspace.CurrentCamera
	ctx.remotes.Pop.OnClientEvent:Connect(Popups.show)
end

return Popups
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000087"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[-- UI helpers and palette.
local Theme = {}

Theme.bg = Color3.fromRGB(18, 20, 28)
Theme.panel = Color3.fromRGB(28, 31, 42)
Theme.panel2 = Color3.fromRGB(38, 42, 56)
Theme.text = Color3.fromRGB(236, 238, 245)
Theme.dim = Color3.fromRGB(160, 165, 182)
Theme.accent = Color3.fromRGB(110, 190, 255)
Theme.health = Color3.fromRGB(90, 220, 110)
Theme.shield = Color3.fromRGB(140, 200, 255)
Theme.energy = Color3.fromRGB(80, 200, 255)
Theme.heat = Color3.fromRGB(255, 120, 50)
Theme.proxima = Color3.fromRGB(200, 120, 255)
Theme.guard = Color3.fromRGB(230, 230, 160)

function Theme.new(class, props, children)
	local o = Instance.new(class)
	if class == "Frame" or class == "TextLabel" or class == "TextButton" or class == "ScrollingFrame" or class == "TextBox" or class == "ImageLabel" then
		o.BorderSizePixel = 0
	end
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, ch in ipairs(children or {}) do
		ch.Parent = o
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end

function Theme.corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = parent
	return c
end

function Theme.stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(1, 1, 1)
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.6
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function Theme.pad(parent, px)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.Parent = parent
	return p
end

function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextColor3 = Theme.text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return Theme.new("TextLabel", defaults)
end

function Theme.button(props)
	local defaults = {
		BackgroundColor3 = Theme.panel2,
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.text,
		TextSize = 14,
		AutoButtonColor = true,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local b = Theme.new("TextButton", defaults)
	Theme.corner(b, 6)
	return b
end

return Theme
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBX00000089"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="Script" referent="RBX0000008A"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default health-regeneration script. EB: Proxima health is fully server-controlled;
-- ordinary healing only comes from abilities.
]]></ProtectedString></Properties></Item></Item></Item>
