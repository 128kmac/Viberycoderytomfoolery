	passive = { name = "Balance Dial", text = "Start at zero on a dial from minus three to plus three. Yin abilities move it one step negative; Yang abilities move it one positive. Crossing through zero after using both stances grants 40 shield, at most once every 5 seconds. Remaining at an extreme grants no bonus." },
