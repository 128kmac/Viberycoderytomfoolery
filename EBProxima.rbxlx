			statline = "CD 12 s | E 19 | H 6 | W 0.25 s | R self",
			desc = "Change stance while stepping 4 metres. It does not move the dial by itself, so repeated switching cannot farm the balance shield. The step follows normal collision and offers no invulnerability.",
			p60 = "Permits choosing a curved step around one visible obstacle edge.",
			counterplay = "Track the step and punish the stance you know will follow.",
		},
		{
