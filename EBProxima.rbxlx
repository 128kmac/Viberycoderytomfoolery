			rangeText = "18 m",
			statline = "CD 6 s | E 14 | H 4 | W 0.3 s | R 18 m",
			desc = "Launch a thin pressure crescent for 70 damage. Its visible wake shows travel direction. It stops at solid terrain and does not cut through an unlimited number of enemies or structures.",
			p60 = "Increases projectile width by 0.3 metres.",
			counterplay = "Move perpendicular to its path or block the single impact.",
