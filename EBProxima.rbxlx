<Item class="ReplicatedStorage" referent="RBX0000006C"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000006B"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!nocheck
-- EB: Proxima — shared combat constants (values from the Ability Compendium "Combat foundation").
-- All gameplay distances in the compendium are metres; METRE converts them to studs.

local Config = {}

Config.METRE = 3 -- studs per metre

-- Health / resources
Config.MAX_HEALTH = 1000
Config.MAX_ENERGY = 100
Config.ENERGY_REGEN = 12 -- per second
Config.ENERGY_REGEN_DELAY = 1.25
Config.MAX_HEAT = 100
Config.HEAT_COOL = 8 -- per second
Config.HEAT_COOL_DELAY = 1.25
Config.HEAT_STRESS = 70
Config.MAX_PROXIMA = 100
Config.P60 = 60
Config.P60_EXTRA_HEAT = 6
Config.ULT_HEAT = 30
Config.UNSTABLE_MIN_HEAT = 60
Config.UNSTABLE_HOLD = 1.0
Config.UNSTABLE_EXTRA_HEAT = 40
Config.BURNOUT_TIME = 3
Config.BURNOUT_END_HEAT = 40

-- Proxima gain / loss
Config.CONTEST_WINDOW = 4
Config.P_NEAR_RANGE = 6 -- metres
Config.P_NEAR_RATE = 4
Config.P_FAR_RANGE = 12
Config.P_FAR_RATE = 2
Config.P_HIT_GAIN = 3
Config.P_PERFECT_GUARD_GAIN = 5
Config.P_PERFECT_GUARD_ICD = 2
Config.P_SUPPORT_GAIN = 3
Config.P_MAX_PER_SECOND = 10
Config.P_DECAY_DELAY = 3
Config.P_DECAY_RATE = 6

-- Movement (metres / second)
Config.RUN_SPEED = 6
Config.JUMP_HEIGHT = 2
Config.MAX_SLOW = 0.40
Config.MAX_SPEED_BONUS = 0.25

-- Basic attack
Config.BASIC_RANGE = 2.5
Config.BASIC_DAMAGE = 60
Config.BASIC_INTERVAL = 0.65
Config.BASIC_ARC = 100

-- Dodge
Config.DODGE_CHARGES = 2
Config.DODGE_DISTANCE = 5
Config.DODGE_TIME = 0.3
Config.DODGE_RECHARGE = 5
Config.DODGE_IFRAME_START = 0.06
Config.DODGE_IFRAME_LEN = 0.12

-- Guard
Config.MAX_GUARD = 100
Config.GUARD_REDUCTION = 0.70
Config.GUARD_ARC = 120
Config.GUARD_DRAIN = 4
Config.GUARD_HIT_DRAIN = 0.20
Config.GUARD_RECOVER_DELAY = 1.5
Config.GUARD_RECOVER = 20
Config.GUARD_BREAK_TIME = 0.7
Config.GUARD_BREAK_RETURN = 30
Config.PERFECT_GUARD_WINDOW = 0.2
Config.PERFECT_GUARD_REDUCTION = 0.90
Config.MAX_COMBINED_REDUCTION = 0.85
Config.GUARD_MOVE_MULT = 0.75

-- Casting
Config.DEFAULT_RECOVERY = 0.35
Config.MOVE_RECOVERY = 0.25
Config.ULT_INTERRUPT_REFUND_P = 50
Config.ULT_INTERRUPT_CD = 20

-- Protection / healing / control
Config.MAX_SHIELD = 400
Config.HEAL_CAP_PER_SECOND = 250
Config.MAX_REINFORCE_LAYERS = 2
Config.MAX_REINFORCE = 100
Config.CONTROL_BUDGET = 2
Config.CONTROL_WINDOW = 6
Config.CONTROL_IMMUNITY = 2

-- Projectiles / objects
Config.PROJ_SPEED = 24
Config.PROJ_WIDTH = 0.3
Config.FIELD_TICK = 1
Config.OBJECT_DURABILITY = 100
Config.OBJECT_LIFETIME = 6
Config.MAX_OBJECTS_PER_CASTER = 8
Config.SUMMON_SPEED = 6

-- Out of bounds
Config.OOB_PENALTY = 150
Config.OOB_LOCK = 1

-- Match
Config.RESPAWN_TIME = 4
Config.SPAWN_PROTECTION = 2.5
Config.DEFAULT_KIT = "Acid"
Config.DUMMIES_COUNT_AS_REAL = true -- training dummies and bots can feed Proxima for practice
Config.START_SYNERGY = true
Config.MAX_BOTS = 8

-- Body hitbox (studs)
Config.BODY_RADIUS = 1.5
Config.BODY_DOWN = 2.6
Config.BODY_UP = 2.0

return Config
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000068"><Properties><string name="Name">KitData</string></Properties><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Acid</string><ProtectedString name="Source"><![CDATA[-- AUTO-GENERATED from the EB: Proxima Ability Compendium by tools/gen_kitdata.py. Do not edit by hand.
return {
	num = 1,
	name = "Acid",
	id = "Acid",
	tagline = "Armor erosion and corrosive lanes",
	identity = "Acid removes protection and changes surfaces. It does not apply Poison's internal damage stacks; its threat is exposure to the next attack.",
	passive = { name = "Etched Weakness", text = "Direct ability hits add one Corrosion stack for 6 seconds, maximum three. Each removes 4 percentage points of damage reduction, never below zero. At three, shields take 25% extra damage from Acid. Cleansing removes one stack per use." },
	moves = {
		{
			slot = 1,
			name = "Vitriol Needle",
			cd = 6,
			energy = 12,
			heat = 5,
			windup = 0.25,
			range = 20,
			rangeText = "20 m",
			statline = "CD 6 s | E 12 | H 5 | W 0.25 s | R 20 m",
			desc = "A thin lime needle travels at 24 m/s, dealing 70 damage and one Corrosion. Hitting a construct instead erodes 100 durability; it stops at the first solid obstacle.",
			p60 = "Adds a second Corrosion on a shield hit, not a second damage packet.",
			counterplay = "Sidestep the narrow line or use disposable cover.",
		},
		{
			slot = 2,
			name = "Solvent Ribbon",
			cd = 11,
			energy = 20,
			heat = 9,
			windup = 0.5,
			range = 14,
			rangeText = "14 m",
			statline = "CD 11 s | E 20 | H 9 | W 0.5 s | R 14 m",
			desc = "Sweep a 1.5-metre-wide ribbon across the floor. It lasts 5 seconds, dealing 20 damage each second of contact and removing a stack of hardened terrain reinforcement per tick.",
			p60 = "Permits one curved segment around a visible corner.",
			counterplay = "Jump across; flying targets are unaffected.",
		},
		{
			slot = 3,
			name = "Caustic Shed",
			cd = 16,
			energy = 18,
			heat = 6,
			windup = 0.15,
			range = 0,
			rangeText = "self",
			statline = "CD 16 s | E 18 | H 6 | W 0.15 s | R self",
			desc = "Peel away a transparent acidic shell, cleansing one movement slow and leaving a 120-durability decoy for 3 seconds. Destroying it splashes 45 damage within 2 metres; the caster retreats 3 metres.",
			p60 = "Lets the shell absorb one Corrosion stack from its owner.",
			counterplay = "Avoid breaking the shell at melee range.",
		},
		{
			slot = 4,
			name = "Dissolution Brand",
			cd = 18,
			energy = 25,
			heat = 12,
			windup = 0.65,
			range = 12,
			rangeText = "12 m",
			statline = "CD 18 s | E 25 | H 12 | W 0.65 s | R 12 m",
			desc = "Stamp a visible triangular brand for 5 seconds. The next shield created by that enemy loses 100 durability immediately; otherwise the brand expires in a 90-damage burst. Only one brand may exist.",
			p60 = "Makes its expiry leave a 2-metre acid pool for 3 seconds.",
			counterplay = "Cleanse the brand or spend a small shield to discharge it.",
		},
		{
			slot = 5,
			name = "Basilisk Rain",
			cd = 85,
			energy = 35,
			heat = 30,
			windup = 1.2,
			range = 24,
			rangeText = "24 m",
			statline = "CD 85 s | E 35 | H 30 | W 1.2 s | R 24 m | P 100",
			desc = "Mark an 8-metre-radius zone. Three concentric rain rings strike over 3 seconds for 90 each, outside inward. Breakable cover loses 150 durability per ring. Gaps rotate between rings and remain visibly marked.",
			p60 = nil,
			counterplay = "Move through the ring gaps; overhead cover buys one ring.",
			unstable = "Replaces the final ring with a moving 120-damage acid wave; the caster is also vulnerable to that wave.",
		},
	},
	mutation = { name = "Universal Solvent", text = "After the unstable wave, all Acid pools become neutral for 4 seconds and can hurt the caster. Rupture also removes the caster's protective shell; there is no blanket Acid immunity during recovery." },
	sequence = "Lay Ribbon across the shortest retreat, Brand a shield user, then fire Needle when they cross. Caustic Shed is the only immediate escape; baiting it makes the stationary ultimate vulnerable.",
	team = { partners = "Steel and Water", text = "Steel filings in Ribbon become a brittle corrosive mesh that slows by 20% for 2 seconds. Water clears half a pool's remaining duration and creates a non-damaging diluted slick; it never amplifies Acid damage." },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Agility</string><ProtectedString name="Source"><![CDATA[-- AUTO-GENERATED from the EB: Proxima Ability Compendium by tools/gen_kitdata.py. Do not edit by hand.
return {
	num = 2,
	name = "Agility",
	id = "Agility",
	tagline = "Footwork and evasive punishment",
	identity = "Agility rewards clean movement and whiff punishment. It has no teleports, flight, or passive damage amplification and cannot escape a properly timed root.",
	passive = { name = "Unbroken Stride", text = "Moving continuously for 2 seconds grants one Stride, maximum three. A dodge through a hostile hitbox grants another. Each Stride adds 3% running speed. Taking a hard-control effect removes all stacks; standing still drains one per second." },
	moves = {
		{
			slot = 1,
			name = "Needle Step",
			cd = 5,
			energy = 10,
			heat = 4,
			windup = 0.12,
			range = 5,
			rangeText = "5 m",
			statline = "CD 5 s | E 10 | H 4 | W 0.12 s | R 5 m",
			desc = "Lunge 5 metres and strike for 65 damage. Aim can rotate only 30 degrees after commitment. Spending one Stride extends the lunge by 2 metres but adds 0.2 seconds of recovery.",
			p60 = "Allows a 1-metre sidestep after a confirmed hit.",
			counterplay = "Hold the endpoint rather than chasing the dash trail.",
		},
		{
			slot = 2,
			name = "Wall Waltz",
			cd = 10,
			energy = 15,
			heat = 5,
			windup = 0.2,
			range = 8,
			rangeText = "8 m",
			statline = "CD 10 s | E 15 | H 5 | W 0.2 s | R 8 m",
			desc = "Run along a solid wall for up to 2 seconds, then vault away. A descending kick deals 85 damage. Destroying the wall forces a fall; the user cannot attack during the run.",
			p60 = "Allows one transfer to another wall within 3 metres.",
			counterplay = "Remove the supporting wall or aim at the landing marker.",
		},
		{
			slot = 3,
			name = "Borrowed Opening",
			cd = 14,
			energy = 18,
			heat = 7,
			windup = 0.1,
			range = 4,
			rangeText = "4 m",
			statline = "CD 14 s | E 18 | H 7 | W 0.1 s | R 4 m",
			desc = "Assume a low stance for 0.5 seconds. If a melee strike misses within 2 metres, instantly circle its attacker and deal 100 damage. Projectiles and grabs do not trigger the response.",
			p60 = "Refunds one Stride on success.",
			counterplay = "Delay the strike or use a grab.",
		},
		{
			slot = 4,
			name = "Redline Route",
			cd = 18,
			energy = 22,
			heat = 10,
			windup = 0.4,
			range = 16,
			rangeText = "16 m",
			statline = "CD 18 s | E 22 | H 10 | W 0.4 s | R 16 m",
			desc = "Place three visible waypoints within a 16-metre path. Recast within 4 seconds to dash between them, dealing 35 damage per crossed enemy per segment. A target can take at most two segments.",
			p60 = "Allows moving the final waypoint before recasting.",
			counterplay = "Trap a waypoint or force the user away from the start.",
		},
		{
			slot = 5,
			name = "Frame Perfect",
			cd = 75,
			energy = 30,
			heat = 30,
			windup = 0.8,
			range = 0,
			rangeText = "self",
			statline = "CD 75 s | E 30 | H 30 | W 0.8 s | R self | P 100",
			desc = "For 6 seconds, successful evades store up to four counterstrikes. Recast ends the stance and spends them as 60-damage lunges toward visible enemies within 10 metres. Missing lunges still consume charges.",
			p60 = nil,
			counterplay = "Stop feeding attacks, spread out, or block the final approach.",
			unstable = "Doubles lunge travel speed but removes steering and defensive dodge frames during the execution.",
		},
	},
	mutation = { name = "Impossible Footwork", text = "The unstable sequence leaves the user exhausted at its last endpoint. It grants no invulnerability between strikes; an opponent who predicts the route can interrupt the entire release." },
	sequence = "Use Wall Waltz to change approach height, Needle Step to provoke a swing, then Borrowed Opening. Agility loses value in open spaces without walls and against lingering hazards rather than discrete attacks.",
	team = { partners = "Wind and Thread", text = "Wind lanes extend Wall Waltz's exit by 2 metres without extra damage. Friendly Thread can supply one temporary wall-run line, but cutting it immediately ends the traverse." },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Alchemist</string><ProtectedString name="Source"><![CDATA[-- AUTO-GENERATED from the EB: Proxima Ability Compendium by tools/gen_kitdata.py. Do not edit by hand.
return {
	num = 3,
	name = "Alchemist",
	id = "Alchemist",
	tagline = "Reagent combinations and deliberate conversion",
	identity = "Alchemist crafts fixed reactions from three reagents. Recipes are visible and deterministic; this is controlled chemistry fantasy, not unrestricted Creation or random Magic.",
	passive = { name = "Three Reagents", text = "Carry three reagent charges: Salt, Sulfur, and Mercury. The first three normal abilities consume one chosen reagent; Quick Distillation consumes none. An empty slot refills after 7 seconds. Repeating a reagent adds 4 Heat; alternating all three refunds 10 Energy once per cycle." },
	moves = {
		{
			slot = 1,
			name = "Retort Flask",
			cd = 7,
			energy = 12,
			heat = 5,
			windup = 0.3,
			range = 18,
			rangeText = "18 m",
			statline = "CD 7 s | E 12 | H 5 | W 0.3 s | R 18 m",
			desc = "Throw a flask in an arc for 55 impact damage. Salt roots for 0.4 seconds; Sulfur adds 30 burn over 3 seconds; Mercury slides the target 2 metres. The selected color remains visible in flight.",
			p60 = "Refunds the reagent if the flask intercepts a projectile.",
			counterplay = "Break line of sight or dodge after reading the flask color.",
		},
		{
			slot = 2,
			name = "Equivalent Exchange",
			cd = 13,
			energy = 20,
			heat = 8,
			windup = 0.6,
			range = 10,
			rangeText = "10 m",
			statline = "CD 13 s | E 20 | H 8 | W 0.6 s | R 10 m",
			desc = "Convert one nonliving construct below 180 durability into a 120-durability wall, 80-point shield, or 60-health restorative pickup. Ownership must be friendly or neutral; hostile structures must first be broken.",
			p60 = "Lets the pickup be thrown 8 metres.",
			counterplay = "Destroy the offered material before conversion completes.",
		},
		{
			slot = 3,
			name = "Catalyst Circle",
			cd = 18,
			energy = 24,
			heat = 10,
			windup = 0.5,
			range = 14,
			rangeText = "14 m",
			statline = "CD 18 s | E 24 | H 10 | W 0.5 s | R 14 m",
			desc = "A 4-metre circle lasts 6 seconds. The next two flasks landing inside react: Salt plus Sulfur deals 120 burst; Salt plus Mercury creates 100-durability cover; Sulfur plus Mercury pushes enemies 4 metres.",
			p60 = "Preserves the circle after its first completed reaction.",
			counterplay = "Leave the circle or attack its 100-durability chalk anchor.",
		},
		{
			slot = 4,
			name = "Quick Distillation",
			cd = 20,
			energy = 10,
			heat = 4,
			windup = 0.75,
			range = 0,
			rangeText = "self",
			statline = "CD 20 s | E 10 | H 4 | W 0.75 s | R self",
			desc = "Channel to refill one missing reagent and remove one removable damage-over-time effect. Each remaining tick removed grants 3 Energy, maximum 15. Moving cancels the channel without refunding its initial cost.",
			p60 = "Lets a nearby ally within 3 metres receive the cleanse instead.",
			counterplay = "Pressure during the channel; it is not a panic invulnerability.",
		},
		{
			slot = 5,
			name = "Magnum Opus",
			cd = 90,
			energy = 40,
			heat = 30,
			windup = 1.3,
			range = 18,
			rangeText = "18 m",
			statline = "CD 90 s | E 40 | H 30 | W 1.3 s | R 18 m | P 100",
			desc = "Create a 7-metre reaction circle with three 120-durability vessels. Salt pins, Mercury draws inward, and Sulfur detonates after 3 seconds for 260 damage. Each destroyed vessel removes its associated stage.",
			p60 = nil,
			counterplay = "Destroy Sulfur to remove the main burst, or escape through a broken vessel's sector.",
			unstable = "Doubles the circle duration and permits a second 160-damage detonation, but vessels then become neutral explosives.",
		},
	},
	mutation = { name = "Philosopher Reaction", text = "The unstable second blast damages every unit including the Alchemist. No recipe produces permanent currency, restores Proxima, duplicates ultimates, or converts player bodies." },
	sequence = "Salt Flask supplies a brief setup window for Catalyst Circle. Exchange creates protection for Distillation. Fast enemies that keep relocating can deny the slow two-flask reaction without needing a specific element.",
	team = { partners = "Gold and Mud", text = "Gold constructs yield 30 additional shield points through Exchange, once per construct. Mud in Catalyst Circle replaces Mercury's pull with a 25% slow but cannot add another damage stage." },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Angel</string><ProtectedString name="Source"><![CDATA[-- AUTO-GENERATED from the EB: Proxima Ability Compendium by tools/gen_kitdata.py. Do not edit by hand.
return {
	num = 4,
	name = "Angel",
	id = "Angel",
	tagline = "Aerial rescue and protective judgment",
	identity = "Angel uses wings, sanctuary, and interception. Its signature is saving a teammate at personal risk; offensive power depends on proximity to threatened allies.",
	passive = { name = "Witness", text = "Preventing 60 damage to an ally grants one Grace, maximum three, lasting 10 seconds. Spending Grace adds 20 shield to the next rescue ability. Self-protection, environmental damage, and friendly damage cannot farm Grace." },
	moves = {
		{
			slot = 1,
			name = "Feather Verdict",
			cd = 6,
			energy = 12,
			heat = 5,
			windup = 0.3,
			range = 22,
			rangeText = "22 m",
			statline = "CD 6 s | E 12 | H 5 | W 0.3 s | R 22 m",
			desc = "Release three white feathers in a narrow fan, each dealing 25 damage. Feathers crossing an ally restore 10 health instead and then disappear. A single unit can receive all three.",
			p60 = "Lets one missed feather return to heal the caster for 15.",
			counterplay = "Spread laterally; feathers do not bend around cover.",
		},
		{
			slot = 2,
			name = "Mercy Descent",
			cd = 14,
			energy = 20,
			heat = 7,
			windup = 0.35,
			range = 12,
			rangeText = "12 m",
			statline = "CD 14 s | E 20 | H 7 | W 0.35 s | R 12 m",
			desc = "Glide to a visible ally or ground point and open a 140-point shield over both for 2 seconds. Landing deals no damage. A hostile hit can knock the user out of the approach.",
			p60 = "Cleanses one slow from the protected ally.",
			counterplay = "Interrupt the glide or wait out the short shield.",
		},
		{
			slot = 3,
			name = "Sanctuary Wing",
			cd = 17,
			energy = 24,
			heat = 9,
			windup = 0.45,
			range = 4,
			rangeText = "4 m",
			statline = "CD 17 s | E 24 | H 9 | W 0.45 s | R 4 m",
			desc = "Plant one wing as a frontal 240-durability barrier for 4 seconds. Allies may pass through. The Angel moves at half speed and cannot cast Feather Verdict while maintaining it.",
			p60 = "Stores 20% blocked damage, maximum 60, as healing on release.",
			counterplay = "Flank the wing or force the Angel to turn.",
		},
		{
			slot = 4,
			name = "Ascension Bell",
			cd = 20,
			energy = 25,
			heat = 12,
			windup = 0.7,
			range = 14,
			rangeText = "14 m",
			statline = "CD 20 s | E 25 | H 12 | W 0.7 s | R 14 m",
			desc = "A bell marks a 3-metre circle for 0.8 seconds, then lifts enemies 2 metres and deals 95 damage. Allies in the circle gain a single high jump rather than being forcibly moved.",
			p60 = "Allows one airborne enemy to be nudged 2 metres sideways.",
			counterplay = "Step outside the bell outline before it rings.",
		},
		{
			slot = 5,
			name = "Choir of Return",
			cd = 90,
			energy = 40,
			heat = 30,
			windup = 1.4,
			range = 18,
			rangeText = "18 m",
			statline = "CD 90 s | E 40 | H 30 | W 1.4 s | R 18 m | P 100",
			desc = "Four pillars surround a 7-metre sanctuary for 6 seconds. Each second heals allies for 20 and deals 25 to enemies. Recast ends it with a 120-point allied shield; destroying two pillars ends it early.",
			p60 = nil,
			counterplay = "Attack pillars or isolate the Angel outside the sanctuary.",
			unstable = "Transfers up to 200 incoming allied damage to the Angel while doubling the final shield; transferred damage cannot be reduced.",
		},
	},
	mutation = { name = "Seraphic Burden", text = "The unstable rescue can defeat its caster. It does not resurrect eliminated players. Visual wings and choir rings must never hide opponents or replace the player's camera." },
	sequence = "Use Wing to earn Grace, then Descent to rescue a second ally. Bell protects the retreat. Angel's self-healing is modest; split pressure forces hard choices about whom to defend.",
	team = { partners = "Light and Sound", text = "Light beams through Wing gain 2 metres of range but consume 30 barrier durability. Sound can carry the Bell cue farther for allies, granting a 10% movement buff for 2 seconds instead of extra control." },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Animal</string><ProtectedString name="Source"><![CDATA[-- AUTO-GENERATED from the EB: Proxima Ability Compendium by tools/gen_kitdata.py. Do not edit by hand.
return {
	num = 5,
	name = "Animal",
	id = "Animal",
	tagline = "Companion commands and shared positioning",
	identity = "Animal fights alongside one trained companion. Unlike Beast, the player does not transform; damage and scouting are divided between two vulnerable bodies.",
	passive = { name = "Pack Bond", text = "Choose Hound, Hawk, or Boar at spawn. The companion has 220 health and a 20-metre leash. Defeat disables commands for 12 seconds; resummoning costs 20 Energy. It reveals targets only through actual vision." },
	moves = {
		{
			slot = 1,
			name = "Sic",
			cd = 6,
			energy = 12,
			heat = 4,
			windup = 0.2,
			range = 18,
			rangeText = "18 m",
			statline = "CD 6 s | E 12 | H 4 | W 0.2 s | R 18 m",
			desc = "Order the companion to attack for 70 damage. Hound tracks the last visible path; Hawk dives above low cover; Boar pushes 1.5 metres. None tracks an unseen target after 1 second.",
			p60 = "Grants the player 10% speed toward the attacked enemy for 2 seconds.",
			counterplay = "Intercept the companion or break its approach path.",
		},
		{
			slot = 2,
			name = "Recall Leap",
			cd = 11,
			energy = 16,
			heat = 6,
			windup = 0.15,
			range = 20,
			rangeText = "20 m",
			statline = "CD 11 s | E 16 | H 6 | W 0.15 s | R 20 m",
			desc = "Recall the companion immediately and vault 4 metres away from its arrival point. The return path is harmless. If it is rooted, the vault fails but the ability's cooldown is halved.",
			p60 = "Grants the companion an 80-point shield during recall.",
			counterplay = "Root the companion before recall or pressure the player separately.",
		},
		{
			slot = 3,
			name = "Territorial Call",
			cd = 16,
			energy = 22,
			heat = 8,
			windup = 0.5,
			range = 16,
			rangeText = "16 m",
			statline = "CD 16 s | E 22 | H 8 | W 0.5 s | R 16 m",
			desc = "Place a 5-metre patrol circle for 7 seconds. The companion attacks intruders once per 2 seconds for 35 damage and reveals their footprints for 1 second. It still needs line of sight.",
			p60 = "Extends patrol to a second adjacent circle with no faster attacks.",
			counterplay = "Destroy or lure away the companion; circles are not walls.",
		},
		{
			slot = 4,
			name = "Shared Instinct",
			cd = 20,
			energy = 25,
			heat = 10,
			windup = 0.4,
			range = 15,
