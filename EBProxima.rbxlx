			statline = "CD 22 s | E 26 | H 10 | W 0.8 s | R self",
			desc = "Return the dial to zero. From a negative value, gain 25 healing per step erased; from a positive value, send a 3-metre ring for 25 damage per step erased. Casting at zero is unavailable. This reset does not trigger Balance Dial's shield.",
			p60 = "Removes one minor slow when at least two steps are erased.",
			counterplay = "Interrupt the deliberate recentering or stay outside the short offensive ring.",
		},
		{
			slot = 5,
			name = "Whole of the Turning World",
