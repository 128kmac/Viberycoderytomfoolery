			cd = 12,
			energy = 19,
			heat = 6,
			windup = 0.2,
			range = 0,
			rangeText = "self",
			statline = "CD 12 s | E 19 | H 6 | W 0.2 s | R self",
			desc = "Dash 6 metres along a chosen horizontal direction. You can use it in the air once before landing; it adds no upward velocity and grants no invulnerability. Collision stops the movement.",
			p60 = "Lets the dash clear one minor slow.",
			counterplay = "Aim at the landing route or force the dash toward an obstructed lane.",
		},
		{
			slot = 3,
			name = "Updraft Pillar",
			cd = 17,
			energy = 24,
			heat = 8,
			windup = 0.7,
			range = 14,
			rangeText = "14 m",
			statline = "CD 17 s | E 24 | H 8 | W 0.7 s | R 14 m",
			desc = "Create a 3-metre pillar for 4 seconds. Willing allies can ride it up 4 metres once; enemies receive a single 0.5-second lift and 50 damage on first entry. Its top does not trap anyone.",
			p60 = "Grants allies a 1-second slow fall when leaving.",
			counterplay = "Avoid the visible pillar or attack riders from outside it.",
		},
		{
			slot = 4,
			name = "Crosswind",
			cd = 21,
			energy = 26,
			heat = 10,
			windup = 0.6,
			range = 16,
			rangeText = "16 m",
			statline = "CD 21 s | E 26 | H 10 | W 0.6 s | R 16 m",
			desc = "A 6-metre lateral gust deals 85 damage and pushes 2 metres. It redirects up to two ordinary projectiles by 30 degrees, preserving owner, damage, and remaining range. It cannot reflect them directly back.",
			p60 = "Increases the projectile allowance to three.",
			counterplay = "Use beams, wait out the gust, or attack along its side rather than into it.",
		},
		{
			slot = 5,
			name = "Eye of the Gale",
			cd = 90,
			energy = 40,
			heat = 30,
			windup = 1.3,
			range = 18,
			rangeText = "18 m",
			statline = "CD 90 s | E 40 | H 30 | W 1.3 s | R 18 m | P 100",
			desc = "A fixed 8-metre wind ring rotates for 6 seconds. Three gust sectors pass around it, each dealing 80 damage and pushing 1.5 metres once per revolution, maximum three hits per target. A 3-metre centre stays calm.",
			p60 = nil,
			counterplay = "Enter the calm centre or move with the shown rotation while avoiding the sectors.",
			unstable = "Reverses rotation after a 1-second preview, sacrificing the final revolution's damage for stronger 3-metre pushes.",
		},
	},
	mutation = { name = "Air Runs Out", text = "The reversed finale deals no damage, cannot push through walls, and cannot keep a target airborne beyond control limits. Wind never removes breathable air from a target's body or creates unavoidable asphyxiation." },
	sequence = "Build Tailwind while approaching, use a pillar for a new angle, and crosswind an opponent away from cover. Indoor geometry and enemies who hold stable positions reduce the value of long movement vectors.",
	team = { partners = "Cloud and Poison", text = "Wind can move one Cloud or Poison zone 3 metres with a deliberate gust. The zone retains its owner, damage budget, remaining lifetime, and target limits; moving it does not reapply entry damage instantly." },
}
