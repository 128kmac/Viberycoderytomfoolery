	mutation = { name = "Empty Rack", text = "Only unspent stance enhancements can appear in the unstable sequence. Each spectral tool warns for 0.6 seconds; no tool is replenished by changing stance, copying the caster, or rewinding position." },
	sequence = "Use Bow to provoke an approach, Shield to survive it, and Blade when the opponent commits. Switching on reaction is not instantaneous, and a wrong Countertool choice leaves its full cooldown exposed.",
	team = { partners = "Steel and Thread", text = "Steel can reinforce the standard by 40 durability once without extending its lifetime. Thread may anchor to it; retrieving or destroying the standard breaks that connection harmlessly." },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000065"><Properties><string name="Name">Wind</string><ProtectedString name="Source"><![CDATA[-- AUTO-GENERATED from the EB: Proxima Ability Compendium by tools/gen_kitdata.py. Do not edit by hand.
return {
	num = 98,
	name = "Wind",
	id = "Wind",
	tagline = "Directional acceleration and pressure lanes",
	identity = "Wind shapes moving air into vectors. Fly owns sustained aerial movement; Storm owns a travelling weather system. Wind wins through directional repositioning, temporary lift, and redirecting a small number of eligible projectiles.",
	passive = { name = "Tailwind", text = "Moving at least 3 metres in the same direction over 1 second grants Tailwind, increasing the next Wind movement ability's distance by 1 metre. A sharp reversal, root, or use clears it. Tailwind does not stack." },
